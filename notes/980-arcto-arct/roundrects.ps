%!PS-Adobe-3.0
%% Review sheet for #980: rounded shapes built with arcto/arct only.
%% Run:  pscat --page 480x320 --png roundrects.png roundrects.ps
%%       gs -q -dNOPAUSE -dBATCH -dNOSAFER -sDEVICE=png16m -dGraphicsAlphaBits=4 -g480x320 -r72 -o gs.png roundrects.ps
/dot { gsave 1 0 0 setrgbcolor newpath 2 0 360 arc fill grestore } def   % x y dot: grestore also brings the path back
% x y w h r rrect: arcto at the four corners, tangent points marked
/rrect { /r exch def /h exch def /w exch def /y exch def /x exch def
  x w 2 div add y moveto
  x w add y  x w add y h add  r arcto  dot dot
  x w add y h add  x y h add  r arcto  dot dot
  x y h add  x y  r arcto  dot dot
  x y  x w add y  r arcto  dot dot
  closepath } def
1 setgray 0 0 480 320 rectfill
0.5 setlinewidth
% 1: plain rounded rectangle, filled, radius 18
gsave 0.78 0.87 0.97 setrgbcolor newpath 20 190 130 100 18 rrect fill grestore
0 setgray newpath 20 190 130 100 18 rrect stroke
% 2: big radius (pill)
gsave 0.97 0.85 0.7 setrgbcolor newpath 170 190 130 100 50 rrect fill grestore
0 setgray newpath 170 190 130 100 50 rrect stroke
% 3: non-uniform scale: the corner circles become ellipses
gsave 320 190 translate 1.6 0.7 scale
  0.8 0.93 0.8 setrgbcolor newpath 0 0 80 140 30 rrect fill
  0 setgray newpath 0 0 80 140 30 rrect stroke
grestore
% 4: arct polygon: triangle with rounded corners, no tangent points returned
gsave 0.95 0.8 0.85 setrgbcolor
newpath 80 30 moveto 160 30 130 130 20 arct 130 130 60 110 20 arct 60 110 80 30 20 arct closepath fill grestore
0 setgray newpath 80 30 moveto 160 30 130 130 20 arct 130 130 60 110 20 arct 60 110 80 30 20 arct closepath stroke
% 5: collinear + zero radius + negative radius
0 setgray newpath 200 40 moveto 250 40 300 40 15 arct 300 40 300 60 0 arct
  300 60 340 60 -12 arct 340 120 lineto stroke
% 6: acute corner
newpath 380 30 moveto 460 40 380 60 14 arcto 4 { pop } repeat 440 100 lineto stroke
