% Math class of each glyph, TeX's seven (`/ord` when absent): /op for
% the n-ary operators, /bin for binary operators, /rel, /open, /close
% and /punct.
% @internal
/sgclass <<
  /summation /op  /product /op  /integral /op
  /iint /op  /iiint /op  /oint /op
  /plus /bin  /minus /bin  /multiply /bin  /divide /bin
  /periodcentered /bin  /plusminus /bin  /minusplus /bin
  /union /bin  /intersection /bin
  /ringoperator /bin  /asteriskmath /bin  /star /bin  /setminus /bin
  /equal /rel  /notequal /rel  /approxequal /rel  /less /rel
  /greater /rel  /lessequal /rel  /greaterequal /rel  /arrowright /rel
  /arrowleft /rel  /arrowdblright /rel  /arrowdblboth /rel
  /element /rel  /notelement /rel  /propersubset /rel  /colon /rel
  /equiv /rel  /sim /rel  /simeq /rel  /reflexsubset /rel
  /propersuperset /rel  /reflexsuperset /rel  /mapsto /rel
  /perpendicular /rel  /proportional /rel  /therefore /rel  /because /rel
  /parenleft /open  /bracketleft /open  /braceleft /open  /angleleft /open
  /parenright /close  /bracketright /close  /braceright /close
  /angleright /close
  /comma /punct  /semicolon /punct
>> def

% --------------------------------------------------- private generator

% int -> -   hash the seed (three xorshift rounds over 31 bits) into the
% LCG state, then discard two draws. A raw seed + i would give
% neighbouring glyphs nearly the same first draw.
% @internal
/sgsetseed {
  16#7FFFFFFF and
  3 {
    dup 13 bitshift xor 16#7FFFFFFF and
    dup -17 bitshift xor
    dup 5 bitshift xor 16#7FFFFFFF and
  } repeat
  2147483646 mod 1 add /sgstate exch def
  sgrand pop sgrand pop
} def

% - -> 0..1   Park-Miller by Schrage's method (paintkit's pjrand).
% @internal
/sgrand {
  /sgq sgstate 127773 idiv def
  /sgstate sgstate 127773 mod 16807 mul sgq 2836 mul sub def
  sgstate 0 lt { /sgstate sgstate 2147483647 add def } if
  sgstate 2147483647 div
} def

% amp -> uniform in [-amp, amp]
% @internal
/sgjit { sgrand 2 mul 1 sub mul } def

% ------------------------------------------------------------ helpers

% [adv stroke ...] -> [adv [llx lly urx ury] stroke ...]
% @internal
/sgaddbox {
  /sgab exch def
  /sgllx 1e9 def /sglly 1e9 def /sgurx -1e9 def /sgury -1e9 def
  1 1 sgab length 1 sub {
    sgab exch get /sgst exch def
    0 2 sgst length 2 sub {
      /sgk exch def
      sgst sgk get dup sgllx lt { dup /sgllx exch def } if
      dup sgurx gt { /sgurx exch def } { pop } ifelse
      sgst sgk 1 add get dup sglly lt { dup /sglly exch def } if
      dup sgury gt { /sgury exch def } { pop } ifelse
    } for
  } for
  sgab length 1 eq {
    /sgllx 0 def /sglly 0 def /sgurx 0 def /sgury 0 def
  } if
  [ sgab 0 get [sgllx sglly sgurx sgury]
    sgab 1 sgab length 1 sub getinterval aload pop ]
} def

% [x0 y0 x1 y1 ...] -> [flat stroke]: straight runs between corners,
% each corner doubled (sharp under the midpoint rule) and each run split
% into pieces of at most 250 units, so a tall stroke wobbles along its
% length instead of only at its ends.
% @internal
/sgpoly {
  /sgc exch def
  /sgcn sgc length 2 idiv def
  [ sgc 0 get sgc 1 get
    1 1 sgcn 1 sub {
      /sgj exch def
      /sgpx0 sgc sgj 1 sub 2 mul get def
      /sgpy0 sgc sgj 1 sub 2 mul 1 add get def
      /sgpx1 sgc sgj 2 mul get def
      /sgpy1 sgc sgj 2 mul 1 add get def
      /sgpm sgpx1 sgpx0 sub dup mul sgpy1 sgpy0 sub dup mul add sqrt
            250 div ceiling cvi 1 max def
      1 1 sgpm 1 sub {
        sgpm div /sgpt exch def
        sgpx1 sgpx0 sub sgpt mul sgpx0 add
        sgpy1 sgpy0 sub sgpt mul sgpy0 add
      } for
      sgpx1 sgpy1
      sgj sgcn 1 sub lt { sgpx1 sgpy1 } if
    } for
  ]
} def

% [adv stroke ...] -> the same glyph mirrored left to right (x -> adv - x)
% @internal
/sgmirror {
  /sgmg exch def
  [ sgmg 0 get
    1 1 sgmg length 1 sub {
      sgmg exch get /sgms exch def
      [ 0 2 sgms length 2 sub {
          /sgk exch def
          sgmg 0 get sgms sgk get sub
          sgms sgk 1 add get
        } for ]
    } for ]
} def

% stroke dx -> stroke   a copy of the flat stroke moved right by dx
% @internal
/sgshift {
  /sgsd exch def
  dup length array copy /sgsa exch def
  0 2 sgsa length 2 sub {
    /sgsk exch def sgsa sgsk sgsa sgsk get sgsd add put
  } for
  sgsa
} def

% H D S n -> [adv stroke ...]   n integral signs, each moved right of the
% last by 0.85 of the integral's inked width, so the hooks of the
% neighbours overlap in height, not in ink (a double and triple integral)
% @internal
/sgintn {
  /sgin exch def
  sggrowers /integral get exec /sgig exch def
  /sgdx sgig 0 get 120 sub 0.85 mul def
  [ sgig 0 get sgin 1 sub sgdx mul add
    0 1 sgin 1 sub {
      sgdx mul /sgik exch def
      1 1 sgig length 1 sub { sgig exch get sgik sgshift } for
    } for ]
} def

% --------------------------------------------------- growing symbols

% Each builder takes H D S (glyph units: height above the baseline,
% depth below it, and the radical's vinculum span) and returns an
% authored glyph [adv stroke ...] spanning exactly -D..H. Widths grow
% slowly with the extent T = H + D; Sigma and Pi scale with it.
% Shared scratch: sgH sgD sgS sgT sgsb.
% @internal
/sggrowers <<
  /parenleft {
    sggrowprep
    /sgw 110 sgT 0.06 mul add 260 min def
    /sgns sgT 120 div ceiling cvi 6 max def
    [ sgsb 2 mul sgw add
      [ 0 1 sgns {
          sgns div /sgs exch def
          sgs 2 mul 1 sub dup mul sgw mul sgsb add
          sgH sgT sgs mul sub
        } for ] ]
  }
  /bracketleft {
    sggrowprep
    /sgw 100 sgT 0.04 mul add 220 min def
    [ sgsb sgw add sgsb add
      [ sgsb sgw add sgH  sgsb sgH  sgsb sgD neg  sgsb sgw add sgD neg ]
      sgpoly ]
  }
  /braceleft {
    sggrowprep
    /sgw 140 sgT 0.05 mul add 280 min def
    /sgr sgw 2 div sgT 10 div min def
    /sgxm sgsb sgw 2 div add def
    /sgmid sgH sgD sub 2 div def
    [ sgsb sgw add sgsb add
      [ sgxm sgr add sgH  sgxm sgH
        [ sgxm sgH sgr 2 mul sub  sgxm sgmid sgr 2 mul add ] sgpoly aload pop
        sgxm sgmid  sgxm sgr sub sgmid  sgxm sgr sub sgmid  sgxm sgmid
        [ sgxm sgmid sgr 2 mul sub  sgxm sgD neg sgr 2 mul add ] sgpoly
        aload pop
        sgxm sgD neg  sgxm sgr add sgD neg ] ]
  }
  /bar {
    sggrowprep
    [ sgsb 2 mul  [ sgsb sgH  sgsb sgD neg ] sgpoly ]
  }
  /angleleft {
    sggrowprep
    /sgw 90 sgT 0.1 mul add 240 min def
    [ sgsb 2 mul sgw add
      [ sgsb sgw add sgH  sgsb sgH sgD sub 2 div  sgsb sgw add sgD neg ]
      sgpoly ]
  }
  /dblbar {
    sggrowprep
    [ sgsb 2 mul 110 add
      [ sgsb sgH  sgsb sgD neg ] sgpoly
      [ sgsb 110 add sgH  sgsb 110 add sgD neg ] sgpoly ]
  }
  /iint { 2 sgintn }
  /iiint { 3 sgintn }
  /oint {
    sggrowprep
    sgH sgD sgS sggrowers /integral get exec /sgig exch def
    % the ring stays a text-size ring however tall the sign grows, as the
    % jitter does; it sits on the axis of the extent, over the stem
    /sgr 120 sgT 0.03 mul add 200 min def
    /sgrcx sgig 0 get 2 div def
    /sgrcy sgH sgD sub 2 div def
    [ sgig 0 get  sgig 1 get
      [ 0 45 405 { dup cos sgr mul sgrcx add exch sin sgr mul sgrcy add } for ] ]
  }
  /integral {
    sggrowprep
    /sgw 150 sgT 0.12 mul add 400 min def
    /sghk sgT 0.15 mul 180 min def
    [ sgw sgsb 2 mul add
      [ sgsb sgw add sgH sghk 0.5 mul sub
        sgsb sgw 0.86 mul add sgH
        sgsb sgw 0.64 mul add sgH sghk 0.2 mul sub
        [ sgsb sgw 0.6 mul add sgH sghk sub
          sgsb sgw 0.4 mul add sgD neg sghk add ] sgpoly aload pop
        sgsb sgw 0.36 mul add sgD neg sghk 0.2 mul add
        sgsb sgw 0.14 mul add sgD neg
        sgsb sgD neg sghk 0.5 mul add ] ]
  }
  /radical {
    sggrowprep
    /sgrk sgT 0.35 mul 280 min def
    /sga 90 sgT 0.05 mul add def
    /sgb 120 sgT 0.1 mul add def
    [ sgsb sga add sgb add 30 add
      [ sgsb sgD neg sgrk 0.5 mul add
        sgsb sga 0.4 mul add sgD neg sgrk 0.62 mul add
        sgsb sga add sgD neg
        sgsb sga add sgb add sgH
        sgS 0 gt { sgsb sga add sgb add sgS add sgH } if ] sgpoly ]
  }
  /summation {
    sggrowprep
    /sgw sgT 0.7 mul def
    [ sgw sgsb 2 mul add
      [ sgsb sgw add sgH  sgsb sgH  sgsb sgw 0.5 mul add sgH sgD sub 2 div
        sgsb sgD neg  sgsb sgw add sgD neg ] sgpoly ]
  }
  /product {
    sggrowprep
    /sgw sgT 0.7 mul def
    [ sgw sgsb 2 mul add
      [ sgsb sgw 0.12 mul add sgH  sgsb sgw 0.12 mul add sgD neg ] sgpoly
      [ sgsb sgw 0.88 mul add sgH  sgsb sgw 0.88 mul add sgD neg ] sgpoly
      [ sgsb sgH  sgsb sgw add sgH ] sgpoly ]
  }
>> def

% H D S -> -   the builders' shared preamble
% @internal
/sggrowprep {
  /sgS exch def /sgD exch def /sgH exch def
  /sgT sgH sgD add def
  /sgsb 60 def
} def

% /symbol H D S -> [adv [bbox] stroke ...]   (right-hand delimiters are
% the left-hand builders mirrored)
% @internal
/sgbuild {
  4 -1 roll
  dup /parenright eq { pop sggrowers /parenleft get exec sgmirror } {
  dup /bracketright eq { pop sggrowers /bracketleft get exec sgmirror } {
  dup /braceright eq { pop sggrowers /braceleft get exec sgmirror } {
  dup /angleright eq { pop sggrowers /angleleft get exec sgmirror } {
    sggrowers exch get exec
  } ifelse } ifelse } ifelse } ifelse
  sgaddbox
} def

% The names `sggrow` accepts.
% @internal
/sggrownames [ /parenleft /parenright /bracketleft /bracketright
  /braceleft /braceright /bar /integral /radical /summation /product
  /angleleft /angleright /dblbar /iint /iiint /oint ] def

% The run-time glyph table, filled by sginit.
% @internal
/sgtab << >> def

% [base name code-point extra ...] raise -> -   derive scaled-and-shifted
% copies of glyphs (the superscripts and subscripts): each base skeleton at
% 0.6 scale, 15 units in from the left, raised by raise plus the row's
% extra, registered under its name and code point. Runs inside sginit's
% private dict.
% @internal
/sgderive {
  /sgrz exch def
  /sgsup exch def
  0 4 sgsup length 4 sub {
    /sgsj exch def
    sgtab sgsup sgsj get get /sgbg exch def
    sgsup sgsj 3 add get /sgbx exch def
    sgcmap sgsup sgsj 2 add get sgsup sgsj 1 add get put
    [ sgbg 0 get 0.6 mul 30 add
      2 1 sgbg length 1 sub {
        sgbg exch get /sgbs exch def
        [ 0 2 sgbs length 2 sub {
            /sgbk exch def
            sgbs sgbk get 0.6 mul 15 add
            sgbs sgbk 1 add get 0.6 mul sgrz add sgbx add
          } for ]
      } for ] sgaddbox
    sgtab exch sgsup sgsj 1 add get exch put
  } for
} def

% - -> -   fill sgtab and the ASCII half of sgcmap. Runs once, at load,
% inside a private dict so its scratch never reaches userdict.
% @internal
/sginit {
  % handscript's glyphs, copied (handscript's own arrays are untouched)
  HandScriptDict /CharDefs get { sgaddbox sgtab 3 1 roll put } forall
  HandScriptDict /Encoding get /sgenc exch def
  32 1 126 {
    /sgk exch def
    sgenc sgk get dup /.notdef ne sgcmap sgk known not and
      { sgcmap exch sgk exch put } { pop } ifelse
  } for
  % the capitals' code points
  0 1 25 {
    /sgk exch def
    /sgch 1 string def
    sgch 0 sgk 65 add put
    sgcmap sgk 65 add sgch cvn put
  } for
  sgsrc { sgaddbox sgtab 3 1 roll put } forall
  % Superscript digits (and + - n), made from the base glyph's own
  % skeleton at 0.6 scale, raised: so the digits stay one source and a
  % reshaped digit reshapes its superscript. [base name code-point extra
  % raise]; the signs sit a little higher, level with the digits' middle.
  [ /zero /zerosuperior 8304 0  /one /onesuperior 185 0
    /two /twosuperior 178 0  /three /threesuperior 179 0
    /four /foursuperior 8308 0  /five /fivesuperior 8309 0
    /six /sixsuperior 8310 0  /seven /sevensuperior 8311 0
    /eight /eightsuperior 8312 0  /nine /ninesuperior 8313 0
    /plus /plussuperior 8314 60  /minus /minussuperior 8315 60
    /n /nsuperior 8319 0 ]
  320 sgderive
  % Subscripts (issue #366): the same derivation, lowered 80 units so the
  % digits hang a little below the baseline. The signs again sit 60 higher.
  [ /zero /zeroinferior 8320 0  /one /oneinferior 8321 0
    /two /twoinferior 8322 0  /three /threeinferior 8323 0
    /four /fourinferior 8324 0  /five /fiveinferior 8325 0
    /six /sixinferior 8326 0  /seven /seveninferior 8327 0
    /eight /eightinferior 8328 0  /nine /nineinferior 8329 0
    /plus /plusinferior 8330 60  /minus /minusinferior 8331 60
    /equal /equalinferior 8332 60
    /a /ainferior 8336 0  /e /einferior 8337 0  /o /oinferior 8338 0
    /x /xinferior 8339 0  /n /ninferior 8345 0
    /i /iinferior 7522 0  /j /jinferior 11388 0 ]
  -80 sgderive
  % text-size growing symbols, from the same builders sggrow uses
  [ /parenleft 750 250 0  /parenright 750 250 0
    /bracketleft 750 250 0  /bracketright 750 250 0
    /braceleft 750 250 0  /braceright 750 250 0
    /bar 750 250 0  /integral 800 300 0  /radical 720 80 250
    /summation 650 150 0  /product 650 150 0
    /angleleft 750 250 0  /angleright 750 250 0  /dblbar 750 250 0
    /iint 800 300 0  /iiint 800 300 0  /oint 800 300 0 ]
  /sgfix exch def
  0 4 sgfix length 4 sub {
    /sgk exch def
    sgtab sgfix sgk get
    sgfix sgk get sgfix sgk 1 add get sgfix sgk 2 add get
      sgfix sgk 3 add get sgbuild
    put
  } for
} def

60 dict begin sginit end

% -------------------------------------------------------- run time

% name -> glyph array (unknown names give .notdef)
% @internal
/sgglyph {
  sgtab 1 index known { sgtab exch get } { pop sgtab /.notdef get } ifelse
} def

% code point -> glyph name
% @internal
/sgcp2name {
  sgcmap 1 index known { sgcmap exch get } { pop /.notdef } ifelse
} def

% name -> -   remember the first name that has no glyph (sgmiss)
% @internal
/sgnotename {
  dup /.notdef eq 1 index sgtab exch known not or sgmiss null eq and
    { 256 string cvs /sgmiss exch def } { pop } ifelse
} def

% label-string -> (never returns)   the strict-mode error, named for the
% glyph that is missing (truncated to 40 bytes, as mathkit's labels are)
% @internal
/sgmissfail {
  dup length 40 gt { 0 40 getinterval } if
  (sg-missing-glyph:) length 1 index length add string
  dup 0 (sg-missing-glyph:) putinterval
  dup (sg-missing-glyph:) length 4 -1 roll putinterval
  cvn cvx exec
} def

% - -> -   in strict mode, refuse the text sgnames just decoded if it
% held a glyph that does not exist
% @internal
/sgcheckstrict {
  sgstrict sgmiss null ne and { sgmiss sgmissfail } if
} def

% string-or-name-array -> array of glyph names (UTF-8 decode)
% @internal
/sgnames {
  dup type /stringtype eq {
    /sgs exch def
    /sgk 0 def
    /sgmiss null def
    [ {
        sgk sgs length ge { exit } if
        /sgb sgs sgk get def
        /sgk sgk 1 add def
        /sgk0 sgk 1 sub def
        sgb 128 lt { sgb } {
          sgb 224 lt { sgb 31 and 1 } {
            sgb 240 lt { sgb 15 and 2 } { sgb 7 and 3 } ifelse
          } ifelse
          {
            sgk sgs length ge { exit } if
            sgs sgk get dup 192 and 128 ne { pop exit } if
            63 and exch 6 bitshift or
            /sgk sgk 1 add def
          } repeat
        } ifelse
        sgcp2name
        dup /.notdef eq sgmiss null eq and
          { sgs sgk0 sgk sgk0 sub getinterval /sgmiss exch def } if
      } loop ]
  } {
    dup type /arraytype eq 1 index type /packedarraytype eq or {
      /sgmiss null def
      dup {
        dup type /nametype ne { sg-text-array-must-hold-glyph-names } if
        sgnotename
      } forall
    } {
      sg-text-must-be-a-string-or-name-array
    } ifelse
  } ifelse
} def

% opts /key default -> value   (numbers only)
% @internal
/sgnumopt {
  2 index 2 index known { pop get } { 3 1 roll pop pop } ifelse
} def

% obj -> bool
% @internal
/sgisnum {
  type dup /integertype eq exch /realtype eq or
} def

% opts -> -   reads the shared keys into sgSize sgsc sgtan sgJ sgseed0
% @internal
/sgreadopts {
  /sgo exch def
  sgo /Size 36 sgnumopt
  dup sgisnum { dup 0 le } { true } ifelse
    { sg-size-must-be-a-positive-number } if
  /sgSize exch def
  /sgsc sgSize 1000 div def
  sgo /Slant 0 sgnumopt
  dup sgisnum not { sg-slant-must-be-a-number } if
  dup sin exch cos div /sgtan exch def
  sgo /Jitter 0.016 sgnumopt
  dup sgisnum { dup 0 lt } { true } ifelse
    { sg-jitter-must-be-a-non-negative-number } if
  1000 mul /sgJ exch def
  sgo /Seed known {
    sgo /Seed get
    dup type /integertype ne { sg-seed-must-be-an-integer } if
  } { null } ifelse
  /sgseed0 exch def
  sgo /Strict known {
    sgo /Strict get
    dup type /booleantype ne { sg-strict-must-be-a-boolean } if
  } { true } ifelse
  /sgstrict exch def
} def

% x y -> int   the default seed: the origin's device-space position,
% quantized to 0.01 (drykit's rule, DRYMEDIA 3.2). Device space, so a
% caller that translates per atom and draws at 0 0 still varies.
% @internal
/sgposseed {
  transform 100 mul round cvi exch 100 mul round cvi 1000003 mul add
} def

% opts -> opts   (or the guard)
% @internal
/sgcheckopts {
  dup type /dicttype ne { sg-opts-must-be-a-dict } if
} def

% [x y ...] -> -   one jittered stroke, appended to the current path
% with handscript's midpoint rule
% @internal
/sgstroke {
  /sgp exch def
  /sgpn sgp length 2 idiv def
  /sgqx sgpn array def
  /sgqy sgpn array def
  0 1 sgpn 1 sub {
    /sgk exch def
    /sgjx sgJ sgjit def
    /sgjy sgJ sgjit def
    /sggx sgp sgk 2 mul get sgjx add def
    /sggy sgp sgk 2 mul 1 add get sgjy add sgdy add def
    sgqx sgk sggx sggy sgt mul add sgsc mul sgox add put
    sgqy sgk sggy sgsc mul sgoy add put
  } for
  sgqx 0 get sgqy 0 get moveto
  sgpn 1 eq { sgqx 0 get sgqy 0 get lineto } if
  sgpn 2 eq { sgqx 1 get sgqy 1 get lineto } if
  sgpn 2 gt {
    /sgcx sgqx 0 get def
    /sgcy sgqy 0 get def
    1 1 sgpn 2 sub {
      /sgk exch def
      /sgpx sgqx sgk get def
      /sgpy sgqy sgk get def
      sgk sgpn 2 sub eq {
        /sgex sgqx sgpn 1 sub get def
        /sgey sgqy sgpn 1 sub get def
      } {
        /sgex sgqx sgk get sgqx sgk 1 add get add 2 div def
        /sgey sgqy sgk get sgqy sgk 1 add get add 2 div def
      } ifelse
      sgcx sgpx sgcx sub 2 mul 3 div add
      sgcy sgpy sgcy sub 2 mul 3 div add
      sgex sgpx sgex sub 2 mul 3 div add
      sgey sgpy sgey sub 2 mul 3 div add
      sgex sgey curveto
      /sgcx sgex def
      /sgcy sgey def
    } for
  } if
} def

% glyph ox oy -> -   every stroke of one glyph, with its own drift and
% shear. The generator must already be seeded for this glyph.
% @internal
/sgemit {
  /sgoy exch def /sgox exch def /sgg exch def
  /sgt sgJ 0.0025 mul sgjit sgtan add def
  /sgdy sgJ sgjit def
  2 1 sgg length 1 sub { sgg exch get sgstroke } for
} def

% ------------------------------------------------------------- API

%%SelfTest: sgpath-rejects-malformed-operands
%   { 5 0 0 << >> sgpath } /sg-text-must-be-a-string-or-name-array
%   (a number as text) mustguard
%   { [ /a 7 ] 0 0 << >> sgpath } /sg-text-array-must-hold-glyph-names
%   (a number inside a name array) mustguard
%   { (a) 0 0 5 sgpath } /sg-opts-must-be-a-dict (a number as opts) mustguard
%   { (a) (x) 0 << >> sgpath } /sg-xy-must-be-numbers (a string as x) mustguard
%   { (a) 0 0 << /Size 0 >> sgpath } /sg-size-must-be-a-positive-number
%   (/Size 0) mustguard
%   { (a) 0 0 << /Size { 36 } >> sgpath } /sg-size-must-be-a-positive-number
%   (a procedure as /Size) mustguard
%   { (a) 0 0 << /Jitter -1 >> sgpath } /sg-jitter-must-be-a-non-negative-number
%   (/Jitter -1) mustguard
%   { (a) 0 0 << /Slant /up >> sgpath } /sg-slant-must-be-a-number
%   (a name as /Slant) mustguard
%   { (a) 0 0 << /Seed 1.5 >> sgpath } /sg-seed-must-be-an-integer
%   (a real /Seed) mustguard
%%EndSelfTest
%
%%SelfTest: sgpath-refuses-a-missing-glyph-by-name
%   { (i⊕ = 1) 0 0 << >> sgpath } /sg-missing-glyph:⊕ (a circled plus) mustguard
%   { (aℵb) 0 0 << >> sgpath } /sg-missing-glyph:ℵ (an aleph) mustguard
%   { (x⊕) << >> sgwidth } /sg-missing-glyph:⊕ (sgwidth is strict too) mustguard
%   { [ /a /nosuchglyph /b ] 0 0 << >> sgpath } /sg-missing-glyph:nosuchglyph
%   (an unknown name) mustguard
%   { [ /a /.notdef ] 0 0 << >> sgpath } /sg-missing-glyph:.notdef
%   (an explicit .notdef) mustguard
%   { (a⊕) 0 0 << /Strict true >> sgpath } /sg-missing-glyph:⊕ (/Strict true) mustguard
%   { (a) 0 0 << /Strict 1 >> sgpath } /sg-strict-must-be-a-boolean
%   (a number as /Strict) mustguard
%   % the refusal comes before any ink: the path is still empty
%   newpath { (ab⊕) 0 0 << >> sgpath } /sg-missing-glyph:⊕ (ab⊕) mustguard
%   { currentpoint } stopped (nothing was added to the path) mustbe
%   % /Strict false is the handscript behaviour: 300 units, no ink
%   newpath (a⊕) 0 0 << /Strict false /Size 1000 /Jitter 0 >> sgpath
%   (a⊕) << /Strict false /Size 1000 >> sgwidth
%   (a) << /Size 1000 >> sgwidth 300 add eq
%   (a missing glyph advances 300 units under /Strict false) mustbe
%   newpath
%%EndSelfTest
%
%%SelfTest: sggrow-rejects-malformed-operands
%   { newpath 0 0 moveto 10 5 << /Symbol /blob >> sggrow pop }
%   /sggrow-unknown-symbol (an unknown symbol) mustguard
%   { newpath 0 0 moveto 10 5 << >> sggrow pop }
%   /sggrow-needs-a-symbol (no /Symbol) mustguard
%   { newpath 10 5 << /Symbol /bar >> sggrow pop }
%   /sggrow-needs-a-current-point (no current point) mustguard
%   { newpath 0 0 moveto 0 0 << /Symbol /bar >> sggrow pop }
%   /sggrow-height-plus-depth-must-be-positive (a zero extent) mustguard
%   { newpath 0 0 moveto (h) 0 << /Symbol /bar >> sggrow pop }
%   /sggrow-height-and-depth-must-be-numbers (a string height) mustguard
%   { newpath 0 0 moveto 10 5 << /Symbol /radical /Span -3 >> sggrow pop }
%   /sggrow-span-must-be-a-non-negative-number (a negative /Span) mustguard
%%EndSelfTest
%
%%SelfTest: sgpath-is-deterministic-and-leaves-rand-alone
%   /sgt-flat { [ { } { } { } { } pathforall ] } def
%   /sgt-same {
%     /sgt-b exch def /sgt-a exch def
%     sgt-a length sgt-b length eq {
%       true 0 1 sgt-a length 1 sub {
%         dup sgt-a exch get exch sgt-b exch get sub abs 1e-6 lt and
%       } for
%     } { false } ifelse
%   } def
%   1234 srand /sgt-r0 rrand def
%   newpath (Aσ≤) 10 20 << /Seed 9 >> sgpath sgt-flat /sgt-p1 exch def
%   newpath (Aσ≤) 10 20 << /Seed 9 >> sgpath sgt-flat /sgt-p2 exch def
%   newpath (Aσ≤) 10 20 << /Seed 10 >> sgpath sgt-flat /sgt-p3 exch def
%   sgt-p1 sgt-p2 sgt-same (the same seed gives the same path) mustbe
%   sgt-p1 sgt-p3 sgt-same not (another seed gives another path) mustbe
%   rrand sgt-r0 eq (the caller's rand stream is untouched) mustbe
%   % the space advances 300 units (10.8 points at the default /Size 36)
%   newpath [/space /a] 0 0 << /Seed 4 >> sgpath sgt-flat /sgt-q1 exch def
%   newpath [/a] 10.8 0 << /Seed 5 >> sgpath sgt-flat /sgt-q2 exch def
%   sgt-q1 sgt-q2 sgt-same (the glyph at index i is jittered from seed + i) mustbe
%   % no /Seed: the seed comes from the origin's device position
%   newpath (x) 0 0 << >> sgpath sgt-flat /sgt-u1 exch def
%   newpath (x) 0 0 << >> sgpath sgt-flat /sgt-u2 exch def
%   gsave 100 0 translate newpath (x) 0 0 << >> sgpath sgt-flat grestore
%   /sgt-u3 exch def
%   sgt-u1 sgt-u2 sgt-same (unseeded, the same place gives the same path) mustbe
%   sgt-u1 sgt-u3 sgt-same not (unseeded, another place gives another jitter) mustbe
%   newpath
%%EndSelfTest
%
%%SelfTest: sgpath-draws-the-exact-skeleton-at-zero-jitter
%   % handscript's l is [280 [140 750 140 70 190 10 240 40]]
%   newpath (l) 100 200 << /Size 1000 /Jitter 0 >> sgpath
%   [ { } { } { } { } pathforall ] dup 0 get 240 eq exch 1 get 950 eq and
%   (the first moveto lands on the first skeleton point) mustbe
%   newpath
%   (ab) << /Size 1000 >> sgwidth 970 eq (width is the sum of the advances) mustbe
%   (A=πr) << /Size 50 >> sgwidth
%   [/A /equal /pi /r] << /Size 50 >> sgwidth eq
%   (a UTF-8 string and its name array measure the same) mustbe
%   (ab) << /Size 1000 /Slant 30 >> sgwidth 970 eq
%   (slant never moves the advance) mustbe
%%EndSelfTest
%
%%SelfTest: sggrow-spans-exactly-height-and-depth
%   newpath 0 0 moveto 100 40 << /Symbol /bar /Size 30 /Jitter 0 >> sggrow pop
%   pathbbox exch pop 3 -1 roll pop 100 eq exch -40 eq and (bar spans -40..100) mustbe
%   newpath 0 0 moveto 100 40 << /Symbol /bracketright /Size 30 /Jitter 0 >> sggrow
%   0 gt (a grown symbol has a positive advance) mustbe
%   pathbbox exch pop 3 -1 roll pop 100 eq exch -40 eq and (bracket spans -40..100) mustbe
%   newpath 0 0 moveto 20 5 << /Symbol /summation /Size 30 >> sggrow
%   newpath 0 0 moveto 80 20 << /Symbol /summation /Size 30 >> sggrow
%   lt (a taller sum is wider) mustbe
%   newpath
%%EndSelfTest
%
%%SelfTest: board-math-glyphs-are-all-there
%   % issue #339: each of these was a sg-missing-glyph before
%   (≡ ∼ ≃ ∘ ∗ ⋆ ∖ ⊆ ⊃ ⊇ ↦ ⊥ ∥ ∝ ∴ ∵ ⟨ ⟩ ‖ ℏ ℓ ∬ ∭ ∮ ι υ Υ ο) << >> sgwidth
%   0 gt (the board-math symbols all measure) mustbe
%   (i² = −1 x⁻¹ a³ ⁴⁵⁶⁷⁸⁹⁰ ¹ ⁺ ⁿ) << >> sgwidth 0 gt
%   (superscript digits, signs and n measure) mustbe
%   % a superscript is the digit at 0.6 scale, raised: narrower, and the
%   % ink sits above the cap height's middle
%   (²) << /Size 1000 >> sgwidth (2) << /Size 1000 >> sgwidth lt
%   (a superscript two is narrower than a two) mustbe
%   /twosuperior << /Size 1000 >> sgmetrics /BBox get 1 get 300 gt
%   (a superscript two stands above the baseline) mustbe
%   % the superscript digits are derived from the digits: the same skeleton
%   % at 0.6 scale with a 15 unit side bearing and a raise of 320
%   /twosuperior << /Size 1000 >> sgmetrics /BBox get 3 get
%   /two << /Size 1000 >> sgmetrics /BBox get 3 get 0.6 mul 320 add sub abs 1 lt
%   (the superscript two is the two, scaled and raised) mustbe
%   % classes
%   /equiv << >> sgmetrics /Class get /rel eq (≡ is a relation) mustbe
%   /reflexsubset << >> sgmetrics /Class get /rel eq (⊆ is a relation) mustbe
%   /ringoperator << >> sgmetrics /Class get /bin eq (∘ is a binary operator) mustbe
%   /therefore << >> sgmetrics /Class get /rel eq (∴ is a relation) mustbe
%   /angleleft << >> sgmetrics /Class get /open eq (⟨ opens) mustbe
%   /angleright << >> sgmetrics /Class get /close eq (⟩ closes) mustbe
%   /oint << >> sgmetrics /Class get /op eq (∮ is a large operator) mustbe
%   /hbar << >> sgmetrics /Class get /ord eq (ℏ is ordinary) mustbe
%   % the text characters reach the same glyphs
%   (∮) << /Size 50 >> sgwidth /oint << /Size 50 >> sgmetrics /Advance get eq
%   (∮ is the oint glyph) mustbe
%   (⟨) << /Size 50 >> sgwidth (〈) << /Size 50 >> sgwidth eq
%   (U+27E8 and U+2329 are the same glyph) mustbe
%   (‖) << /Size 50 >> sgwidth (∥) << /Size 50 >> sgwidth eq
%   (‖ and ∥ are the same glyph) mustbe
%   % grown delimiters span exactly height and depth, and the right-hand
%   % one is the left-hand one mirrored
%   newpath 0 0 moveto 100 40 << /Symbol /angleleft /Size 30 /Jitter 0 >> sggrow pop
%   pathbbox exch pop 3 -1 roll pop 100 eq exch -40 eq and
%   (a grown angle bracket spans -40..100) mustbe
%   newpath 0 0 moveto 100 40 << /Symbol /angleright /Size 30 /Jitter 0 >> sggrow pop
%   pathbbox exch pop 3 -1 roll pop 100 eq exch -40 eq and
%   (a grown right angle bracket spans -40..100) mustbe
%   newpath 0 0 moveto 100 40 << /Symbol /dblbar /Size 30 /Jitter 0 >> sggrow pop
%   pathbbox exch pop 3 -1 roll pop 100 eq exch -40 eq and
%   (a grown double bar spans -40..100) mustbe
%   newpath 0 0 moveto 100 40 << /Symbol /oint /Size 30 /Jitter 0 >> sggrow
%   newpath 0 0 moveto 100 40 << /Symbol /integral /Size 30 /Jitter 0 >> sggrow
%   eq (the contour integral has the single integral's advance) mustbe
%   % ∬ and ∭ grow wider by one integral each
%   newpath 0 0 moveto 60 20 << /Symbol /integral /Size 30 >> sggrow
%   newpath 0 0 moveto 60 20 << /Symbol /iint /Size 30 >> sggrow
%   newpath 0 0 moveto 60 20 << /Symbol /iiint /Size 30 >> sggrow
%   /sgt-c exch def /sgt-b exch def /sgt-a exch def
%   sgt-a sgt-b lt sgt-b sgt-c lt and (each extra integral widens the sign) mustbe
%   newpath
%%EndSelfTest
%
%%SelfTest: subscripts-and-variant-greek
%   % issue #366: each of these was a sg-missing-glyph before
%   (ϑ ϰ ϱ ϖ ς ϵ ϕ) << >> sgwidth 0 gt (the variant Greek letters measure) mustbe
%   (H₂O x₀ ₁₂₃₄₅₆₇₈₉ n₊ n₋ a₌b xₙ ₐₑₒₓ ᵢⱼ) << >> sgwidth 0 gt
%   (subscript digits, signs and letters measure) mustbe
%   % a subscript is the digit at 0.6 scale, lowered: narrower than the
%   % digit, and its ink hangs below the baseline
%   (₂) << /Size 1000 >> sgwidth (2) << /Size 1000 >> sgwidth lt
%   (a subscript two is narrower than a two) mustbe
%   /twoinferior << /Size 1000 >> sgmetrics /BBox get 1 get 0 lt
%   (a subscript two hangs below the baseline) mustbe
%   % derived from the digit: the same skeleton at 0.6 scale, a 15 unit
%   % side bearing, lowered 80
%   /twoinferior << /Size 1000 >> sgmetrics /BBox get 3 get
%   /two << /Size 1000 >> sgmetrics /BBox get 3 get 0.6 mul 80 sub sub abs 1 lt
%   (the subscript two is the two, scaled and lowered) mustbe
%   /twoinferior << /Size 1000 >> sgmetrics /Advance get
%   /twosuperior << /Size 1000 >> sgmetrics /Advance get eq
%   (a subscript and a superscript digit advance alike) mustbe
%   % the subscript sits 400 units below the superscript
%   /twosuperior << /Size 1000 >> sgmetrics /BBox get 3 get
%   /twoinferior << /Size 1000 >> sgmetrics /BBox get 3 get sub 400 sub abs 1 lt
%   (the superscript is 400 units above the subscript) mustbe
%   % the code points reach the glyphs
%   (₂) << /Size 50 >> sgwidth /twoinferior << /Size 50 >> sgmetrics /Advance get eq
%   (U+2082 is the subscript two) mustbe
%   (ₙ) << /Size 50 >> sgwidth /ninferior << /Size 50 >> sgmetrics /Advance get eq
%   (U+2099 is the subscript n) mustbe
%   (ϑ) << /Size 50 >> sgwidth /theta1 << /Size 50 >> sgmetrics /Advance get eq
%   (U+03D1 is /theta1) mustbe
%   (ϕ) << /Size 50 >> sgwidth (φ) << /Size 50 >> sgwidth eq
%   (U+03D5 draws the stroked phi, as U+03C6 does) mustbe
%   % the variants are drawn differently from the plain letters, and the
%   % plain letters are untouched
%   /theta << /Size 1000 >> sgmetrics /Advance get 450 eq
%   /theta1 << /Size 1000 >> sgmetrics /Advance get 450 ne and
%   (the variant theta is not the plain theta) mustbe
%   /epsilon << /Size 1000 >> sgmetrics /Advance get 420 eq
%   (the plain epsilon keeps its advance) mustbe
%%EndSelfTest
%
%%SelfTest: ascii-star-is-the-text-asterisk
%   % issue #378: ASCII * names /asterisk, an upright star raised above the
%   % math axis; the centred math star stays /asteriskmath (U+2217)
%   (*) << /Size 1000 >> sgmetrics dup /Name get /asterisk eq
%   (ASCII * is the glyph /asterisk) mustbe
%   /BBox get 1 get 400 gt (the text asterisk sits above the math axis) mustbe
%   (∗) << /Size 1000 >> sgmetrics /Name get /asteriskmath eq
%   (U+2217 is still /asteriskmath) mustbe
%   (*) << /Size 1000 >> sgwidth 320 eq (the text asterisk advances 320) mustbe
%   (a*b) << /Size 1000 >> sgwidth [/a /asterisk /b] << /Size 1000 >> sgwidth eq
%   (a string and its name array measure the same) mustbe
%   newpath (a*b) 0 0 << /Jitter 0 >> sgpath
%   newpath
%%EndSelfTest
%
%%SelfTest: digit-four-is-an-open-four
%   % issue #351: the 4 is redrawn here, not handscript's bent stroke
%   /four << /Size 1000 >> sgmetrics /Advance get 430 eq
%   (the 4 keeps handscript's advance, so no layout moves) mustbe
%   /four << /Size 1000 >> sgmetrics /BBox get dup 3 get 700 eq
%   exch 2 get 395 eq and (the 4 is cap height tall, its crossbar reaching 395) mustbe
%   % the crossbar passes the stem (x = 295)
%   /four << /Size 1000 >> sgmetrics /BBox get 2 get 295 gt
%   (the 4's crossbar runs past its stem) mustbe
%   % open top: the left stroke starts at (120, 700), well left of the stem
%   newpath (4) 0 0 << /Size 1000 /Jitter 0 >> sgpath
%   [ { } { } { } { } pathforall ] dup 0 get 120 eq exch 1 get 700 eq and
%   (the 4's first stroke starts at the top, left of the stem: an open 4) mustbe
%   /foursuperior << /Size 1000 >> sgmetrics /BBox get 3 get
%   /four << /Size 1000 >> sgmetrics /BBox get 3 get 0.6 mul 320 add sub abs 1 lt
%   (the superscript 4 follows the new 4: scaled to 0.6 and raised 320) mustbe
%   newpath
%%EndSelfTest
%
%%SelfTest: every-glyph-is-well-formed
%   /sgt-ok true def
%   sgtab {
%     exch pop
%     dup 0 get type dup /integertype eq exch /realtype eq or
%     1 index 1 get length 4 eq and not { /sgt-ok false def } if
%     2 1 2 index length 1 sub {
%       1 index exch get length dup 2 lt exch 2 mod 0 ne or
%       { /sgt-ok false def } if
%     } for
%     pop
%   } forall
%   sgt-ok (every glyph is [adv [bbox] even-length strokes...]) mustbe
%   /sgt-ok true def
%   sgcmap { exch pop sgtab exch known not { /sgt-ok false def } if } forall
%   sgt-ok (every code point maps to a glyph that exists) mustbe
%   true sggrownames { sgtab exch known and } forall
%   (every growing symbol has a text-size glyph) mustbe
%   HandScriptDict /CharDefs get /a get 1 get 0 get 370 eq
%   (handscript's own glyph arrays are not rewritten) mustbe
%   /f << /Size 1000 >> sgmetrics /Italic get 0 eq
%   (upright italic correction is 0) mustbe
%   /f << /Size 1000 /Slant 15 >> sgmetrics /Italic get 0 gt
%   (a slanted f gets an italic correction) mustbe
%   /j << /Size 1000 /Slant -60 >> sgmetrics /Italic get 0 gt
%   (a back-slanted descender gets an italic correction too) mustbe
%   /equal << >> sgmetrics /Class get /rel eq (= is a relation) mustbe
%   (∑) << >> sgmetrics /Class get /op eq (∑ is a large operator) mustbe
%   (Σ) << >> sgmetrics /Class get /ord eq (the letter Sigma is ordinary) mustbe
%   <E96162> sgnames dup length 3 eq exch dup 1 get /a eq exch 2 get /b eq and and
%   (a stray Latin-1 byte does not swallow the ASCII after it) mustbe
%%EndSelfTest
%
% (text) x y opts sgpath -
% @kind: Procedure
% @summary: Appends the jittered centerline skeleton of a string (UTF-8: Latin, digits, superscript and subscript digits, Greek with its variant forms, math operators and relations) or an array of glyph names to the current path at baseline x y, one subpath per pen stroke, painting nothing. Stroke it with a pen or hand it to a dry medium. Uses its own seeded generator, never the caller's rand.
% @example: (lib/handscript.ps) run (lib/strokeglyphs.ps) run newpath (∀ε>0 ∃δ>0) 72 600 << /Size 40 /Seed 7 >> sgpath 2 setlinewidth 1 setlinecap 1 setlinejoin stroke
% @param: /Size [points] The em size: cap height is 0.7 of it (default 36)
% @param: /Slant [degrees] Forward lean applied to every glyph as a shear about the baseline (default 0)
% @param: /Jitter [fraction of /Size] Bound on each point's wobble and each glyph's baseline drift; 0 draws the exact skeleton (default 0.016)
% @param: /Seed [integer] The glyph at index i is jittered from seed + i, so editing later text never re-rolls earlier glyphs (default: derived from the origin's device-space position, so text drawn in two places differs)
% @param: /Strict [boolean] true raises sg-missing-glyph:<char> for a character or name with no glyph, before anything is drawn; false lets it advance 300 design units and draw nothing, as handscript does (default true)
/sgpath {
  sgcheckopts
  4 1 roll
  2 copy sgisnum exch sgisnum and not { sg-xy-must-be-numbers } if
  /sgy0 exch def /sgx0 exch def
  sgnames /sgn exch def
  sgreadopts
  sgcheckstrict
  sgseed0 null eq { /sgseed0 sgx0 sgy0 sgposseed def } if
  0 1 sgn length 1 sub {
    /sgi exch def
    sgseed0 sgi add sgsetseed
    sgn sgi get sgglyph
    dup sgx0 sgy0 sgemit
    0 get sgsc mul sgx0 add /sgx0 exch def
  } for
} def

% (text) opts sgwidth -> w
% @kind: Procedure
% @summary: The width in points that sgpath would advance for the same text and /Size, from the fixed glyph advances only (never the jittered ink), so a layout measured with it always agrees with the drawing.
% @example: (lib/handscript.ps) run (lib/strokeglyphs.ps) run (x + 1) << /Size 40 >> sgwidth
% @param: /Size [points] The em size, as for sgpath (default 36)
% @param: /Strict [boolean] As for sgpath: true raises sg-missing-glyph:<char>, false counts a missing glyph as 300 design units wide (default true)
/sgwidth {
  sgcheckopts
  exch sgnames exch
  sgreadopts
  sgcheckstrict
  0 exch { sgglyph 0 get add } forall
  sgsc mul
} def

% height depth opts sggrow -> advance
% @kind: Procedure
% @summary: Appends a growing symbol (sum, product, single, double, triple or contour integral, radical, parentheses, brackets, braces, angle brackets, the bar or the double bar) sized to span height above to depth below the baseline, starting at the current point, and returns its advance in points. The jitter stays at the text size however tall the symbol grows.
% @example: (lib/handscript.ps) run (lib/strokeglyphs.ps) run newpath 72 400 moveto 60 30 << /Symbol /parenleft /Size 30 >> sggrow pop 2 setlinewidth stroke
% @param: /Symbol [name] One of /summation /product /integral /iint /iiint /oint /radical /parenleft /parenright /bracketleft /bracketright /braceleft /braceright /bar /angleleft /angleright /dblbar (required)
% @param: /Span [points] For /radical only, how far the vinculum runs to the right of the sign, over the content (default 0)
% @param: /Size [points] The text em size, which sets the jitter scale and the minimum widths (default 36)
% @param: /Slant [degrees] Shear about the baseline, as for sgpath (default 0)
% @param: /Jitter [fraction of /Size] As for sgpath (default 0.016)
% @param: /Seed [integer] Seed for this symbol's jitter (default: derived from the current point's device-space position)
/sggrow {
  sgcheckopts
  3 1 roll
  2 copy sgisnum exch sgisnum and not
    { sggrow-height-and-depth-must-be-numbers } if
  /sgdd exch def /sghh exch def
  sghh sgdd add 0 le { sggrow-height-plus-depth-must-be-positive } if
  dup /Symbol known not { sggrow-needs-a-symbol } if
  dup /Symbol get /sgsym exch def
  false sggrownames { sgsym eq or } forall
  not { sggrow-unknown-symbol } if
  dup /Span 0 sgnumopt
  dup sgisnum { dup 0 lt } { true } ifelse
    { sggrow-span-must-be-a-non-negative-number } if
  /sgspan exch def
  sgreadopts
  { currentpoint } stopped { sggrow-needs-a-current-point } if
  /sgy0 exch def /sgx0 exch def
  sgseed0 null eq { /sgseed0 sgx0 sgy0 sgposseed def } if
  sgsym sghh 1000 mul sgSize div sgdd 1000 mul sgSize div
    sgspan 1000 mul sgSize div sgbuild
  sgseed0 sgsetseed
  dup sgx0 sgy0 sgemit
  0 get sgsc mul
} def

% glyph opts sgmetrics -> dict
% @kind: Procedure
% @summary: Layout metrics for one glyph (a name, or the first glyph of a string) at the given size and slant: /Advance and /Italic correction in points, /BBox [llx lly urx ury] of the unjittered centerline in points relative to the origin, and /Class, TeX's math class (/ord /op /bin /rel /open /close /punct).
% @example: (lib/handscript.ps) run (lib/strokeglyphs.ps) run /f << /Size 40 /Slant 12 >> sgmetrics /Italic get
% @param: /Size [points] The em size (default 36)
% @param: /Slant [degrees] The slant sgpath will draw with; it widens the box and sets the italic correction (default 0)
/sgmetrics {
  sgcheckopts
  exch
  dup type /nametype eq { } {
    sgnames dup length 0 eq { pop /.notdef } { 0 get } ifelse
  } ifelse
  /sgmn exch def
  sgreadopts
  sgmn sgglyph /sgg exch def
  sgg 1 get aload pop
  /sgury exch def /sgurx exch def /sglly exch def /sgllx exch def
  % slanted box: x + y tan
  /sgx1 sgllx sglly sgtan mul add sgllx sgury sgtan mul add min def
  /sgx2 sgurx sglly sgtan mul add sgurx sgury sgtan mul add max def
  <<
    /Name sgmn
    /Advance sgg 0 get sgsc mul
    /BBox [ sgx1 sgsc mul sglly sgsc mul sgx2 sgsc mul sgury sgsc mul ]
    /Class sgclass sgmn known { sgclass sgmn get } { /ord } ifelse
    /Italic sgx2 sgg 0 get sub 0 max sgsc mul
  >>
} def
%%EOF
