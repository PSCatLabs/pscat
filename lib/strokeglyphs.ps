  124 /bar
  172 /logicalnot  177 /plusminus  183 /periodcentered  215 /multiply
  247 /divide
  915 /Gamma  916 /Delta  920 /Theta  923 /Lambda  926 /Xi  928 /Pi
  931 /Sigma  934 /Phi  936 /Psi  937 /Omega
  945 /alpha  946 /beta  947 /gamma  948 /delta  949 /epsilon  950 /zeta
  951 /eta  952 /theta  954 /kappa  955 /lambda  956 /mu  957 /nu
  958 /xi  960 /pi  961 /rho  963 /sigma  964 /tau  966 /phi  967 /chi
  968 /psi  969 /omega
  8230 /ellipsis  8242 /prime
  8592 /arrowleft  8594 /arrowright  8658 /arrowdblright
  8660 /arrowdblboth
  8704 /universal  8706 /partialdiff  8707 /existential  8711 /nabla
  8712 /element  8713 /notelement  8719 /product  8721 /summation
  8722 /minus  8723 /minusplus  8730 /radical  8734 /infinity
  8745 /intersection  8746 /union  8747 /integral  8776 /approxequal
  8800 /notequal  8804 /lessequal  8805 /greaterequal  8834 /propersubset
  8901 /periodcentered
  933 /Upsilon  953 /iota  959 /o  965 /upsilon
  962 /sigma1  977 /theta1  981 /phi  982 /omega1  1008 /kappa1  1009 /rho1
  1013 /lunateepsilon
  8214 /dblbar  8463 /hbar  8467 /ell
  8614 /mapsto  8726 /setminus  8727 /asteriskmath  8728 /ringoperator
  8733 /proportional  8741 /dblbar  8748 /iint  8749 /iiint  8750 /oint
  8756 /therefore  8757 /because  8764 /sim  8771 /simeq  8801 /equiv
  8835 /propersuperset  8838 /reflexsubset  8839 /reflexsuperset
  8869 /perpendicular  8902 /star  9001 /angleleft  9002 /angleright
  10178 /perpendicular  10216 /angleleft  10217 /angleright
  119899 /n.math  119905 /t.math  119909 /x.curly  119910 /y.math
  119911 /z.crossed
