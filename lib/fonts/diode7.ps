%!PS-Adobe-3.0
%%Title: diode7.ps — /Diode7, a 7-row LED sign font
%%Creator: pscat — issue #1426, the retro screen and printer faces
%%EndComments

% /Diode7 — letters for a scrolling LED sign seven lamps high: capitals
% and digits on seven rows, lowercase with a five-row x-height and one
% descender row below the baseline, proportional widths (one to five
% lamps, then one dark column). Each lit LED is a round mark in the
% current colour, so the sign's colour is yours:
%
%   0 setgray clippath fill
%   1 0.15 0.1 setrgbcolor
%   /Diode7 findfont 8 scalefont setfont   % one lamp pitch per unit
%   0 1 moveto (NEWS 7:30) show
%
% Eight scalefont puts one lamp on one unit, so a 32x8 frame rendered
% at 72 dpi holds the text at its true LED size; the capitals and
% digits use only the top seven rows above the baseline.
%
% Dials (read from the font dict at BuildChar time; make a variant with
% pf-variant or the copy-and-definefont idiom, never by putting into a
% defined font, which Ghostscript makes read-only):
%   /DotShape  /round or /square           (default /round)
%   /DotSize   lamp diameter, fraction of the pitch (default 0.8)
%   /ScanGap   fraction of each row left dark (square marks only)
%   /Interpolate  true adds a lamp between neighbours (round marks only)
%
%   /Diode7-Square /Diode7 << /DotShape /square /DotSize 0.9 >> pf-variant
%
% /Diode7 findfont /Bitmaps get /A get is the A's rows, top to bottom,
% '#' lit and '.' dark, for a program that drives a real LED grid.
%
% Provenance: an original design drawn for pscat in 2026 on this grid,
% not traced, converted or copied from any LCD or LED controller's
% character ROM or any existing font. At 5x7 several letters have only
% one legible form, so a likeness to other 5x7 faces there is forced by
% the grid. Licence: the same as the rest of pscat's lib/ (MIT OR
% Apache-2.0; THIRD_PARTY_NOTICES.md).
%
% Draws nothing on load; runs unchanged in Ghostscript.

/Diode7Dict 40 dict def
Diode7Dict begin

  /FontType 3 def
  /FontMatrix [0.125 0 0 0.125 0 0] def   % eight LED rows to the em
  /FontBBox [0 -1 6 7] def
  /Proportional true def
  /Gap 1 def                 % one dark column after each glyph
  /Ascent 7 def              % row 0 is the cap top; row 7 the descender row
  /DotShape /round def
  /DotSize 0.8 def
  /ScanGap 0 def
  /Interpolate false def

  /Bitmaps 100 dict def
