%%SelfTest: annotations-reject-malformed-operands
%   { 0 0 10 (a) << >> mkframe } /mk-coordinates-must-be-numbers (a string corner) mustguard
%   { 0 0 10 10 << /Shape /star >> mkframe } /mk-shape-must-be-box-or-oval (/Shape /star) mustguard
%   { << /Width 3 >> << >> mkframe } /mk-record-must-come-from-mkalign (a dict that is no record) mustguard
%   { << /Origin [0 0] /Angle (up) /Width 1 /Height 1 /Depth 0 >> << >> mkframe }
%   /mk-record-must-come-from-mkalign (a record with a string angle) mustguard
%   { 0 0 10 10 << /Double 1 >> mkunderline } /mk-double-must-be-a-boolean (/Double 1) mustguard
