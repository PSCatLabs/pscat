%   (a digit in calligraphic) mustguard
%   { (\\frac{\\mathbb{R x}}{2}) 0 0 << >> mkpath } /mk-mathbb-takes-capital-letters:x
%   (a lowercase letter in blackboard bold, nested) mustguard
%%EndSelfTest
%
%%SelfTest: errors-leave-the-stacks-as-they-were
%   % bare `stopped`, not mustguard (which restores the stacks itself), and
%   % a sentinel under each call, so popping too far shows as well
%   /mkt-d0 countdictstack def
%   matrix currentmatrix /mkt-m0 exch def
%   /mkt-ctm-same {
%     true 0 1 5 { dup mkt-m0 exch get exch matrix currentmatrix exch get eq and } for
%   } def
%   /mkt-sentinel
%   { (\\frac{\\left[ \\begin{pmatrix} a & \\aleph}{b}) 0 0 << >> mkpath } stopped
%   (an error deep inside nested groups is raised) mustbe
%   /mkt-sentinel eq (the operand stack is cut back to the call, no further) mustbe
%   countdictstack mkt-d0 eq (the dictionary stack is unwound) mustbe
%   /mkt-sentinel
%   { (\\left∮ x \\right.) 0 0 << >> mkpath } stopped
%   (an error on a typed delimiter is raised) mustbe
%   /mkt-sentinel eq (and cuts the operand stack back to the call) mustbe
%   countdictstack mkt-d0 eq (and unwinds the dictionary stack) mustbe
%   /mkt-sentinel
%   { (\\sum_{\\substack{a \\\\ \\aleph}} x) 0 0 << >> mkpath } stopped
%   (an error inside a substack row is raised) mustbe
%   /mkt-sentinel eq (and cuts the operand stack back past its rows) mustbe
%   countdictstack mkt-d0 eq (and unwinds the dictionary stack) mustbe
%   /mkt-xw (x + 1) << /Seed 3 >> mkmetrics /Width get def
%   /mkt-sentinel
%   { (\\frac{\\mathbf{\\mathbb{R x}}}{2}) 0 0 << >> mkpath } stopped
%   (an error inside nested alphabets is raised) mustbe
%   /mkt-sentinel eq (and cuts the operand stack back past the saved alphabets) mustbe
%   countdictstack mkt-d0 eq (and unwinds the dictionary stack) mustbe
%   (x + 1) << /Seed 3 >> mkmetrics /Width get mkt-xw eq
%   (and the next formula is written in no alphabet) mustbe
%   mkt-ctm-same (and keeps the CTM) mustbe
%   /mkt-sentinel
%   [ (a) (b) ] 0 0 << /Ink { pop newpath } >> mkalign
%   length 2 eq (mkalign returns a record per line) mustbe
%   /mkt-sentinel eq (and consumes only its operands) mustbe
%   % an error inside /Ink, after the user rotated
%   /mkt-sentinel
%   { [ (a) (b) ] 100 100 << /Slope 30 /Ink { pop 45 rotate no-such-name } >> mkalign }
%   stopped (an error inside /Ink is raised) mustbe
%   /mkt-sentinel eq (/Ink's error cuts the operand stack back) mustbe
%   countdictstack mkt-d0 eq (/Ink's error unwinds the dictionary stack) mustbe
%   mkt-ctm-same (the CTM is put back after an error) mustbe
%   % a mathkit call nested in /Ink fails: the outer call still unwinds to
%   % its own depths, not the inner one's
%   /mkt-sentinel
%   { [ (a) (b) ] 100 100 << /Ink { pop 30 rotate 7 7 (\\aleph) 0 0 << >> mkpath } >> mkalign }
%   stopped (a nested error is raised) mustbe
%   $error /command get (mk-unsupported-command:\\aleph) cvn eq
%   (it names the nested guard) mustbe
%   /mkt-sentinel eq (the outer call cuts the operand stack back to its own base) mustbe
%   countdictstack mkt-d0 eq (and the dictionary stack to its own depth) mustbe
%   mkt-ctm-same (and puts back its own CTM) mustbe
%%EndSelfTest
