%%SelfTest: the-layout-follows-tex
%   /mkt-m { << /Size 100 /Irregular 0 >> mkmetrics } def
%   (x^2) mkt-m /Width get (x) mkt-m /Width get gt (a superscript widens) mustbe
%   (x^2) mkt-m /Height get (x) mkt-m /Height get gt (and rises) mustbe
%   (x_2) mkt-m /Depth get (x) mkt-m /Depth get gt (a subscript hangs below) mustbe
%   (\\frac{a}{b}) mkt-m dup /Height get 50 gt exch /Depth get 30 gt and
%   (a fraction stands above and below the axis) mustbe
%   (\\sum_{i=1}^n i) mkt-m /Height get
%   (\\sum_{i=1}^n i) << /Size 100 /Irregular 0 /Style /text >> mkmetrics /Height get
%   gt (display style stacks the limits) mustbe
%   (\\sqrt{x}) mkt-m /Height get (x) mkt-m /Height get gt (a root clears its content) mustbe
%   (\\left( \\frac{a}{b} \\right)) mkt-m /Height get (\\frac{a}{b}) mkt-m /Height get ge
%   (a left delimiter grows to its content) mustbe
%   (a+b) mkt-m /Width get (ab) mkt-m /Width get gt (binary operators get space) mustbe
%   (-b) mkt-m /Width get (a-b) mkt-m /Width get (a) mkt-m /Width get sub lt
%   (a leading minus is unary, with no space) mustbe
%   (y &= 2x) mkt-m /Align get (y) mkt-m /Width get sub abs 0.01 lt
%   (& marks the alignment point) mustbe
%   (x') mkt-m /Width get (x^{\\prime}) mkt-m /Width get sub abs 0.01 lt
%   (a prime is as wide as x^{\\prime}) mustbe
%   (x') mkt-m /Height get (x^{\\prime}) mkt-m /Height get sub abs 0.01 lt
%   (and as tall) mustbe
%   (x'_i) mkt-m /Width get (x^{\\prime}_i) mkt-m /Width get sub abs 0.01 lt
%   (x'_i subscripts x, not the prime: it is x^{\\prime}_i) mustbe
%   (f'^2) mkt-m /Width get (f^{\\prime 2}) mkt-m /Width get sub abs 0.01 lt
%   (f'^2 is f^{\\prime 2}) mustbe
%   (f'') mkt-m /Width get (f') mkt-m /Width get gt (two primes are wider) mustbe
%   (y = 2x) mkt-m /Align get (y &= 2x) mkt-m /Align get sub abs 0.01 lt
%   (without &, the line aligns before its relation) mustbe
%   (x^2) << /Size 100 /Irregular 0 /Seed 1 >> mkmetrics /Width get
%   (x^2) << /Size 100 /Irregular 0 /Seed 2 >> mkmetrics /Width get eq
%   (/Irregular 0 is the same layout for every seed) mustbe
%   (x^2+y^2) << /Size 100 /Seed 1 >> mkmetrics /Width get
%   (x^2+y^2) << /Size 100 /Seed 2 >> mkmetrics /Width get ne
%   (/Irregular 1 varies with the seed) mustbe
%%EndSelfTest
