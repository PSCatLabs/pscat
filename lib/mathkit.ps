%   (a \\pmod{n}) mkt-m /Width get (a \\mod{n}) mkt-m /Width get gt
%   (\pmod adds the parentheses \mod leaves out) mustbe
%   % \nolimits sets a brace's label beside it, as a script: wider, lower
%   (\\overbrace{a+b}\\nolimits^{k}) mkt-m /Height get
