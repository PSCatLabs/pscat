%%SelfTest: mkalign-columns-alternate-right-and-left
%   % issue #340: with more than one & a line has TeX align's columns
%   /mkt-o << /Size 30 /Irregular 0 /Seed 2 >> def
%   /mkt-ends { [ exch { dup /Origin get 0 get exch /Width get add } forall ] } def
%   newpath [ (x &= a & y &= b) (xxx &= aaaaaa & y &= b) ] 100 300 mkt-o mkalign
%   mkt-ends aload pop sub abs 0.01 lt
%   (the second pair of columns starts at one x on every line) mustbe
%   newpath [ (x &= a & y &= b) (xxx &= aaaaaa & yyyy &= b) ] 100 300 mkt-o mkalign
%   mkt-ends aload pop sub abs 0.01 lt
%   (its right column is right-aligned: the pair's & lines up) mustbe
%   newpath [ (x &= a & y &= b) (x &= a) ] 100 300 mkt-o mkalign
%   0 get /Width get
%   (x &= a & y &= b) mkt-o mkmetrics /Width get 59 add gt
%   (the pairs stand /ColumnGap apart) mustbe
%   newpath [ (x &= a & y &= b) ] 100 300 << /Size 30 /Irregular 0 /Seed 2 /ColumnGap 0 >> mkalign
%   0 get /Width get
%   newpath [ (x &= a & y &= b) ] 100 300 << /Size 30 /Irregular 0 /Seed 2 /ColumnGap 1 >> mkalign
%   0 get /Width get exch sub 30 sub abs 0.01 lt
%   (/ColumnGap is in multiples of /Size) mustbe
%   % the 2nd & starts a fresh cell: a minus after it is unary, as in TeX
%   newpath [ (a &= b & -y &= c) ] 100 300 mkt-o mkalign 0 get /Width get
%   newpath [ (a &= b & {-y} &= c) ] 100 300 mkt-o mkalign 0 get /Width get
%   sub abs 0.01 lt (a minus after the 2nd & is unary) mustbe
%   % one & per line is laid out as it always was
%   newpath [ (y &= 2x) (&= x + x) ] 100 300 mkt-o mkalign
%   0 get /Width get (y &= 2x) mkt-o mkmetrics /Width get sub abs 0.01 lt
%   (a single & changes nothing) mustbe
%   newpath
%%EndSelfTest
