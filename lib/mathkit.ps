%%SelfTest: mkpath-refuses-what-it-does-not-support
%   % a single backslash is eaten by the PostScript string: \sqrt is "sqrt",
%   % \frac starts with a form feed
%   { (\sqrt{x}) 0 0 << >> mkpath } /mk-bare-word-needs-a-backslash:sqrt
%   (a lost backslash before sqrt) mustguard
%   { (\frac{a}{b}) 0 0 << >> mkpath }
%   /mk-control-character:write-each-TeX-backslash-as-\\ (a form feed from \f) mustguard
%   { (\\iiiint f) 0 0 << >> mkpath } /mk-unsupported-command:\iiiint (\iiiint) mustguard
%   { (a @ b) 0 0 << >> mkpath } /mk-unsupported-character:@ (an at sign) mustguard
%   { (⊛) 0 0 << >> mkpath } /mk-unsupported-character:⊛ (a circled asterisk) mustguard
%   { (\\left< x \\right>) 0 0 << >> mkpath } (mk-unsupported-delimiter:<) cvn
%   (an angle bracket delimiter) mustguard
%   { (\\left\\lceil x \\right.) 0 0 << >> mkpath } /mk-unsupported-delimiter:\lceil
%   (\lceil) mustguard
%   { (\\aleph) 0 0 << >> mkpath } /mk-unsupported-command:\aleph (\aleph) mustguard
%   { (\\begin{array} x \\end{array}) 0 0 << >> mkpath }
%   /mk-unsupported-environment:array (the array environment) mustguard
%   { (x^) 0 0 << >> mkpath } /mk-missing-argument:^ (a superscript with nothing) mustguard
%   { (\\frac{a}) 0 0 << >> mkpath } /mk-missing-argument:\frac (\frac with one argument) mustguard
%   { (\\vec) 0 0 << >> mkpath } /mk-missing-argument:\vec (an accent with nothing) mustguard
%   { (x^2^3) 0 0 << >> mkpath } /mk-double-superscript (x^2^3) mustguard
%   { (x_1_2) 0 0 << >> mkpath } /mk-double-subscript (x_1_2) mustguard
%   { (x^2') 0 0 << >> mkpath } /mk-double-superscript (a prime after a superscript) mustguard
%   { ({x) 0 0 << >> mkpath } /mk-missing-closing-brace (an open brace) mustguard
%   { (x}) 0 0 << >> mkpath } /mk-extra-closing-brace (a stray closing brace) mustguard
%   { (\\left[ x) 0 0 << >> mkpath } /mk-left-without-right (a left with no right) mustguard
%   { (x \\right]) 0 0 << >> mkpath } /mk-right-without-left (a right with no left) mustguard
%   { (a \\\\ b) 0 0 << >> mkpath } /mk-row-break-outside-a-matrix (\\ in a line) mustguard
%   { ({a & b}) 0 0 << >> mkpath } /mk-misplaced-ampersand (& inside a group) mustguard
%   { (\\begin{pmatrix} a & b) 0 0 << >> mkpath } /mk-begin-without-end:pmatrix
%   (an unclosed matrix) mustguard
%   { (\\begin{pmatrix} a \\end{bmatrix}) 0 0 << >> mkpath }
%   /mk-end-does-not-match-begin:pmatrix (mismatched environments) mustguard
%   { (x \\end{pmatrix}) 0 0 << >> mkpath } /mk-end-without-begin (a stray \end) mustguard
%   { (\\sqrt[3 x) 0 0 << >> mkpath } /mk-sqrt-index-needs-a-closing-bracket
%   (an open root index) mustguard
%   { (\\text x) 0 0 << >> mkpath } /mk-text-needs-braces (\text without braces) mustguard
%   { (x \\limits) 0 0 << >> mkpath } /mk-limits-needs-an-operator-before-it
%   (\limits after a letter) mustguard
%   { (\\left x \\right.) 0 0 << >> mkpath } /mk-unsupported-delimiter:x
%   (a letter as a delimiter) mustguard
%   { (x_{max}) 0 0 << >> mkpath } /mk-bare-word-needs-a-backslash:max
%   (the letters of an operator name) mustguard
