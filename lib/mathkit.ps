%%SelfTest: ascii-star-is-ast
%   % issue #364: * was refused; in math it is \\ast, with TeX's class rules
%   (a*b) << /Size 100 /Irregular 0 >> mkmetrics /Width get
%   (a \\ast b) << /Size 100 /Irregular 0 >> mkmetrics /Width get eq
%   (a*b is a \\ast b) mustbe
%   (z^*) << /Size 100 /Irregular 0 >> mkmetrics /Width get
%   (z^{\\ast}) << /Size 100 /Irregular 0 >> mkmetrics /Width get eq
%   (z^* is z^{\\ast}) mustbe
%   % a star at the start or the end of a formula is an ordinary symbol
%   % (TeX rules 5 and 6): no medium space beside it, so widths just add
%   (*b) << /Size 100 /Irregular 0 >> mkmetrics /Width get
%   (*) << /Size 100 /Irregular 0 >> mkmetrics /Width get
%   (b) << /Size 100 /Irregular 0 >> mkmetrics /Width get add sub abs 0.01 lt
%   (a leading * takes no space after it) mustbe
%   (a*) << /Size 100 /Irregular 0 >> mkmetrics /Width get
%   (a) << /Size 100 /Irregular 0 >> mkmetrics /Width get
%   (*) << /Size 100 /Irregular 0 >> mkmetrics /Width get add sub abs 0.01 lt
%   (a trailing * takes no space before it) mustbe
%   % raised in a superscript, lowered in a subscript
%   (z^*) << /Size 100 /Irregular 0 >> mkmetrics /Height get
%   (z) << /Size 100 /Irregular 0 >> mkmetrics /Height get gt
%   (z^* rises above z) mustbe
%   (A_*) << /Size 100 /Irregular 0 >> mkmetrics /Depth get 0 gt
%   (A_* hangs below the baseline) mustbe
%   [ (\\psi^*) (f^{**}) (A^* B_*) (z^* = x - i y) (\\left(z^*\\right)^*)
%     (\\sum_{k=1}^* a_k^*) (a * b) (\\frac{a^*}{b_*})
%   ] true exch {
%     /mkt-s exch def
%     mkt-s << /Size 40 /Seed 3 >> mkmetrics /Width get 0 gt and
%     newpath mkt-s 0 0 << /Size 40 /Seed 3 >> mkpath newpath
%   } forall
%   (starred scripts lay out and draw) mustbe
%%EndSelfTest
%
%%SelfTest: ascii-star-in-text-is-a-raised-asterisk
%   % issue #378: * was refused inside \text, \mathrm and \operatorname,
%   % where TeX sets a raised text asterisk, not the centred math \ast
%   [ (\\text{a*b}) (\\mathrm{a*b}) (\\operatorname{a*b}) (\\text{*})
%     (\\mathrm{x*}) (\\text{a * b}) ] true exch {
%     /mkt-s exch def
%     mkt-s << /Size 40 /Seed 3 >> mkmetrics /Width get 0 gt and
%     newpath mkt-s 0 0 << /Size 40 /Seed 3 >> mkpath newpath
%   } forall
%   (a star in text, mathrm and operatorname lays out and draws) mustbe
%   % set as an ordinary letter: no medium space around it, so it is
%   % narrower than the math a \ast b
%   (\\text{a*b}) << /Size 100 /Irregular 0 >> mkmetrics /Width get
%   (a*b) << /Size 100 /Irregular 0 >> mkmetrics /Width get lt
%   (a text star takes no binary-operator space) mustbe
%   % raised, not on the math axis: the ink of a lone text star starts
%   % higher than a lone math star's
%   newpath (\\text{*}) 0 0 << /Size 100 /Irregular 0 >> mkpath
%   pathbbox pop pop exch pop
%   newpath (*) 0 0 << /Size 100 /Irregular 0 >> mkpath
%   pathbbox pop pop exch pop
%   gt (a text star sits higher than the math star) mustbe
%   newpath
%%EndSelfTest
%
%%SelfTest: delimiters-typed-as-unicode
%   % issue #365: \left⟨ went to the ASCII branch, which took one byte, so
%   % the error name held a raw lead byte and the real forms were refused
%   /mkt-w { << /Size 60 /Irregular 0 >> mkmetrics /Width get } def
%   (\\left⟨ \\frac{a}{b} \\right⟩) mkt-w
%   (\\left\\langle \\frac{a}{b} \\right\\rangle) mkt-w eq
%   (typed angle brackets are \langle and \rangle) mustbe
%   (\\left‖ x \\right‖) mkt-w (\\left\\Vert x \\right\\Vert) mkt-w eq
%   (a typed double bar is \Vert) mustbe
%   (\\left∥ x \\right∥) mkt-w (\\left\\Vert x \\right\\Vert) mkt-w eq
%   (the parallel sign is the same double bar) mustbe
%   (\\bigl⟨ x \\bigr⟩) mkt-w (\\bigl\\langle x \\bigr\\rangle) mkt-w eq
%   (\big takes them too) mustbe
%   (\\left⟨ x \\right.) mkt-w (\\left\\langle x \\right.) mkt-w eq
%   (a typed delimiter may pair with a dot) mustbe
%   { (\\left∮ x \\right.) 0 0 << >> mkpath } /mk-unsupported-delimiter:∮
%   (a contour integral is no delimiter) mustguard
%   { (\\left∑ x \\right.) 0 0 << >> mkpath } /mk-unsupported-delimiter:∑
%   (a grower that is no delimiter: a summation) mustguard
%   { (\\left. x \\right⌋) 0 0 << >> mkpath } /mk-unsupported-delimiter:⌋
%   (a floor bracket on the right) mustguard
%   { (\\bigl⌈ x) 0 0 << >> mkpath } /mk-unsupported-delimiter:⌈
%   (a ceiling bracket after \bigl) mustguard
%   { (\\left\\⟨ x \\right.) 0 0 << >> mkpath } /mk-unsupported-delimiter:\⟨
%   (a backslash before a typed character names both) mustguard
%   { (\\left\342) 0 0 << >> mkpath } (mk-unsupported-delimiter:\342) cvn
%   (a cut-off character at the end of the source) mustguard
%%EndSelfTest
