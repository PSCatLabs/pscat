%   newpath mkt-lines 100 300 << /Size 30 /Seed 2 /Irregular 1 >> mkalign /mkt-q exch def
%   /mkt-d [ 0 1 3 { dup mkt-r exch get /Width get exch mkt-q exch get /Width get sub } for ] def
%   false mkt-d { abs 0.01 gt or } forall (the second pair wanders) mustbe
