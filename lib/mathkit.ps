%%SelfTest: variant-greek-is-its-own-glyph
%   % issue #366: the variant commands draw glyphs of their own, not the
%   % plain letters they used to alias
%   [ [ (\\varphi) (\\phi) ] [ (\\vartheta) (\\theta) ] [ (\\varpi) (\\pi) ]
%     [ (\\varrho) (\\rho) ] [ (\\varsigma) (\\sigma) ] [ (\\varkappa) (\\kappa) ]
%     [ (\\epsilon) (\\varepsilon) ] ] true exch {
%     aload pop
%     << /Size 100 /Irregular 0 >> mkmetrics /Width get exch
%     << /Size 100 /Irregular 0 >> mkmetrics /Width get ne and
%   } forall
%   (every variant is wider or narrower than its plain letter) mustbe
%   % mathkit's \varepsilon is the three-shaped epsilon, as it always was
%   (\\varepsilon) << /Size 100 /Irregular 0 >> mkmetrics /Width get
%   (ε) << /Size 100 /Irregular 0 >> mkmetrics /Width get eq
%   (\varepsilon is still the three-shaped epsilon) mustbe
%   % the typed Unicode forms reach the same glyphs as the commands
%   (ϑ) << /Size 100 /Irregular 0 >> mkmetrics /Width get
%   (\\vartheta) << /Size 100 /Irregular 0 >> mkmetrics /Width get eq
%   (a typed ϑ is \vartheta) mustbe
%   (ϵ) << /Size 100 /Irregular 0 >> mkmetrics /Width get
%   (\\epsilon) << /Size 100 /Irregular 0 >> mkmetrics /Width get eq
%   (a typed ϵ is \epsilon) mustbe
%   (\\varphi_i + \\vartheta^2 = \\varkappa \\varrho \\varpi \\varsigma)
%   << /Size 40 /Seed 3 >> mkmetrics /Width get 0 gt
%   (variants lay out in scripts and runs) mustbe
%%EndSelfTest
%
%%SelfTest: tex-structures-lay-out
%   % issue #340: style switches, braces, stacked labels, \not, \bmod,
%   % \pmod; each was refused as an unsupported command before
%   [ (\\displaystyle \\sum_i x) (a \\textstyle \\sum_i x) (\\scriptstyle x + y)
%     (\\scriptscriptstyle x) (\\overbrace{a+b}^{n}) (\\underbrace{a+b}_{k})
%     (\\overbrace{}) (\\underbrace{x}) (\\overset{a}{=}) (\\underset{x}{\\lim} f)
%     (a \\stackrel{?}{=} b) (\\sum_{\\substack{i<m \\\\ j<n}} a_{ij})
%     (\\substack{a \\\\ b \\\\}) (a \\not= b) (x \\not\\in A) (a \\not< b)
%     (A \\not\\subset B) (a \\not{\\equiv} b) (7 \\bmod 3) (a \\equiv b \\pmod{n})
%     (\\overbrace{\\underbrace{x}_{1}}^{2}) ]
%   true exch {
%     /mkt-s exch def
%     mkt-s << /Size 40 /Seed 3 >> mkmetrics /Width get 0 gt and
%     newpath mkt-s 0 0 << /Size 40 /Seed 3 /Slant 10 >> mkpath newpath
%   } forall
%   (every new structure lays out and draws) mustbe
%   /mkt-m { << /Size 100 /Irregular 0 >> mkmetrics } def
%   % a style switch sets the rest of the list in that style
%   (\\displaystyle \\sum_{i=1}^n i) << /Size 100 /Irregular 0 /Style /text >> mkmetrics
%   /Height get (\\sum_{i=1}^n i) mkt-m /Height get sub abs 0.01 lt
%   (\displaystyle in text style stacks the limits) mustbe
%   (\\textstyle \\sum_{i=1}^n i) mkt-m /Height get
%   (\\sum_{i=1}^n i) << /Size 100 /Irregular 0 /Style /text >> mkmetrics /Height get
%   sub abs 0.01 lt (\textstyle puts them beside) mustbe
%   (\\scriptstyle x) mkt-m /Width get (x) mkt-m /Width get 0.7 mul sub abs 0.01 lt
%   (\scriptstyle sets x at 0.7) mustbe
%   (x \\scriptstyle x) mkt-m /Width get (x) mkt-m /Width get 1.7 mul sub abs 0.01 lt
%   (only after the switch) mustbe
%   % braces stand over and under, their labels beyond them
%   (\\overbrace{a+b}) mkt-m /Height get (a+b) mkt-m /Height get 15 add gt
%   (an overbrace stands above its content) mustbe
%   (\\overbrace{a+b}^{n}) mkt-m /Height get (\\overbrace{a+b}) mkt-m /Height get gt
%   (and its label above it) mustbe
%   (\\underbrace{a+b}) mkt-m /Depth get /mkt-d exch def
%   mkt-d (a+b) mkt-m /Depth get 15 add gt (an underbrace hangs below its content) mustbe
%   (\\underbrace{a+b}_{k}) mkt-m /Depth get mkt-d gt (and its label below it) mustbe
%   % \overset takes its base's class: a relation keeps its spaces
%   (x \\overset{a}{=} y) mkt-m /Width get (\\overset{a}{=}) mkt-m /Width get sub
%   (x = y) mkt-m /Width get (=) mkt-m /Width get sub sub abs 0.01 lt
%   (\overset{a}{=} is a relation) mustbe
%   (x \\stackrel{a}{b} y) mkt-m /Width get (\\stackrel{a}{b}) mkt-m /Width get sub
%   (x = y) mkt-m /Width get (=) mkt-m /Width get sub sub abs 0.01 lt
%   (\stackrel makes a relation) mustbe
%   (\\overset{a}{=}) mkt-m /Height get (=) mkt-m /Height get gt
%   (the label stands over the base) mustbe
%   (\\underset{a}{=}) mkt-m /Depth get (=) mkt-m /Depth get gt
%   (\underset puts it under) mustbe
%   % \substack stacks rows under an operator
%   (\\sum_{\\substack{a \\\\ b}}) mkt-m /Depth get (\\sum_{a}) mkt-m /Depth get gt
%   (a substack hangs deeper than one row) mustbe
%   (\\substack{a \\\\ b \\\\}) mkt-m /Height get (\\substack{a \\\\ b}) mkt-m /Height get eq
%   (a trailing row break adds no row) mustbe
%   (\\substack{x}) mkt-m /Width get (x) mkt-m /Width get 0.7 mul sub abs 0.01 lt
%   (substack rows are script style even at the top level) mustbe
%   (\\sum_{\\sum_{\\substack{xxxxxxxx}}}) mkt-m /Width get
%   (\\sum_{\\sum_{xxxxxxxx}}) mkt-m /Width get gt
%   (and in a second-level limit, where scriptscript would be smaller) mustbe
%   % \not
%   (a \\not= b) mkt-m /Width get (a \\neq b) mkt-m /Width get sub abs 0.01 lt
%   (\not= is \neq) mustbe
%   (a \\not\\in b) mkt-m /Width get (a \\notin b) mkt-m /Width get sub abs 0.01 lt
%   (\not\in is \notin) mustbe
%   (a \\not< b) mkt-m /Width get (a < b) mkt-m /Width get sub abs 0.01 lt
%   (a struck relation keeps its width and class) mustbe
%   (\\not<) mkt-m /Height get (<) mkt-m /Height get gt (the slash reaches past it) mustbe
%   % \bmod is a binary operator, \pmod a quad then (mod n)
%   (a \\bmod b) mkt-m /Width get (a \\text{mod} b) mkt-m /Width get gt
%   (\bmod takes a binary operator's spaces) mustbe
%   (a \\pmod{n}) mkt-m /Width get (a \\quad (\\text{mod}\\,\\,n)) mkt-m /Width get
%   sub abs 0.01 lt (\pmod{n} is a quad and (mod n)) mustbe
%   % refusals
%   { (a \\not \\frac{1}{2}) 0 0 << >> mkpath } /mk-not-needs-one-symbol-after-it
%   (\not before a fraction) mustguard
%   { (a \\not{<>} b) 0 0 << >> mkpath } /mk-not-needs-one-symbol-after-it
%   (\not before two symbols) mustguard
%   { (\\not) 0 0 << >> mkpath } /mk-missing-argument:\not (\not with nothing) mustguard
%   { (\\substack a) 0 0 << >> mkpath } /mk-substack-needs-braces
%   (\substack without braces) mustguard
%   { (\\substack{a & b}) 0 0 << >> mkpath } /mk-misplaced-ampersand (& in a substack) mustguard
%   { (\\substack{a \\\\ b) 0 0 << >> mkpath } /mk-missing-closing-brace
%   (an open substack) mustguard
%   { (\\overbrace) 0 0 << >> mkpath } /mk-missing-argument:\overbrace
%   (\overbrace with nothing) mustguard
%   { (\\overset{a}) 0 0 << >> mkpath } /mk-missing-argument:\overset
%   (\overset with one argument) mustguard
%   { [ (a) ] 0 0 << /ColumnGap -1 >> mkalign } /mk-columngap-must-be-a-non-negative-number
%   (/ColumnGap -1) mustguard
%   % a bare command word lost its backslash
%   { (a not b) 0 0 << >> mkpath } /mk-bare-word-needs-a-backslash:not (a bare not) mustguard
%%EndSelfTest
