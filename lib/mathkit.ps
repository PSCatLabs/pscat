%                (x &= a & y &= b) ] def
%   % the wander stays out of the layout until asked for
%   /mkt-same { true 0 1 3 { dup mkt-a exch get exch mkt-b exch get eq and } for } def
%   newpath mkt-lines 100 300 << /Size 30 /Seed 2 >> mkalign mkt-ends /mkt-a exch def
%   newpath mkt-lines 100 300 << /Size 30 /Seed 2 /ColumnWander 0 >> mkalign mkt-ends
%   /mkt-b exch def mkt-same (/ColumnWander 0 is the layout without it) mustbe
%   % it is a hand's: none at /Irregular 0
