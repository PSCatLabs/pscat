%   { [ (a) 5 ] 0 0 << >> mkalign } /mk-lines-must-be-an-array-of-strings (a number as a line) mustguard
%   { [ (a) ] 0 0 << /Ink 5 >> mkalign } /mk-ink-must-be-a-procedure (/Ink 5) mustguard
%   { [ (a) ] 0 0 << /Leading 0 >> mkalign } /mk-leading-must-be-a-positive-number (/Leading 0) mustguard
