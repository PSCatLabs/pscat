%   (\\overbrace{a+b}^{k}) mkt-m /Height get eq (\limits is a brace's default) mustbe
%   [ (a \\equiv b \\mod{n}) (a \\equiv b \\pod{n}) (x \\pod{\\frac{1}{2}})
%     (\\underbrace{x+y}\\nolimits_{n}^{2}) ] true exch {
%     /mkt-s exch def
%     mkt-s << /Size 40 /Seed 3 >> mkmetrics /Width get 0 gt and
