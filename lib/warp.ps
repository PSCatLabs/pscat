%!PS-Adobe-3.0
%%Title: Warp — non-affine path transforms and decorated drawing
%%EndComments
% @requires: (lib/functional.ps) run (lib/aspect.ps) run
% PostScript's CTM is affine: it can scale, rotate and shear, never bend.
% This library treats a path as data, maps a point warp ( x y -- x' y' )
% over it with fp-map, and rebuilds it, so straight edges really curve.
% Warps are ordinary quotations: fp-compose chains them, and the scoped
% runner decorates fill/stroke/show so an unmodified program draws through
% a warp. All public names start wp-. Contracts: docs/functional-postscript/WARP.md.
%
% Path records: [/m x y] moveto, [/l x y] lineto, [/z] closepath. Curves
% are flattened first; long lines are subdivided so the warp can bend them.

%%SelfTest: warp-contracts
% { [] 0 wp-subdivide } /wp-step-must-be-positive (zero step) mustguard
% { [] (2) wp-subdivide } /wp-step-must-be-positive (string step) mustguard
% { [] wp-lift } /fp-quotation-required (lift needs a warp) mustguard
% { (missing.ps) 5 wp-run-decorated } /wp-decorators-must-be-dictionary (decorator type) mustguard
% { [] { pop 1 2 } wp--try } /wp-warp-must-return-one-result (path warp leaves two results) mustguard
% { [] { pop } wp--try } /wp-warp-must-return-one-result (path warp leaves none) mustguard
% { [] { pop 1 } wp--try } /wp-warp-must-return-one-result (path warp leaves a number) mustguard
% { 1 2 3 3 { pop pop pop 1 } wp--guarded } /wp-warp-must-return-one-result (text warp leaves one point) mustguard
%%EndSelfTest

% ( dict body -- warp ): a warp that opens its own scratch dictionary, so
% the names it uses never land in the drawing program's dictionaries.
% @internal
/wp--closure {
  [ 3 1 roll /begin load exch /exec load /end load ] cvx
} bind def

% @kind: Procedure
% @summary: Return the current path, flattened, as [/m x y] [/l x y] [/z] records.
% @example: newpath 0 0 moveto 10 0 lineto wp-path
/wp-path {
  flattenpath
  [ {/m 3 1 roll 3 array astore} {/l 3 1 roll 3 array astore}
    {} {[/z]} pathforall ]
} bind def

% Closing edges become explicit lines, so they bend too: a closepath
% record follows its edge's samples.
% @kind: Procedure
% @summary: Split every edge into steps no longer than step user units.
% @example: newpath 0 0 moveto 10 0 lineto wp-path 2 wp-subdivide
/wp-subdivide {
  dup type dup /integertype ne exch /realtype ne and
    { wp-step-must-be-positive } if
  dup 0 le { wp-step-must-be-positive } if
  12 dict begin
  /step exch def /px 0 def /py 0 def /sx 0 def /sy 0 def
  /line-to {
    /y1 exch def /x1 exch def
    /n x1 px sub dup mul y1 py sub dup mul add sqrt step div ceiling cvi 1 max def
    1 1 n {
      n div /t exch def
      /l px x1 px sub t mul add py y1 py sub t mul add 3 array astore
    } for
    /px x1 def /py y1 def
  } def
  [ exch {
      dup 0 get
      dup /m eq {
        pop dup aload pop /py exch def /px exch def pop /sy py def /sx px def
      } {
        /l eq { aload pop 3 -1 roll pop line-to } { pop sx sy line-to [/z] } ifelse
      } ifelse
  } forall ]
  end
} bind def

% @kind: Procedure
% @summary: Lift a point warp x y -- x' y' to a callback that maps one path record.
% @example: {exch} wp-lift
/wp-lift {
  //fp--quote exec
  { exch dup 0 get /z eq { exch pop }
      { aload pop 4 -1 roll exec 3 array astore } ifelse } //fp-curry exec
} bind def

% @kind: Procedure
% @summary: Append path records to the current path.
% @example: [[/m 0 0] [/l 10 0]] wp-emit
/wp-emit {
  { dup 0 get /z eq { pop closepath }
      { aload pop 3 -1 roll /m eq { moveto } { lineto } ifelse } ifelse
  } //fp-each exec
} bind def

% @kind: Procedure
% @summary: Replace the current path with its image under a warp, subdividing to step.
% @example: newpath 0 0 moveto 100 0 lineto {1 index 3 div sin 5 mul add} 4 wp-warppath
/wp-warppath {
  exch //wp-lift exec exch
  //wp-path exec exch //wp-subdivide exec exch //fp-map exec
  newpath //wp-emit exec
} bind def

% @kind: Procedure
% @summary: Turn a point warp into a path transform, records -- records, for wp-run-path.
% @example: {exch} wp-points
/wp-points { //wp-lift exec {//fp-map exec} //fp-curry exec } bind def

% ---- Warps: each constructor returns a quotation ( x y -- x' y' ) ----

% @kind: Procedure
% @summary: Warp that translates by dx dy; compose it to place a shape before bending it.
% @example: 3 4 10 20 wp-shift exec
/wp-shift {
  2 array astore { aload pop 3 -1 roll add 3 1 roll add exch } //fp-curry exec
} bind def

% @kind: Procedure
% @summary: Warp that scales about the origin by sx sy.
% @example: 3 4 2 0.5 wp-scale exec
/wp-scale {
  2 array astore { aload pop 3 -1 roll mul 3 1 roll mul exch } //fp-curry exec
} bind def

% x runs along the arc (degrees-per-unit, clockwise from 12 o'clock at
% x = 0); y runs outward from radius r0. Straight text becomes a ring.
% @kind: Procedure
% @summary: Warp a horizontal strip onto a ring around cx cy, starting at radius r0.
% @example: 0 0 300 300 100 0.5 wp-polar exec
/wp-polar {
  8 dict begin /k exch def /r0 exch def /cy exch def /cx exch def currentdict end
  { /y exch def k mul 90 exch sub /a exch def
    r0 y add dup a cos mul cx add exch a sin mul cy add } //wp--closure exec
} bind def

% @kind: Procedure
% @summary: Warp that displaces y by amplitude times the sine of x over a wavelength.
% @example: 25 0 8 100 wp-ripple exec
/wp-ripple {
  2 array astore
  { aload pop 3 index exch div 360 mul sin mul add } //fp-curry exec
} bind def

% Magnifies (strength > 0) or pinches (< 0) inside radius r; identity outside.
% @kind: Procedure
% @summary: Warp that bulges or pinches the disc of radius r around cx cy.
% @example: 110 100 100 100 50 0.5 wp-lens exec
/wp-lens {
  10 dict begin /s exch def /r exch def /cy exch def /cx exch def currentdict end
  { cy sub /dy exch def cx sub /dx exch def
    /d dx dup mul dy dup mul add sqrt def
    d r lt { 1 d r div dup mul sub s mul 1 add } { 1 } ifelse
    dup dx mul cx add exch dy mul cy add } //wp--closure exec
} bind def

% Rotation falls from degrees at the centre to zero at radius r.
% @kind: Procedure
% @summary: Warp that twists the disc of radius r around cx cy by up to degrees.
% @example: 110 100 100 100 50 90 wp-swirl exec
/wp-swirl {
  10 dict begin /deg exch def /r exch def /cy exch def /cx exch def currentdict end
  { cy sub /dy exch def cx sub /dx exch def
    /d dx dup mul dy dup mul add sqrt def
    /a d r lt { 1 d r div sub dup mul deg mul } { 0 } ifelse def
    dx a cos mul dy a sin mul sub cx add
    dx a sin mul dy a cos mul add cy add } //wp--closure exec
} bind def

% Projective map from the rectangle 0 0 w h onto the quadrilateral
% (x0 y0) (x1 y1) (x2 y2) (x3 y3), counter-clockwise from bottom left
% (Heckbert's square-to-quad). Parallel lines meet at vanishing points:
% no CTM can do this.
% @kind: Procedure
% @summary: Warp the rectangle 0 0 w h onto any four-cornered quadrilateral in perspective.
% @example: 50 50 0 0 100 0 90 80 10 80 100 100 wp-perspective exec
/wp-perspective {
  24 dict begin
  /h exch def /w exch def
  /y3 exch def /x3 exch def /y2 exch def /x2 exch def
  /y1 exch def /x1 exch def /y0 exch def /x0 exch def
  /sx x0 x1 sub x2 add x3 sub def /sy y0 y1 sub y2 add y3 sub def
  /dx1 x1 x2 sub def /dx2 x3 x2 sub def /dy1 y1 y2 sub def /dy2 y3 y2 sub def
  /det dx1 dy2 mul dx2 dy1 mul sub def
  sx abs 1e-9 lt sy abs 1e-9 lt and det abs 1e-12 lt or
    { /g 0 def /hh 0 def }
    { /g sx dy2 mul dx2 sy mul sub det div def
      /hh dx1 sy mul sx dy1 mul sub det div def } ifelse
  /a x1 x0 sub g x1 mul add def /b x3 x0 sub hh x3 mul add def
  /d y1 y0 sub g y1 mul add def /e y3 y0 sub hh y3 mul add def
  currentdict end
  { h div /v exch def w div /u exch def
    /q g u mul hh v mul add 1 add def
    a u mul b v mul add x0 add q div
    d u mul e v mul add y0 add q div } //wp--closure exec
} bind def

% The inverse of wp-polar, as a path transform: angle clockwise from
% 12 o'clock becomes x (k units per degree), radius becomes y. Applied one
% path at a time, so a shape that straddles 12 o'clock is kept whole on
% the side of its first point instead of being torn across the page.
% @kind: Procedure
% @summary: Path transform that unrolls rings around cx cy into straight horizontal bands.
% @example: 0 0 1 wp-unroll
/wp-unroll {
  12 dict begin
  /k exch def /cy exch def /cx exch def /turn k 360 mul def
  currentdict end
  dup
  { /y exch cy sub def /x exch cx sub def
    90 y x atan sub dup 360 div floor 360 mul sub k mul
    x dup mul y dup mul add sqrt } //wp--closure exec //wp-points exec
  exch
  { /recs exch def /x0 null def
    [ recs {
        dup 0 get /z ne {
          aload pop /y exch def /x exch def
          x0 null eq { /x0 x def } if
          x x0 sub turn 2 div gt { /x x turn sub def } if
          x x0 sub turn 2 div neg lt { /x x turn add def } if
          x y 3 array astore
        } if
    } forall ] } //wp--closure exec
  //fp-compose exec
} bind def

% ---- Running an unmodified program through decorators ----

% ( records -- records ): close every open subpath, as fill and clip do
% implicitly, so the closing edge is subdivided and bends with the rest.
% @internal
/wp--close-subpaths {
  [ exch //false exch
    { dup 0 get
      dup /m eq { pop exch { [/z] exch } if //true }
        { /z eq { exch pop //false } { exch pop //true } ifelse } ifelse
    } forall
    { [/z] } if ]
} bind def

% ( transform step base -- records ): the current path warped, in the base
% coordinate space captured when the run began. Every caller fills or clips
% the result, so open subpaths are closed first. It only reads the path: the
% caller rebuilds it with wp--apply once the warp has run without error.
% @internal
/wp--compute {
  setmatrix
  //wp-path exec //wp--close-subpaths exec
  exch //wp-subdivide exec exch exec
} bind def

% ( records base -- ): make records the current path, built in the base
% coordinate space, then put the CTM back.
% @internal
/wp--apply {
  matrix currentmatrix 3 1 roll setmatrix
  newpath //wp-emit exec
  setmatrix
} bind def

% ---- Guards: the user's warp runs inside one of these ----
% A warp is the user's code, so it can fail, leave results behind, open a
% dictionary (the closure warps do) or push a mark. A guard runs it inside a
% gsave and, on an error, puts the program back where the call found it:
% operands popped back to the depth at entry (counted, not found by a mark,
% since the warp may push marks of its own), dictionaries closed back to
% the depth at entry, the gsave undone, and the error re-raised with stop so
% $error keeps its name and offending command. A warp that fails to leave
% exactly the expected results is an error too. What a guard needs to do
% that, A = [ saved n d k type ], lives in the executable array that runs
% the warp, not on the operand stack, where the warp could reach it.
%   saved  operands to push again after the unwind
%   n      operand stack depth to unwind to
%   d      dictionary stack depth to unwind to
%   k      how many results the warp must leave
%   type   the type name the single result must have, or null
% A warp's own unbalanced gsave is not undone: PostScript cannot query the
% gsave depth, so a warp that opens a gsave and then fails leaves one level.

% ( ... A -- ... A ): pop the operand stack back to A's depth (leaving A on
% top) and close the dictionaries above A's depth. Names used here are all
% bound: a warp's open dictionary can shadow any name a warp may define.
% @internal
/wp--rewind {
  countdictstack 1 index 2 get sub 0 max { end } repeat
  count 1 sub 1 index 1 get sub 0 max { exch pop } repeat
} bind def

% ( results A -- results ): raise wp-warp-must-return-one-result unless
% the warp left exactly k results, of the right type if A names one.
% @internal
/wp--shape {
  count 1 sub 1 index 1 get sub 1 index 3 get ne
    { //true }
    { dup 4 get dup null eq { pop //false } { 2 index type ne } ifelse }
  ifelse
  { pop wp-warp-must-return-one-result } { pop } ifelse
} bind def

% ( ... failed A -- ... ): after the warp ran. On an error, unwind, push
% the saved operands, undo the gsave and re-raise. Otherwise the results
% are all that is left of the warp: undo the gsave.
% @internal
/wp--settle {
  exch { //wp--rewind exec 0 get aload pop grestore stop } { pop grestore } ifelse
} bind def

% ( A body -- results ): run body inside a gsave, as described above.
% @internal
/wp--protect {
  gsave
  [ [ 2 index //systemdict /exec get 5 index //wp--shape //systemdict /exec get ] cvx
    //systemdict /stopped get 4 index //wp--settle //systemdict /exec get ] cvx
  3 1 roll pop pop exec
} bind def

% ( saved region -- result ): run region, which takes the array saved on
% the operand stack and leaves one array, inside the guard. The user's warp
% runs in there, so a warp that fails cannot leave its operands, its
% graphics state or the decorator's own half-built path behind: the
% operands in saved are pushed again (the operands the operator was called
% with, as a failing real operator leaves them) and the error is re-raised.
% On success the result is all that is left, and the caller rebuilds the
% path from it.
% @internal
/wp--try {
  [ 2 index 2 index //systemdict /exec get ] cvx exch pop
  exch count 2 sub countdictstack 1 /arraytype 5 array astore
  exch //wp--protect exec
} bind def

% ( -- records ): the current path as it stands, curves kept, for
% wp--restore-path. Curves are [/c x1 y1 x2 y2 x3 y3].
% @internal
/wp--save-path {
  [ {/m 3 1 roll 3 array astore} {/l 3 1 roll 3 array astore}
    {/c 7 1 roll 7 array astore} {[/z]} pathforall ]
} bind def

% ( records -- ): replace the current path with wp--save-path records.
% @internal
/wp--restore-path {
  newpath
  { dup 0 get
    dup /m eq { pop aload pop 3 -1 roll pop moveto } {
    dup /l eq { pop aload pop 3 -1 roll pop lineto } {
    /c eq { aload pop 7 -1 roll pop curveto } { pop closepath } ifelse
    } ifelse } ifelse
  } forall
} bind def

% ( x y w h -- ): a rectangle as a closed path, for the rect operators.
% @internal
/wp--rect {
  4 2 roll moveto 1 index 0 rlineto 0 exch rlineto neg 0 rlineto closepath
} bind def

% ---- Text: the show family, glyph by glyph ----
% The decorated show operators draw glyph outlines with charpath. Those
% with per-glyph spacing cut their string into glyphs as the interpreter
% does: one byte per glyph, or one UTF-8 sequence per glyph in a
% Unicode-mode font. charpath traces no Type 3 glyph, so Type 3 text is
% shown by the real operator; its glyph procedures paint with the
% decorated fill and so bend too. Bad operands, or no current point, also
% go to the real operator, which raises the error it always raises.

% ( -- bool ): whether the current font reads strings as UTF-8. A Type 3
% font says so with /UnicodeBuildChar; any other font is probed by
% counting, on the null device, the glyphs the real kshow finds in a
% two-byte UTF-8 sequence. Only fonts without a glyph procedure are
% probed, so the probe runs no program code.
% @internal
/wp--unicode-font {
  currentfont dup /BuildChar known 1 index /BuildGlyph known or
    { dup /UnicodeBuildChar known { /UnicodeBuildChar get //true eq } { pop //false } ifelse }
    { pop gsave nulldevice 0 0 moveto 0 { pop pop 1 add } (\303\251) kshow grestore 0 eq }
  ifelse
} bind def

% ( string -- bool ): wp--unicode-font, asked only when the string has a
% byte the two readings would cut differently.
% @internal
/wp--unicode-text {
  //false exch { 128 ge or } forall { //wp--unicode-font exec } { //false } ifelse
} bind def

% ( string pos n lo hi -- len ): how many bytes from pos, at most n, form
% one UTF-8 sequence whose second byte lies in lo..hi and whose later
% bytes are continuation bytes. A sequence cut short is its longest valid
% prefix, which shows as one U+FFFD (Unicode's "maximal subpart").
% @internal
/wp--utf8-run {
  6 dict begin
  /hi exch def /lo exch def /n exch def /pos exch def /s exch cvlit def /k 1 def
  { k n ge { exit } if
    pos k add s length ge { exit } if
    s pos k add get dup lo ge exch hi le and not { exit } if
    /k k 1 add def /lo 16#80 def /hi 16#BF def
  } loop
  k end
} bind def

% ( string pos unicode -- len ): the byte length of the glyph at pos. The
% second-byte ranges are Unicode's table of well-formed UTF-8 (3-7).
% @internal
/wp--glyph-len {
  { 2 copy get
    dup 16#C2 lt 1 index 16#F4 gt or
      { pop pop pop 1 }
      { dup 16#E0 lt { pop 2 16#80 16#BF } {
        dup 16#E0 eq { pop 3 16#A0 16#BF } {
        dup 16#ED eq { pop 3 16#80 16#9F } {
        dup 16#F0 lt { pop 3 16#80 16#BF } {
        dup 16#F0 eq { pop 4 16#90 16#BF } {
        16#F4 eq { 4 16#80 16#8F } { 4 16#80 16#BF } ifelse
        } ifelse } ifelse } ifelse } ifelse } ifelse
        //wp--utf8-run exec }
    ifelse }
  { pop pop 1 } ifelse
} bind def

% ( piece unicode -- code ): the character code the show operators give a
% glyph's bytes: the byte, the decoded UTF-8 scalar, or U+FFFD for an
% ill-formed sequence.
% @internal
/wp--code {
  { dup 0 get dup 16#80 lt { exch pop } {
      dup 16#C2 lt 1 index 16#F4 gt or { pop pop 16#FFFD } {
        dup 16#E0 lt { 2 16#1F } { dup 16#F0 lt { 3 16#0F } { 4 16#07 } ifelse } ifelse
        3 index length 3 -1 roll ne { pop pop pop 16#FFFD } {
          and exch 1 1 index length 1 sub getinterval
          { 16#3F and exch 64 mul add } forall
        } ifelse
      } ifelse } ifelse }
  { 0 get } ifelse
} bind def

% ( string -- [pieces] unicode ): a string cut into one substring per glyph.
% @internal
/wp--pieces {
  dup //wp--unicode-text exec
  2 dict begin /u exch def /s exch cvlit def
  [ 0 { dup s length ge { pop exit } if
        s 1 index u //wp--glyph-len exec
        s 2 index 2 index getinterval 3 1 roll add } loop ]
  u end
} bind def

% ( -- bool ): whether the current point exists, without raising an error.
% @internal
/wp--has-point { { currentpoint } stopped { //false } { pop pop //true } ifelse } bind def

% ( -- bool ): whether there is a current font with outlines that charpath
% can read: not a Type 3 font, whose glyphs charpath does not trace.
% @internal
/wp--outline-font {
  { currentfont } stopped { //false }
    { dup /BuildChar known exch /BuildGlyph known or not } ifelse
} bind def

% ( args prefix fillp ok name -- args prefix fillp true | false ): when ok
% is false, drop the decorator's own operands and run the real operator
% named name on the program's. It then raises the error it would raise
% without the warp, with the operand stack it would leave, or, for text in
% a Type 3 font, draws it, with the glyph procedure's painting going
% through the decorated operators.
% @internal
/wp--or-real {
  exch { pop //true } { 3 1 roll pop pop //systemdict exch get exec //false } ifelse
} bind def

% ( args n proc -- x y ): run proc on the n operands args inside the guard.
% proc builds glyph outlines, warps and fills them, and leaves the end
% point. If it fails (a warp that errors, or leaves other than the end point),
% the graphics state, the path, the operand stack down to what was below
% args, and the dictionary stack are put back before the error is
% re-raised. The operands in args are not given back: the show family
% drops them.
% @internal
/wp--guarded {
  exch dup count 3 sub exch sub exch pop
  [] exch countdictstack 2 null 5 array astore
  exch [ exch //systemdict /exec get ] cvx
  //wp--protect exec
} bind def

% ( piece prefix fillp -- ): one string's outlines filled through the
% warp: the current path is kept and only the current point advances.
% fillp is a procedure that fills.
% @internal
/wp--paint {
  currentpoint 5 {
    newpath moveto 3 -1 roll //true charpath
    currentpoint 4 2 roll exch exec exec
  } //wp--guarded exec moveto
} bind def

% ( any -- bool )
% @internal
/wp--number { type dup /integertype eq exch /realtype eq or } bind def

% ( n -- bool ): whether the stack holds n program operands below the
% decorator's prefix and fillp.
% @internal
/wp--operands { count 1 sub 2 sub le } bind def

% ( ok -- bool ): ok, and a current point and an outline font to draw with.
% @internal
/wp--drawable {
  //wp--has-point exec and //wp--outline-font exec and
} bind def

% ( string prefix fillp -- ): show through the warp.
% @internal
/wp--show {
  1 //wp--operands exec { 2 index type /stringtype eq } { //false } ifelse
  //wp--drawable exec
  /show //wp--or-real exec { //wp--paint exec } if
} bind def

% ( cx cy char ax ay string prefix fillp -- ): awidthshow through the warp,
% once its operands are known to be good. The glyphs go into one path,
% each followed by its extra advance, and are filled once. No dictionary
% of ours is open while charpath or the warp runs.
% @internal
/wp--awidth-path {
  8 dict begin
  /fillp exch def /prefix exch def /s exch cvlit def
  /ay exch def /ax exch def /ch exch def /cy exch def /cx exch def
  s //wp--pieces exec /u exch def
  [ exch { dup u //wp--code exec ch eq { ax cx add ay cy add } { ax ay } ifelse
           3 array astore } forall ]
  /prefix load /fillp load
  end
  currentpoint 5 {
    newpath moveto 3 -1 roll
    { aload pop 3 -1 roll //true charpath rmoveto } forall
    currentpoint 4 2 roll exch exec exec
  } //wp--guarded exec moveto
} bind def

% ( ax ay string prefix fillp -- ): ashow through the warp.
% @internal
/wp--ashow {
  3 //wp--operands exec {
    2 index type /stringtype eq
    4 index //wp--number exec and 5 index //wp--number exec and
  } { //false } ifelse
  //wp--drawable exec
  /ashow //wp--or-real exec { 0 0 0 8 3 roll //wp--awidth-path exec } if
} bind def

% ( cx cy char string prefix fillp -- ): widthshow through the warp.
% @internal
/wp--widthshow {
  4 //wp--operands exec {
    2 index type /stringtype eq
    4 index type /integertype eq and
    { 3 index dup 0 ge exch 255 le and } { //false } ifelse
    5 index //wp--number exec and 6 index //wp--number exec and
  } { //false } ifelse
  //wp--drawable exec
  /widthshow //wp--or-real exec { 0 0 5 2 roll //wp--awidth-path exec } if
} bind def

% ( cx cy char ax ay string prefix fillp -- ): awidthshow through the warp.
% @internal
/wp--awidthshow {
  6 //wp--operands exec {
    2 index type /stringtype eq
    4 index //wp--number exec and 5 index //wp--number exec and
    6 index type /integertype eq and
    { 5 index dup 0 ge exch 255 le and } { //false } ifelse
    7 index //wp--number exec and 8 index //wp--number exec and
  } { //false } ifelse
  //wp--drawable exec
  /awidthshow //wp--or-real exec { //wp--awidth-path exec } if
} bind def

% kshow keeps its state in a dictionary S: the procedure, the text, the
% byte position, the warp prefix and fill, the code of the glyph just
% shown, and whether the text is done. The loop's body holds S itself, so
% nothing of ours is on the operand or dictionary stack while the
% procedure runs, or when a glyph fails: the procedure sees what the real
% kshow shows it.

% ( S -- piece prefix fillp ): cut the next glyph against the font live
% now (a call of the procedure may have changed it).
% @internal
/wp--kshow-glyph {
  dup /s get 1 index /pos get get 128 ge { //wp--unicode-font exec } { //false } ifelse
  exch begin
    /u exch def
    s pos u //wp--glyph-len exec
    s pos 2 index getinterval
    /pos pos 4 -1 roll add def
    /code 1 index u //wp--code exec def
    /prefix load /fillp load
  end
} bind def

% ( piece prefix fillp -- ): draw one kshow glyph, deciding per glyph,
% since the procedure may change the font: an outline glyph through the
% warp, a Type 3 one by the real show, whose glyph procedure then paints
% through the decorated operators.
% @internal
/wp--kshow-paint {
  //wp--has-point exec not { pop pop pop /kshow errordict /nocurrentpoint get exec } if
  //wp--outline-font exec { //wp--paint exec } { pop pop //systemdict /show get exec } ifelse
} bind def

% ( S -- code1 code2 proc true | false ): if text remains, the codes of
% the glyph just shown and of the next one, and the procedure to call.
% @internal
/wp--kshow-next {
  dup /pos get 1 index /s get length ge
    { /done //true put //false }
    { dup /s get 1 index /pos get get 128 ge { //wp--unicode-font exec } { //false } ifelse
      exch begin
        s pos 2 index //wp--glyph-len exec
        s pos 3 -1 roll getinterval exch //wp--code exec
        code exch /proc load //true
      end }
  ifelse
} bind def

% ( code1 code2 proc true | false -- ): call the procedure, or end the loop.
% @internal
/wp--kshow-call { { exec } { exit } ifelse } bind def

% ( S -- ): an exit from the procedure left the text unfinished; the real
% kshow refuses such an exit.
% @internal
/wp--kshow-done {
  /done get not { /kshow errordict /invalidexit get exec } if
} bind def

% ( proc string prefix fillp -- ): kshow through the warp. A Type 3 font
% does not send the whole kshow to the real operator: the procedure may
% switch fonts, so the choice is made glyph by glyph.
% @internal
/wp--kshow {
  2 //wp--operands exec {
    3 index dup type /arraytype eq exch xcheck and 3 index type /stringtype eq and
  } { //false } ifelse
  //wp--has-point exec and
  /kshow //wp--or-real exec {
    2 index length 0 eq { pop pop pop pop } {
      8 dict begin
      /fillp exch def /prefix exch def /s exch cvlit def /proc exch def
      /pos 0 def /code 0 def /done //false def
      currentdict end
      dup dup
      [ exch //wp--kshow-glyph //systemdict /exec get //wp--kshow-paint //systemdict /exec get
        7 -1 roll //wp--kshow-next //systemdict /exec get
        //wp--kshow-call //systemdict /exec get ] cvx
      [ exch //systemdict /loop get 4 -1 roll //wp--kshow-done //systemdict /exec get ] cvx
      exec
    } ifelse
  } if
} bind def

% ( name prefix fillp -- ): glyphshow through the warp: charpath of code 0
% in a copy of the font whose Encoding maps 0 to the name. The copy is set
% inside the gsave, so the caller's font is current again afterwards. A
% Unicode-mode font reads codes, not its Encoding, so there, as for a
% Type 3 font, the real glyphshow draws the glyph.
% @internal
/wp--glyphshow {
  1 //wp--operands exec { 2 index type /nametype eq } { //false } ifelse
  //wp--drawable exec
  dup { //wp--unicode-font exec not and } if
  /glyphshow //wp--or-real exec {
    currentpoint 5 {
      newpath moveto 3 -1 roll currentfont dup length dict copy
      dup /Encoding 256 array dup 0 7 -1 roll put put setfont
      (\000) //true charpath
      currentpoint 4 2 roll exch exec exec
    } //wp--guarded exec moveto
  } if
} bind def

% ---- xshow, yshow and xyshow: glyphs placed by the program ----
% These draw each glyph, then move the pen by the next displacement given
% in user space (dx for xshow, dy for yshow, dx dy for xyshow) instead of by
% the glyph's width. The decorators cut the text as the show family does,
% charpath each glyph where the program puts it, and fill the outlines
% through the warp. The displacements are user-space numbers, so the warp
% bends where the glyphs land, as it bends everything else, and the
% displacements themselves are not warped.
%
% The program's arguments are checked by the real operator, not here: a
% dry run on the null device, from a made-up current point, says whether
% the operator would accept the operands, the glyph count and every
% displacement. Anything it refuses goes to the real operator, which then
% raises the error it always raises, in its own order, with the operand
% stack it leaves. Type 3 text is shown by the real operator too, as for the
% rest of the show family. cshow paints nothing itself (its procedure's own
% show calls go through the decorated operators), so it needs no decorator.

% ( ... bool depth -- bool ): after a dry run: pop whatever the real
% operator left beneath its result, back to depth items. pscat's operators
% drop their operands on an error (#1198); gs's leave them, and a pscat that
% did the same would leave the two copies here.
% @internal
/wp--dry-settle {
  count 2 sub exch sub 0 max { exch pop } repeat
} bind def

% ( string nums prefix fillp ok name -- string nums prefix fillp ok ): when
% ok, run the real operator name on the program's string and displacements
% on the null device; ok stays true only if it raised no error. The copies
% are held by the executable array that runs the operator, and the stack is
% put back to its depth by count, whatever the operator leaves. No `[`
% is executed here: pscat names the last name it ran as the offending
% command of a routed error, which must stay the operator the program called.
% @internal
/wp--dry-run {
  exch {
    //systemdict exch get count 1 sub
    5 index cvlit 5 index cvlit 3 index 3 array astore cvx
    exch //systemdict /stopped get exch
    //wp--dry-settle //systemdict /exec get 5 array astore cvx
    exch pop
    gsave nulldevice 0 0 moveto exec grestore not
  } { pop //false } ifelse
} bind def

% ( pieces nums axes -- deltas ): [dx dy] for each glyph from a numarray:
% axes 0 for xshow (dx), 1 for yshow (dy), 2 for xyshow (dx dy).
% @internal
/wp--array-deltas {
  4 dict begin /axes exch def /nums exch cvlit def /k 0 def
  [ exch { pop
      axes 0 eq { nums k get 0 /k k 1 add def } {
      axes 1 eq { 0 nums k get /k k 1 add def } {
        nums k get nums k 1 add get /k k 2 add def } ifelse } ifelse
      2 array astore
  } forall ]
  end
} bind def

% ( numstring -- numarray ): an encoded number string as the array of
% numbers it holds, by scanning it as the binary token it is (token type
% 149, PLRM 3.14.2). The real operator has accepted the string already; with
% the object format at 0 the scanner would read it as text, so that is set
% to 1 for the scan and put back, whether or not the scan raises an error.
% @internal
/wp--numbers {
  currentobjectformat 0 eq
    { 1 setobjectformat { token } stopped 0 setobjectformat { stop } if
      pop exch pop }
    { token pop exch pop } ifelse
} bind def

% ( string nums prefix fillp axes -- ): the glyphs of string, drawn
% through the warp where the displacements in nums put them. Each glyph
% starts where the last one's displacement left the pen; the path of all of
% them is filled once, and the current point ends where the real operator
% would leave it. The path in force is kept. No dictionary of ours is open
% while charpath or the warp runs.
% @internal
/wp--positioned {
  8 dict begin
  /axes exch def /fillp exch def /prefix exch def
  /nums exch cvlit def /s exch cvlit def
  s //wp--pieces exec pop /pieces exch def
  nums type /stringtype eq { nums //wp--numbers exec /nums exch def } if
  pieces nums axes //wp--array-deltas exec /deltas exch def
  [ 0 1 pieces length 1 sub {
      dup pieces exch get exch deltas exch get aload pop 3 array astore
  } for ]
  /prefix load /fillp load
  end
  currentpoint 5 {
    newpath moveto 3 -1 roll
    { aload pop currentpoint 3 -1 roll add 3 1 roll add exch
      3 -1 roll //true charpath moveto } forall
    currentpoint 4 2 roll exch exec exec
  } //wp--guarded exec moveto
} bind def

% ( string nums prefix fillp -- ): xshow through the warp.
% @internal
/wp--xshow {
  2 //wp--operands exec //wp--drawable exec /xshow //wp--dry-run exec
  /xshow //wp--or-real exec { 0 //wp--positioned exec } if
} bind def

% ( string nums prefix fillp -- ): yshow through the warp.
% @internal
/wp--yshow {
  2 //wp--operands exec //wp--drawable exec /yshow //wp--dry-run exec
  /yshow //wp--or-real exec { 1 //wp--positioned exec } if
} bind def

% ( string nums prefix fillp -- ): xyshow through the warp.
% @internal
/wp--xyshow {
  2 //wp--operands exec //wp--drawable exec /xyshow //wp--dry-run exec
  /xyshow //wp--or-real exec { 2 //wp--positioned exec } if
} bind def

% ( -- bool ): whether the stack ends in the four numbers x y w h. The
% rect decorators warp only that call; anything else (too few operands, a
% wrong type, the numarray form) goes to the real operator, which raises its
% own error with the stack it leaves, or draws the array form unwarped. No
% name is executed on the way (//false, not false): pscat reports the last
% name executed as the offending command, which must stay the rect operator.
% @internal
/wp--rect-ok {
  count 4 ge {
    3 index //wp--number exec 3 index //wp--number exec and
    2 index //wp--number exec and 1 index //wp--number exec and
  } { //false } ifelse
} bind def

% ( transform step -- decorators ), transform: ( records -- records ).
% Each decorator ( target -- wrapper ) turns an operator into one that
% paints the transformed path. Strokes are outlined
% first with strokepath, so line weight and dashes bend with the shape;
% text is drawn as glyph outlines (Type 3 text by the real operator,
% whose glyph procedures paint through the decorated fill). Images and smooth shadings pass through
% unwarped; the array forms of rectfill, rectstroke and rectclip are not
% supported.
% @kind: Procedure
% @summary: Build decorators that make fill, stroke, clip and the show operators draw through a path transform.
% @example: {} 4 wp-decorators
/wp-decorators {
  matrix currentmatrix dup //wp--apply /exec load 3 array astore cvx
  4 1 roll //wp--compute /exec load 5 array astore cvx
  % apply: { records -- } rebuilds the path; warp: { -- records } warps it
  24 dict begin /warp exch def /apply exch def /realfill //systemdict /fill get def
  % Each wrapper warps the path inside wp--try, which takes an array of
  % the operands to give back if the warp fails and a region that consumes
  % it and leaves the warped records; then it rebuilds the path from them.
  /region [ /pop load /warp load /exec load ] cvx def
  % operators that consume or clip the current path keep their own target
  /first [ [] /region load //wp--try /exec load /apply load /exec load ] cvx def
  [ /fill /eofill ] {
    [ /first load /exch load //fp-compose /exec load ] cvx def
  } forall
  % clip and eoclip keep the current path: clip to the warped copy, then
  % put the original back so later painting warps it only once
  % the warp runs in a guard of its own, so its result is checked on its
  % own, before the saved path joins it
  /clipregion [ /pop load //wp--save-path /exec load
                [] /region load //wp--try /exec load
                2 /array load /astore load ] cvx def
  /clipfirst [ [] /clipregion load //wp--try /exec load /aload load /pop load
               /apply load /exec load ] cvx def
  [ /clip /eoclip ] {
    [ /clipfirst load /exch load //fp-compose /exec load
      //wp--restore-path //fp-compose /exec load ] cvx def
  } forall
  /strokeregion [ /pop load /strokepath load /warp load /exec load ] cvx def
  /stroke [ /pop load
    [ [] /strokeregion load //wp--try /exec load /apply load /exec load
      /realfill load ] cvx ] cvx def
  % the rect operators take x y w h, which they keep if the warp fails;
  % the real rectfill and rectstroke leave the current path alone
  /rectregion [ /aload load /pop load /newpath load //wp--rect /exec load
                /warp load /exec load ] cvx def
  /rectfill [ /pop load
    [ //wp--rect-ok /exec load
      [ 4 /array load /astore load /rectregion load //wp--try /exec load
        /gsave load /apply load /exec load /realfill load /grestore load ] cvx
      [ //systemdict /rectfill get ] cvx /ifelse load ] cvx ] cvx def
  /rectstrokeregion [ /aload load /pop load /newpath load //wp--rect /exec load
                      /strokepath load /warp load /exec load ] cvx def
  /rectstroke [ /pop load
    [ //wp--rect-ok /exec load
      [ 4 /array load /astore load /rectstrokeregion load //wp--try /exec load
        /gsave load /apply load /exec load /realfill load /grestore load ] cvx
      [ //systemdict /rectstroke get ] cvx /ifelse load ] cvx ] cvx def
  % rectclip: like clip, but it starts from a fresh path and leaves none
  /rectclip [ /pop load
    [ //wp--rect-ok /exec load
      [ 4 /array load /astore load /rectregion load //wp--try /exec load
        /apply load /exec load //systemdict /clip get /newpath load ] cvx
      [ //systemdict /rectclip get ] cvx /ifelse load ] cvx ] cvx def
  % the show family: glyph outlines filled through the warp. As with the
  % real operators, the current path is kept and only the current point
  % advances. Each wrapper hands its operands, the prefix and a fill to
  % a helper, which falls back to the real operator for an error or a
  % Type 3 font.
  % prefix: the show family's warp-and-rebuild, which then puts the
  % caller's CTM back, as the fill that follows it saw it before
  /prefix [ /matrix load /currentmatrix load /warp load /exec load
            /apply load /exec load /setmatrix load ] cvx def
  /fillp [ /realfill load ] cvx def
  [ [ /show //wp--show ] [ /ashow //wp--ashow ] [ /widthshow //wp--widthshow ]
    [ /awidthshow //wp--awidthshow ] [ /kshow //wp--kshow ]
    [ /glyphshow //wp--glyphshow ] [ /xshow //wp--xshow ] [ /yshow //wp--yshow ]
    [ /xyshow //wp--xyshow ] ] {
    aload pop
    [ /pop load [ /prefix load /fillp load 6 -1 roll /exec load ] cvx ] cvx def
  } forall
  [ /prefix /warp /apply /region /first /clipregion /clipfirst /strokeregion /rectregion
    /rectstrokeregion /realfill /fillp ] { currentdict exch undef } forall
  currentdict end
} bind def

% ( stopped depth -- ): close the dictionaries a program left open down to
% depth, then re-raise its error, if any.
% @internal
/wp--unwind {
  countdictstack exch sub 0 max { end } repeat { stop } if
} bind def

% ( decorators -- ): open the scope dictionary and install the decorators
% and the page-operator stubs in it. Bound, so a decorated def or forall
% cannot change how it installs the rest.
% @internal
/wp--install {
  64 dict begin
  { //aop-wrap-def exec } forall
  /showpage {} def /copypage {} def /erasepage {} def
} bind def

% ( program -- ): run a file name, or execute a procedure.
% @internal
/wp--runprog { dup type /stringtype eq { run } { exec } ifelse } bind def

% Decorators are ( target -- wrapper ) quotations keyed by operator name,
% installed with aop-wrap-def in a fresh scope dictionary before the
% program is read, so even procedures the program binds see them.
% showpage, copypage and erasepage do nothing inside the scope. The
% program is a file name, or a procedure to execute in the same scope.
% @kind: Procedure
% @summary: Run a PostScript file or procedure with operator decorators installed for its whole run.
% @example: (gallery/golden_bloom.ps) << /fill {} >> wp-run-decorated
/wp-run-decorated {
  dup type /dicttype ne { wp-decorators-must-be-dictionary } if
  countdictstack 3 1 roll                           % depth program decorators
  % One protected procedure installs the decorators and then runs the
  % program, so a decorator that fails to install still has its scope
  % closed. The depth goes into the procedure that unwinds, not under the
  % program on the operand stack, so the program can take operands from
  % its caller and leave results. exec and stopped come straight from
  % systemdict: a decorated exec or stopped in the scope cannot stop the
  % program from running or the scope from closing.
  //wp--install //systemdict /exec get 4 -1 roll      % depth decorators install exec program
  //wp--runprog //systemdict /exec get 6 array astore cvx
  //systemdict /stopped get 3 -1 roll
  //wp--unwind //systemdict /exec get 5 array astore cvx exec
} bind def

% @kind: Procedure
% @summary: Run a PostScript file so everything it paints passes through a path transform.
% @example: (gallery/golden_bloom.ps) 350 350 1 wp-unroll 3 wp-run-path
/wp-run-path { //wp-decorators exec //wp-run-decorated exec } bind def

% @kind: Procedure
% @summary: Run a PostScript file so everything it paints is bent by a point warp.
% @example: (gallery/golden_bloom.ps) 350 350 300 0.4 wp-lens 3 wp-run
/wp-run { exch //wp-points exec exch //wp-run-path exec } bind def
