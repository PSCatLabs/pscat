%!PS-Adobe-3.0
% Native QR Model 2 library -- incremental implementation.
% Byte-mode planning, packing, error correction and fixed-mask matrix
% construction; no format/version BCH bits, mask selection or rendering yet.
% Load with (lib/qr.ps) run. No dependencies and no drawing on load.
% Code: MIT OR Apache-2.0, as the other lib/*.ps libraries.
%
% qr--byte-data: readable-string version data-capacity -> fresh-string
% Internal seam: capacity is supplied by the future version/ECC planner.
% It is NOT checked against a version/ECC table here. Version is 1..40;
% capacity is a positive integer <=2956 (the largest Model 2 data area).
% Input is raw bytes; no Unicode conversion, ECI or mode optimization.
%
% Validate before begin: named failures must leave no private dictionary open.
%%SelfTest: qr-byte-data-invalid-arguments
% { () 1 19.0 qr--byte-data } /qr-data-capacity-must-be-integer (real capacity) mustguard
% { () 1 0 qr--byte-data } /qr-data-capacity-must-be-in-1-2956 (zero capacity) mustguard
% { () 1 2957 qr--byte-data } /qr-data-capacity-must-be-in-1-2956 (large capacity) mustguard
% { () 1.0 19 qr--byte-data } /qr-data-version-must-be-integer (real version) mustguard
% { () 0 19 qr--byte-data } /qr-data-version-must-be-in-1-40 (zero version) mustguard
% { () 41 19 qr--byte-data } /qr-data-version-must-be-in-1-40 (large version) mustguard
% { [] 1 19 qr--byte-data } /qr-data-must-be-a-string (array payload) mustguard
% { 256 string 9 300 qr--byte-data } /qr-data-count-does-not-fit-version (8-bit count overflow) mustguard
% { (AB) 1 3 qr--byte-data } /qr-data-does-not-fit-capacity (payload overflow) mustguard
%%EndSelfTest
%%SelfTest: qr-byte-data-packing
% () 1 2 qr--byte-data <4000> eq (empty byte segment) mustbe
% (A) 1 3 qr--byte-data <401410> eq (exact fit and terminator) mustbe
% () 1 5 qr--byte-data <4000ec11ec> eq (alternating pad bytes) mustbe
% <00ff> 10 5 qr--byte-data <4000200ff0> eq (16-bit count and raw bytes) mustbe
% () cvx 1 2 qr--byte-data <4000> eq (executable empty string is data) mustbe
% (pop) cvx 1 5 qr--byte-data <403706f700> eq (executable program is data) mustbe
%%EndSelfTest
% @internal
/qr--byte-data {
  dup type /integertype ne { qr-data-capacity-must-be-integer } if
  dup 1 lt 1 index 2956 gt or { qr-data-capacity-must-be-in-1-2956 } if
  1 index type /integertype ne { qr-data-version-must-be-integer } if
  1 index dup 1 lt exch 40 gt or { qr-data-version-must-be-in-1-40 } if
  2 index type /stringtype ne { qr-data-must-be-a-string } if
  2 index rcheck not { qr-data-must-be-readable } if
  1 index 10 lt {
    2 index length 255 gt { qr-data-count-does-not-fit-version } if
  } if
  2 index length 2 index 10 lt { 2 } { 3 } ifelse add
  1 index gt { qr-data-does-not-fit-capacity } if

  12 dict begin
    /capacity exch def /version exch def /data exch cvlit def
    /out capacity string def /n data length def
    /header version 10 lt { 2 } { 3 } ifelse def
    % Mode 0100 plus an 8/16-bit count leaves the stream nibble-aligned.
    header 2 eq {
      out 0 64 n -4 bitshift or put
      out 1 n 15 and 4 bitshift put
    } {
      out 0 64 n -12 bitshift or put
      out 1 n -4 bitshift 255 and put
      out 2 n 15 and 4 bitshift put
    } ifelse
    0 1 n 1 sub {
      /i exch def /b data i get def /at header 1 sub i add def
      out at out at get b -4 bitshift or put
      out at 1 add b 15 and 4 bitshift put
    } for
    % Four zero terminator bits complete alignment for one byte segment.
    % The low nibble is already zero; this also completes byte alignment.
    /used n header add def
    used 1 capacity 1 sub {
      /i exch def
      out i i used sub 2 mod 0 eq { 236 } { 17 } ifelse put
    } for
    out
  end
} bind def

% Build finite-field lookup tables once, using QR's polynomial x^8+x^4+x^3+x^2+1.
% Table construction is pure PostScript; no interpreter extension is involved.
% @internal
/qr--make-gf {
  5 dict begin
    /exps 512 string def /logs 256 string def /x 1 def
    0 1 254 {
      /i exch def exps i x put logs x i put
      /x x 1 bitshift dup 256 and 0 ne { 285 xor } if def
    } for
    255 1 511 { /i exch def exps i exps i 255 sub get put } for
    [exps readonly logs readonly] readonly
  end
} bind def
% @internal
/qr--gf qr--make-gf def

% Trusted internal byte operands, obtained from strings. Zero has no logarithm.
% @internal
/qr--gf-mul {
  2 copy 0 eq exch 0 eq or { pop pop 0 } {
    qr--gf 1 get exch get
    exch qr--gf 1 get exch get add
    qr--gf 0 get exch get
  } ifelse
} bind def

% qr--rs-divisor: degree -> fresh coefficient string (leading monic term omitted).
%%SelfTest: qr-rs-divisor-guards
% { 7.0 qr--rs-divisor } /qr-ecc-degree-must-be-integer (real degree) mustguard
% { 0 qr--rs-divisor } /qr-ecc-degree-must-be-in-1-30 (zero degree) mustguard
% { 31 qr--rs-divisor } /qr-ecc-degree-must-be-in-1-30 (large degree) mustguard
% 1 qr--rs-divisor <01> eq (degree-one polynomial) mustbe
% 2 128 qr--gf-mul 29 eq (QR polynomial, not AES polynomial) mustbe
%%EndSelfTest
% @internal
/qr--rs-divisor {
  dup type /integertype ne { qr-ecc-degree-must-be-integer } if
  dup 1 lt 1 index 30 gt or { qr-ecc-degree-must-be-in-1-30 } if
  6 dict begin
    /degree exch def /result degree string def
    result degree 1 sub 1 put /root 1 def
    degree {
      0 1 degree 1 sub {
        /j exch def /value result j get root qr--gf-mul def
        j degree 1 sub lt { /value value result j 1 add get xor def } if
        result j value put
      } for
      /root root 2 qr--gf-mul def
    } repeat
    result
  end
} bind def

% qr--rs-remainder: readable-data readable-divisor -> fresh parity string.
%%SelfTest: qr-rs-remainder-guards
% { () [] qr--rs-remainder } /qr-ecc-divisor-must-be-a-string (array divisor) mustguard
% { () () qr--rs-remainder } /qr-ecc-divisor-length-must-be-in-1-30 (empty divisor) mustguard
% { [] <01> qr--rs-remainder } /qr-data-must-be-a-string (array data) mustguard
% { 2957 string <01> qr--rs-remainder } /qr-ecc-data-too-long (long data) mustguard
% <010203> <01> qr--rs-remainder <00> eq (degree-one parity) mustbe
% () cvx <01> cvx qr--rs-remainder <00> eq (executable strings stay data) mustbe
%%EndSelfTest
% @internal
/qr--rs-remainder {
  dup type /stringtype ne { qr-ecc-divisor-must-be-a-string } if
  dup rcheck not { qr-ecc-divisor-must-be-readable } if
  dup length dup 1 lt exch 30 gt or { qr-ecc-divisor-length-must-be-in-1-30 } if
  1 index type /stringtype ne { qr-data-must-be-a-string } if
  1 index rcheck not { qr-data-must-be-readable } if
  1 index length 2956 gt { qr-ecc-data-too-long } if
  7 dict begin
    /divisor exch cvlit def /data exch cvlit def
    /degree divisor length def /result degree string def
    data {
      /factor exch result 0 get xor def
      result 0 result 1 degree 1 sub getinterval putinterval
      result degree 1 sub 0 put
      0 1 degree 1 sub {
        /j exch def
        result j result j get divisor j get factor qr--gf-mul xor put
      } for
    } forall
    result
  end
} bind def

% Model 2 block-layout facts (versions 1..40); independently checked against
% pinned reference fixtures. Keep only correction/block counts, deriving data
% capacity from symbol geometry so the planner and future interleaver agree.
% @internal
/qr--ecc-per-block <<
  /L [7 10 15 20 26 18 20 24 30 18 20 24 26 30 22 24 28 30 28 28
      28 28 30 30 26 28 30 30 30 30 30 30 30 30 30 30 30 30 30 30] readonly
  /M [10 16 26 18 24 16 18 22 22 26 30 22 22 24 24 28 28 26 26 26
      26 28 28 28 28 28 28 28 28 28 28 28 28 28 28 28 28 28 28 28] readonly
  /Q [13 22 18 26 18 24 18 22 20 24 28 26 24 20 30 24 28 28 26 30
      28 30 30 30 30 28 30 30 30 30 30 30 30 30 30 30 30 30 30 30] readonly
  /H [17 28 22 16 22 28 26 26 24 28 24 28 22 24 24 30 28 28 26 28
      30 24 30 30 30 30 30 30 30 30 30 30 30 30 30 30 30 30 30 30] readonly
>> def
qr--ecc-per-block readonly pop
% @internal
/qr--block-count <<
  /L [1 1 1 1 1 2 2 2 2 4 4 4 4 4 6 6 6 6 7 8
      8 9 9 10 12 12 12 13 14 15 16 17 18 19 19 20 21 22 24 25] readonly
  /M [1 1 1 2 2 4 4 4 5 5 5 8 9 9 10 10 11 13 14 16
      17 17 18 20 21 23 25 26 28 29 31 33 35 37 38 40 43 45 47 49] readonly
  /Q [1 1 2 2 4 4 6 6 8 8 8 10 12 16 12 17 16 18 21 20
      23 23 25 27 29 34 34 35 38 40 43 45 48 51 53 56 59 62 65 68] readonly
  /H [1 1 2 4 4 4 5 6 8 8 11 11 16 16 18 16 19 21 25 25
      25 34 30 32 35 37 40 42 45 48 51 54 57 60 63 66 70 74 77 81] readonly
>> def
qr--block-count readonly pop

% Accept executable names as values too, but never execute a stored level.
% @internal
/qr--check-level {
  dup type /nametype ne { qr-level-must-be-L-M-Q-or-H } if
  cvlit
  qr--ecc-per-block 1 index known not { qr-level-must-be-L-M-Q-or-H } if
} bind def

% Trusted integer version 1..40 -> data-area module count, remainder bits
% included. Shared by the layout planner and matrix placement so the two can
% never disagree about how many codeword bits a symbol holds.
% Base layout removes finder/separator/timing/format areas. Alignment
% intersections depend on version; version metadata consumes 36 more bits.
% @internal
/qr--raw-modules {
  dup dup 16 mul 128 add mul 64 add exch
  dup 2 ge {
    dup 7 idiv 2 add dup 25 mul 10 sub mul 55 sub
    3 -1 roll exch sub exch
    7 ge { 36 sub } if
  } { pop } ifelse
} bind def

% qr--block-spec: version level -> fresh-layout-dict
% RawCodewords excludes remainder bits; ECCodewordsPerBlock is per block.
%%SelfTest: qr-block-spec-invalid-arguments
% { 1 /X qr--block-spec } /qr-level-must-be-L-M-Q-or-H (unknown ECC) mustguard
% { 1 (L) qr--block-spec } /qr-level-must-be-L-M-Q-or-H (string ECC) mustguard
% { 1.0 /M qr--block-spec } /qr-version-must-be-integer (real version) mustguard
% { 0 /L qr--block-spec } /qr-version-must-be-in-1-40 (zero version) mustguard
% { 41 /H qr--block-spec } /qr-version-must-be-in-1-40 (large version) mustguard
%%EndSelfTest
% @internal
/qr--block-spec {
  qr--check-level
  1 index type /integertype ne { qr-version-must-be-integer } if
  1 index dup 1 lt exch 40 gt or { qr-version-must-be-in-1-40 } if
  10 dict begin
    /level exch def /version exch def
    /size version 4 mul 17 add def
    /raw version qr--raw-modules def
    /ec qr--ecc-per-block level get version 1 sub get def
    /blocks qr--block-count level get version 1 sub get def
    << /Version version /Level level /Size size
       /RawCodewords raw 8 idiv /RemainderBits raw 8 mod
       /DataCodewords raw 8 idiv ec blocks mul sub
       /ECCodewordsPerBlock ec /Blocks blocks >>
  end
} bind def

% qr--byte-plan: readable-string level -> fresh-layout-dict-with-Data
% Exact requested ECC; select the smallest fitting version, with no boosting.
%%SelfTest: qr-byte-plan-invalid-arguments
% { [] /M qr--byte-plan } /qr-data-must-be-a-string (array payload) mustguard
% { () /low qr--byte-plan } /qr-level-must-be-L-M-Q-or-H (unknown ECC) mustguard
% { 2954 string /L qr--byte-plan } /qr-data-too-long-for-level (largest overflow) mustguard
% { 1274 string /H qr--byte-plan } /qr-data-too-long-for-level (H overflow) mustguard
%%EndSelfTest
%%SelfTest: qr-byte-plan-smallest-version
% () /M qr--byte-plan /Version get 1 eq (empty segment version) mustbe
% (https://github.com/PSCatLabs/pscat) /M qr--byte-plan /Version get 3 eq (GitHub version at M) mustbe
% (A) cvx /L cvx qr--byte-plan /Data get length 19 eq (executable values stay data) mustbe
%%EndSelfTest
% @internal
/qr--byte-plan {
  qr--check-level
  1 index type /stringtype ne { qr-data-must-be-a-string } if
  1 index rcheck not { qr-data-must-be-readable } if
  % Refuse before opening the planner frame, so ordinary caught errors do not
  % retain scratch bindings. The version-40 bound also bounds the search loop.
  1 index length 40 2 index qr--block-spec /DataCodewords get 3 sub gt {
    qr-data-too-long-for-level
  } if
  8 dict begin
    /level exch def /data exch cvlit def /n data length def /version 1 def
    {
      /spec version level qr--block-spec def
      /header version 10 lt { 2 } { 3 } ifelse def
      n header add spec /DataCodewords get le
      n version 10 lt { 255 } { 65535 } ifelse le and {
        spec /Data data version spec /DataCodewords get qr--byte-data put
        spec exit
      } if
      /version version 1 add def
    } loop
  end
} bind def

% qr--interleave: padded-data version level -> fresh full codeword string.
% Padded data must exactly fill the selected layout. Short blocks precede long
% blocks; correction columns follow all data columns. Remainder bits stay out.
%%SelfTest: qr-interleave-guards
% { () 1 /L qr--interleave } /qr-ecc-data-length-must-match-capacity (short data) mustguard
% { [] 1 /M qr--interleave } /qr-data-must-be-a-string (array data) mustguard
% { 19 string 1 /X qr--interleave } /qr-level-must-be-L-M-Q-or-H (unknown ECC) mustguard
% 19 string 1 /L qr--interleave length 26 eq (complete version-one stream) mustbe
%%EndSelfTest
% @internal
/qr--interleave {
  qr--block-spec
  1 index type /stringtype ne { qr-data-must-be-a-string } if
  1 index rcheck not { qr-data-must-be-readable } if
  1 index length 1 index /DataCodewords get ne {
    qr-ecc-data-length-must-match-capacity
  } if
  16 dict begin
    /spec exch def /data exch cvlit def
    /blocks spec /Blocks get def /ec spec /ECCodewordsPerBlock get def
    /short spec /RawCodewords get blocks idiv ec sub def
    /short-count blocks spec /RawCodewords get blocks mod sub def
    /divisor ec qr--rs-divisor def
    /parts blocks array def /parity blocks array def /offset 0 def
    0 1 blocks 1 sub {
      /b exch def /len short b short-count ge { 1 } { 0 } ifelse add def
      parts b data offset len getinterval put
      parity b parts b get divisor qr--rs-remainder put
      /offset offset len add def
    } for
    /out spec /RawCodewords get string def /pos 0 def
    0 1 short {
      /j exch def
      0 1 blocks 1 sub {
        /b exch def
        j parts b get length lt {
          out pos parts b get j get put /pos pos 1 add def
        } if
      } for
    } for
    0 1 ec 1 sub {
      /j exch def
      0 1 blocks 1 sub {
        /b exch def out pos parity b get j get put /pos pos 1 add def
      } for
    } for
    out
  end
} bind def

% ---- Matrix construction (QR-3) ----
%
% Internal matrix: << /Version v /Size s /Cells string /Mask null|0..7 >>.
% /Cells holds s*s bytes, row-major from the top-left module: x is the column,
% y the row, index y*s+x, no quiet zone. Each byte is a set of flags:
%   1 dark, 2 function (never placed or masked), 4 metadata (format/version
%   cells, reserved light here; the BCH stage writes them).
% So data cells are 0/1, fixed patterns 2/3 (the dark module is 3) and
% unwritten metadata 6. Bytes keep a v40 grid at 31 KB and make mask trials
% cheap string copies; the public API converts to booleans.

% Validate before any frame opens, mirroring qr--block-spec's version guards.
% @internal
/qr--check-version {
  dup type /integertype ne { qr-version-must-be-integer } if
  dup dup 1 lt exch 40 gt or { qr-version-must-be-in-1-40 } if
} bind def

% qr--alignment-centers: version -> fresh ascending array of row/column centers.
% Evenly spaced from the far side, step rounded up to even, then 6; this
% reproduces ISO/IEC 18004 Annex E, including version 32's irregular gap.
%%SelfTest: qr-alignment-centers
% 1 qr--alignment-centers length 0 eq (version one has none) mustbe
% 2 qr--alignment-centers aload pop 18 eq exch 6 eq and (version two) mustbe
% 7 qr--alignment-centers aload pop 38 eq exch 22 eq and exch 6 eq and (version seven) mustbe
% 32 qr--alignment-centers 1 get 34 eq (version 32 irregular step) mustbe
% 40 qr--alignment-centers dup length 7 eq exch 6 get 170 eq and (version forty) mustbe
% { 0 qr--alignment-centers } /qr-version-must-be-in-1-40 (zero version) mustguard
% { 2.0 qr--alignment-centers } /qr-version-must-be-integer (real version) mustguard
%%EndSelfTest
% @internal
/qr--alignment-centers {
  qr--check-version
  dup 1 eq { pop [] } {
    6 dict begin
      /version exch def /n version 7 idiv 2 add def
      /size version 4 mul 17 add def
      /step version 8 mul n 3 mul add 5 add n 4 mul 4 sub idiv 2 mul def
      /out n array def out 0 6 put
      1 1 n 1 sub { /i exch def out n i sub size 7 sub i 1 sub step mul sub put } for
      out
    end
  } ifelse
} bind def

% qr--function-matrix: version -> fresh unmasked matrix with every function
% module and metadata reservation set and all data cells light (0).
%%SelfTest: qr-function-matrix
% 1 qr--function-matrix /Cells get length 441 eq (version one grid) mustbe
% 1 qr--function-matrix /Cells get 13 21 mul 8 add get 3 eq (dark module) mustbe
% 1 qr--function-matrix /Cells get 8 21 mul 8 add get 6 eq (format reservation) mustbe
% 7 qr--function-matrix /Cells get 34 get 6 eq (version reservation) mustbe
% 1 qr--function-matrix /Mask get null eq (unmasked) mustbe
% { 41 qr--function-matrix } /qr-version-must-be-in-1-40 (large version) mustguard
%%EndSelfTest
% @internal
/qr--function-matrix {
  qr--check-version
  12 dict begin
    /version exch def /size version 4 mul 17 add def
    /cells size dup mul string def
    % x y value -> -, writing one cell flag byte.
    /cell { 3 1 roll size mul add exch cells 3 1 roll put } def
    0 1 size 1 sub {
      /i exch def /v i 2 mod 0 eq { 3 } { 2 } ifelse def
      6 i v cell i 6 v cell
    } for
    % Finder centers; the 9x9 square includes the light separator ring and
    % is clipped at the symbol edge.
    [[3 3] [size 4 sub 3] [3 size 4 sub]] {
      aload pop /cy exch def /cx exch def
      -4 1 4 { /dy exch def
        -4 1 4 { /dx exch def
          /x cx dx add def /y cy dy add def
          x 0 ge x size lt and y 0 ge and y size lt and {
            /d dx abs dy abs 2 copy lt { exch } if pop def
            x y d 2 eq d 4 eq or { 2 } { 3 } ifelse cell
          } if
        } for
      } for
    } forall
    /centers version qr--alignment-centers def /last centers length 1 sub def
    0 1 last { /i exch def
      0 1 last { /j exch def
        % Skip the three corners occupied by finder patterns.
        i 0 eq j 0 eq and i 0 eq j last eq and or i last eq j 0 eq and or not {
          -2 1 2 { /dy exch def
            -2 1 2 { /dx exch def
              /d dx abs dy abs 2 copy lt { exch } if pop def
              centers i get dx add centers j get dy add
              d 1 eq { 2 } { 3 } ifelse cell
            } for
          } for
        } if
      } for
    } for
    % Format information: two 15-cell copies around the finders.
    0 1 5 { 8 exch 6 cell } for
    8 7 6 cell 8 8 6 cell 7 8 6 cell
    0 1 5 { 8 6 cell } for
    0 1 7 { size 1 sub exch sub 8 6 cell } for
    size 7 sub 1 size 1 sub { 8 exch 6 cell } for
    8 size 8 sub 3 cell
    % Version information (v>=7): two 6x3 blocks beside the far finders.
    version 7 ge {
      0 1 5 { /b exch def
        size 11 sub 1 size 9 sub { /a exch def a b 6 cell b a 6 cell } for
      } for
    } if
    << /Version version /Size size /Cells cells /Mask null >>
  end
} bind def

% qr--matrix: codewords version -> fresh unmasked matrix with every codeword
% bit placed. Codewords are the complete interleaved stream (qr--interleave's
% output). Bits go most significant first in the two-column zigzag, upward
% from the bottom-right, skipping function cells and the vertical timing
% column. Remainder cells (0-7) stay light data cells and are still masked.
%%SelfTest: qr-matrix-guards
% { () 1 qr--matrix } /qr-codewords-length-must-match-version (empty stream) mustguard
% { 27 string 1 qr--matrix } /qr-codewords-length-must-match-version (long stream) mustguard
% { [] 1 qr--matrix } /qr-codewords-must-be-a-string (array stream) mustguard
% { 26 string 1.0 qr--matrix } /qr-version-must-be-integer (real version) mustguard
% { 26 string 0 qr--matrix } /qr-version-must-be-in-1-40 (zero version) mustguard
%%EndSelfTest
%%SelfTest: qr-matrix-placement
% 26 string 1 qr--matrix /Cells get 440 get 0 eq (light first bit) mustbe
% 26 string dup 0 128 put 1 qr--matrix /Cells get 440 get 1 eq (first bit bottom right) mustbe
% 26 string dup 0 64 put 1 qr--matrix /Cells get 439 get 1 eq (second bit left of first) mustbe
% 26 string cvx 1 qr--matrix /Size get 21 eq (executable stream is data) mustbe
%%EndSelfTest
% @internal
/qr--matrix {
  qr--check-version
  1 index type /stringtype ne { qr-codewords-must-be-a-string } if
  1 index rcheck not { qr-codewords-must-be-readable } if
  1 index length 1 index qr--raw-modules 8 idiv ne {
    qr-codewords-length-must-match-version
  } if
  qr--function-matrix
  12 dict begin
    /m exch def /data exch cvlit def
    /cells m /Cells get def /size m /Size get def
    /nbits data length 8 mul def /i 0 def
    size 1 sub -2 1 { /right exch def
      right 6 le { /right right 1 sub def } if
      /upward right 1 add 2 and 0 eq def
      0 1 size 1 sub { /vert exch def
        /row upward { size 1 sub vert sub } { vert } ifelse size mul def
        0 1 1 { /j exch def /at row right add j sub def
          cells at get 2 and 0 eq i nbits lt and {
            cells at data i -3 bitshift get i 7 and 7 sub bitshift 1 and put
            /i i 1 add def
          } if
        } for
      } for
    } for
    m
  end
} bind def

% Mask predicates, indexed by mask number, with x the column and y the row.
% Each leaves 0 exactly where a data cell is inverted.
% @internal
/qr--mask-predicates [
  { x y add 2 mod } bind
  { y 2 mod } bind
  { x 3 mod } bind
  { x y add 3 mod } bind
  { x 3 idiv y 2 idiv add 2 mod } bind
  { x y mul dup 2 mod exch 3 mod add } bind
  { x y mul dup 2 mod exch 3 mod add 2 mod } bind
  { x y add 2 mod x y mul 3 mod add 2 mod } bind
] def

% Shape check shared by matrix consumers; leaves the matrix on the stack.
% @internal
/qr--check-matrix {
  dup type /dicttype ne { qr-matrix-must-be-a-matrix } if
  dup /Version known 1 index /Size known and
  1 index /Cells known and 1 index /Mask known and not { qr-matrix-must-be-a-matrix } if
  dup /Version get dup type /integertype eq { dup 1 ge exch 40 le and } { pop false } ifelse
  not { qr-matrix-must-be-a-matrix } if
  dup /Size get 1 index /Version get 4 mul 17 add ne { qr-matrix-must-be-a-matrix } if
  dup /Cells get dup type /stringtype eq {
    length 1 index /Size get dup mul eq
  } { pop false } ifelse
  not { qr-matrix-must-be-a-matrix } if
  dup /Cells get rcheck not { qr-matrix-must-be-a-matrix } if
} bind def

% qr--apply-mask: unmasked-matrix mask -> fresh matrix with that one mask
% applied to every non-function cell and /Mask set. The input is unchanged.
% Re-masking is refused: masks are XORs, so a second one silently corrupts.
%%SelfTest: qr-apply-mask
% { 1 qr--function-matrix 8 qr--apply-mask } /qr-mask-must-be-in-0-7 (large mask) mustguard
% { 1 qr--function-matrix -1 qr--apply-mask } /qr-mask-must-be-in-0-7 (negative mask) mustguard
% { 1 qr--function-matrix 1.0 qr--apply-mask } /qr-mask-must-be-integer (real mask) mustguard
% { 1 dict 0 qr--apply-mask } /qr-matrix-must-be-a-matrix (empty dictionary) mustguard
% { 1 qr--function-matrix 0 qr--apply-mask 1 qr--apply-mask } /qr-matrix-already-masked (double mask) mustguard
% 1 qr--function-matrix 0 qr--apply-mask /Cells get 440 get 1 eq (mask 0 inverts even sum) mustbe
% 1 qr--function-matrix 1 qr--apply-mask /Cells get 439 get 1 eq (mask 1 inverts even rows) mustbe
% 1 qr--function-matrix 7 qr--apply-mask /Mask get 7 eq (mask recorded) mustbe
%%EndSelfTest
% @internal
/qr--apply-mask {
  dup type /integertype ne { qr-mask-must-be-integer } if
  dup dup 0 lt exch 7 gt or { qr-mask-must-be-in-0-7 } if
  1 index qr--check-matrix /Mask get null ne { qr-matrix-already-masked } if
  10 dict begin
    /mask exch def /src exch def /size src /Size get def
    /cells src /Cells get dup length string copy def
    /test qr--mask-predicates mask get def
    0 1 size 1 sub { /y exch def
      0 1 size 1 sub { /x exch def /at y size mul x add def
        cells at get 2 and 0 eq { test 0 eq { cells at cells at get 1 xor put } if } if
      } for
    } for
    << /Version src /Version get /Size size /Cells cells /Mask mask >>
  end
} bind def
