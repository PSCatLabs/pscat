%!PS-Adobe-3.0
%%Title: retro_fonts.ps — specimen of the terminal, dot-matrix and LED faces
%%Creator: pscat — issue #1426
%%BoundingBox: 0 0 760 1400
%%EndComments

% The four retro faces of lib/fonts/ on one sheet: every glyph of each,
% at a magnified size and at true size (one font pixel per unit), with
% their variants. /Phosphor on a terminal screen, /Pinpoint-Draft and
% /Pinpoint-NLQ on printer paper, /Diode7 and /Diode5 on a dark LED
% panel. The library files load relative to the repo root:
%
%   pscat --page 760x1400 --dpi 144 --png retro.png examples/retro_fonts.ps
%   gs -dNOSAFER -dNOPAUSE -dBATCH -sDEVICE=png16m -g760x1400 -r72 \
%      -o retro.png examples/retro_fonts.ps        (from the repo root)

(lib/fonts/phosphor.ps) run
(lib/fonts/pinpoint.ps) run
(lib/fonts/diode7.ps) run
(lib/fonts/diode5.ps) run

/ascii1 ( !"#$%&'\(\)*+,-./0123456789:;<=>?) def
/ascii2 (@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`) def
/ascii3 (abcdefghijklmnopqrstuvwxyz{|}~) def

% x y w h r g b panel -
/panel { setrgbcolor rectfill } def
% (text) x y label -   a small caption in Helvetica
/label {
  moveto /Helvetica 9 selectfont show
} def
% /Face size x y (text) at -
/at {
  5 1 roll moveto exch findfont exch scalefont setfont show
} def
% /Face size x y lead allthree -   the 95 printable ASCII glyphs, 3 lines
/allthree {
  /lead exch def /y exch def /x exch def /sz exch def /fc exch def
  fc sz x y ascii1 at
  fc sz x y lead sub ascii2 at
  fc sz x y lead 2 mul sub ascii3 at
} def

1 setgray clippath fill

% ------------------------------------------------------------- Phosphor
0 760 760 640 0.02 0.04 0.03 panel
0.55 0.7 0.6 setrgbcolor
(PHOSPHOR  -  lib/fonts/phosphor.ps  -  8x16 cell, every printable ASCII glyph at 32 pt (2 units per pixel)) 24 1380 label
0.3 1 0.45 setrgbcolor
/Phosphor 32 24 1340 38 allthree
0.55 0.7 0.6 setrgbcolor
(/Phosphor-Scan at 48 pt: scan-line gaps (/ScanGap 0.45)) 24 1222 label
0.3 1 0.45 setrgbcolor
/Phosphor-Scan 48 24 1180 (READY. Scan lines) at
/Phosphor-Scan 48 24 1130 (gjpqy 0O 1lI \(\){}) at
0.55 0.7 0.6 setrgbcolor
(Amber, true size: 16 pt, one unit per pixel, a terminal session) 24 1100 label
1 0.72 0.15 setrgbcolor
/Phosphor 16 24 1076 (PSCAT TERMINAL 80x24   (C) 2026 PSCatLabs) at
/Phosphor 16 24 1060 (login: guest) at
/Phosphor 16 24 1044 ($ ls -l /usr/games) at
/Phosphor 16 24 1028 (-rwxr-xr-x  1 root  4096 Nov 26 14:02 lander) at
/Phosphor 16 24 1012 (-rwxr-xr-x  1 root  8192 Nov 26 14:02 wumpus) at
/Phosphor 16 24 996 ($ echo "{x: [1, 2], y: 'ok'} | grep ~/a_b") at
/Phosphor 16 24 980 ($ _) at
0.55 0.7 0.6 setrgbcolor
(Variants by pf-variant: /DotShape /round /DotSize 0.85, white at 24 pt; /DotSize 0.7 squares at 24 pt) 24 954 label
/Ph-Round /Phosphor << /DotShape /round /DotSize 0.85 >> pf-variant
/Ph-Grid /Phosphor << /DotSize 0.7 >> pf-variant
0.85 0.9 1 setrgbcolor
/Ph-Round 24 24 924 (Round dots: The quick brown fox) at
0.3 0.85 1 setrgbcolor
/Ph-Grid 24 24 890 (Pixel grid: jumps over 0123456789) at
0.55 0.7 0.6 setrgbcolor
(Green, true size 16 pt:) 24 864 label
0.3 1 0.45 setrgbcolor
/Phosphor 16 24 842 ascii1 at
/Phosphor 16 24 826 ascii2 at
/Phosphor 16 24 810 ascii3 at
/Phosphor 16 24 784 (The quick brown fox jumps over the lazy dog.) at

