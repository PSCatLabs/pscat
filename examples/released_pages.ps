    <<
        /Text rptext
        /Width 396 /Height 612 /Margin 48 /MarginTop 62
        /Pitch 12 /Size 10.5 /Tabs 5
        /Machine 11 /Seed 1958 /Wear 1.3 /MachineWear 0.6
        /Ink [0.17 0.16 0.17] /Ribbon 0.55 /Copies 0.35
        /PageNumbers /bottom
        /Memo << /Title (MEMORANDUM)
                 /To (Assistant Director, Plats Division)
                 /From (Chief Surveyor, Calder Survey Office)
                 /Subject (Markers reset after the spring floods)
                 /Date (October 3, 1958) >>
        /Redactor { rel-redact }
        /PageStart { rel-page-start }
        /PageEnd { rel-page-end }
    >> tw-type
} <<
    /Width 396 /Height 612 /Seed 58 /Generation 1 /Paged true
    /Age 0.55 /EdgeDark 0.45 /Folds 0.6 /Lamp 0.2 /Skew 0.5 /Punch 2 /Staple 1
    /Speckle 0.6 /Redact 0.6
    /Stamps [
        << /Lines [ (RECEIVED) (OCT 7 1958) ] /X 310 /Y 566 /Angle 2 /Size 9
           /Ink [0.12 0.12 0.16] /Frame /box /Font /Helvetica /Tracking 1.2
           /Seed 7 /Strength 0.55 >>
        << /Lines [ (RELEASED) (IN PART) ] /X 270 /Y 128 /Angle -7 /Size 17
           /Ink [0.6 0.12 0.12] /Frame /double /Seed 4 /Strength 0.6 /Page 1 >>
    ]
    /Notes [ << /Text (find that book before the snow) /X 150 /Y 250 /Angle -3
                /Size 14 /Width 150 /Seed 3 /Page 2 >> ]
>> rel-page

showpage
