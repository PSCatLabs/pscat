%!PS-Adobe-3.0
%%Title: Chromatic Bloom — drawing vocabulary
%%BoundingBox: 0 0 720 300
%%Pages: 1
%%EndComments
(lib/functional.ps) run
(examples/functional/common.ps) run
df-palette 0 df-color 0 0 720 300 rectfill
[[<< /X 120 /Y 155 /Radius 92 /Angle 15 >> df-palettes 0 get]
 [<< /X 360 /Y 155 /Radius 92 /Angle 15 >> df-palettes 1 get]
 [<< /X 600 /Y 155 /Radius 92 /Angle 15 >> df-palettes 2 get]]
{ aload pop df-flower } fp-each
df-palette 1 df-color /Courier findfont 11 scalefont setfont
(ULTRAVIOLET) 120 30 showctr
(SUNPRINT) 360 30 showctr
(BLUE HOUR) 600 30 showctr
showpage
