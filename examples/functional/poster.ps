%!PS-Adobe-3.0
%%Title: Chromatic Bloom — Functional PostScript
%%BoundingBox: 0 0 720 960
%%Pages: 1
%%EndComments
% From repo root: pscat --page 720x960 --png bloom.png examples/functional/poster.ps
(lib/functional.ps) run
(lib/aspect.ps) run
(examples/functional/common.ps) run

/flowers 25 fp-range {df-site} fp-map /Visible fp-field fp-filter def
/checksum flowers 0 {df-weight} fp-fold def
/visits << /Calls 0 >> def

% Each record feeds the stem, is kept, then feeds the flower.
% Colour is captured data.
/stem df-palette {df-stem} fp-curry def
/blossom df-palette {df-flower} fp-curry visits aop-count def
/draw {/stem load fp-keep blossom} def
/score {
  df-ground
  Layer 2 ge {flowers /draw load fp-each} if
  Layer 3 ge {df-type} if
} (garden) aop-trace def
score
(flowers=) print visits /Calls get =
(radius-checksum=) print checksum =
showpage
