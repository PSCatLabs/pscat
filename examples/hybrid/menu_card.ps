%!PS-Adobe-3.0
%%Title: The Lantern Pear (a hybrid menu card: image model + pscat)
%%BoundingBox: 0 0 612 792
%%EndComments

% A US Letter café menu, made in two layers:
%
%   1. The atmosphere: examples/hybrid/menu_card_bg.jpg, a watercolour of
%      two pears made once by an image model (the prompt is in
%      examples/hybrid/README.md) and then frozen.
%   2. The exact layer, everything below: the name, the sections, every
%      dish and price, and a QR code that lib/qr.ps encodes and draws as
%      vector squares.
%
% A price changes: edit it here and re-render. The painting is not asked
% for again, so nothing else on the card moves or changes.
%
% Render from the repository root (the program reads the JPEG by a
% relative path):
%   pscat --page 612x792 --pdf menu_card.pdf examples/hybrid/menu_card.ps
%   pscat --page 612x792 --dpi 144 --png menu_card.png examples/hybrid/menu_card.ps
% The PDF is US Letter at its true size; the type and the QR code stay
% vector, and the painting is embedded at its own 1102 x 1427 pixels
% (about 130 pixels per inch across the page).
%
% Defining /PscatOnly true before the program swaps the painting for a
% watercolour that paintkit paints (the "pscat alone" panel of the
% comparison in docs/guides/pscat-with-image-models.md); the exact layer
% is unchanged:
%   { echo '/PscatOnly true def'; cat examples/hybrid/menu_card.ps; } | \
%     pscat --page 612x792 --dpi 144 --png menu_pscat.png -
%
% The café, its address and its menu are invented.
% CC0 1.0 (see LICENSE-CC0). The background image was made by OpenAI's
% image model; examples/hybrid/README.md says where it came from and how
% it is licensed.

(lib/qr.ps) run

/PscatOnly where { pop } { /PscatOnly false def } ifelse

/PW 612 def /PH 792 def
/URL (https://pscatlabs.github.io/pscat/hybrid.html) def

% ---------------------------------------------------------------- fonts
% Latin-1 for the accents and the middle dot, plus an en dash (Latin-1
% has none) in an unused slot, 8#200.
/MenuEncoding ISOLatin1Encoding dup length array copy dup 8#200 /endash put def
/menufont { % /New /Base -
  findfont dup length dict copy dup /Encoding MenuEncoding put definefont pop
} def
/Name-M /Palatino-Roman menufont
/Ital-M /Palatino-Italic menufont
/Body-M /Palatino-Roman menufont
/font { exch findfont exch scalefont setfont } def
/rshow { dup stringwidth pop neg 0 rmoveto show } def

/ink { 0.17 0.19 0.08 setrgbcolor } def          % a dark olive, from the leaves

% ------------------------------------------------------------- the layer
PscatOnly {
  % pscat alone: paper and translucent washes from paintkit.
  (lib/artkit.ps) run
  (lib/paintkit.ps) run
  11 srand
  0 0 PW PH << /Tone [0.98 0.95 0.88] /Grain 0.5 /Seed 3 >> pkpaper
  % a sage wash bleeding in from the top left, in several soft passes
  0.60 0.68 0.46 setrgbcolor
  [ [0 0.07] [40 0.05] [90 0.04] ] {
    aload pop /wa exch def /wo exch def
    newpath -30 PH 30 add moveto 300 wo sub PH 30 add lineto
    200 wo sub PH 80 sub 120 wo sub PH 150 sub 60 wo sub PH 260 sub curveto
    -30 PH 420 wo sub sub lineto closepath
    << /Alpha wa /Layers 4 /Wet 30 /Bloom 0.25 >> pkwash
  } forall
  % a pear: x y (base centre) s (size) -
  /pear { /ps exch def /py exch def /px exch def
    newpath px py moveto
    px ps 0.62 mul add py  px ps 0.60 mul add py ps 0.62 mul add  px ps 0.30 mul add py ps 0.82 mul add curveto
    px ps 0.12 mul add py ps 0.95 mul add  px ps 0.14 mul add py ps 1.25 mul add  px py ps 1.27 mul add curveto
    px ps 0.14 mul sub py ps 1.25 mul add  px ps 0.12 mul sub py ps 0.95 mul add  px ps 0.30 mul sub py ps 0.82 mul add curveto
    px ps 0.60 mul sub py ps 0.62 mul add  px ps 0.62 mul sub py  px py curveto closepath } def
  % paint one pear: a gold-green body, a cooler shadow side, a rose blush,
  % each a translucent wash kept inside the pear's outline
  /pearpaint { /ps exch def /py exch def /px exch def
    0.86 0.80 0.38 setrgbcolor px py ps pear
    << /Alpha 0.32 /Layers 5 /Wet 4 /Bloom 0.8 >> pkwash
    % soft glazes, graded by stacking shrinking discs at a low alpha
    gsave px py ps pear clip
      0.50 0.60 0.26 setrgbcolor
      1 -0.12 0.4 { /k exch def
        newpath px ps 0.42 mul add py ps 0.42 mul add ps 0.55 mul k mul 0 360 arc closepath
        << /Alpha 0.05 /Layers 2 /Wet 6 /Bloom 0 >> pkwash } for
      0.88 0.50 0.40 setrgbcolor
      1 -0.15 0.3 { /k exch def
        newpath px ps 0.30 mul sub py ps 0.36 mul add ps 0.34 mul k mul 0 360 arc closepath
        << /Alpha 0.035 /Layers 2 /Wet 6 /Bloom 0 >> pkwash } for
      1 1 0.92 setrgbcolor
      newpath px ps 0.22 mul sub py ps 0.62 mul add ps 0.07 mul 0 360 arc closepath
      << /Alpha 0.35 /Layers 2 /Wet 2 /Bloom 0 >> pkwash
    grestore
    0.42 0.30 0.18 setrgbcolor 2.2 setlinewidth 1 setlinecap
    newpath px py ps 1.25 mul add moveto px 1 add py ps 1.33 mul add px 3 add py ps 1.40 mul add px 8 add py ps 1.46 mul add curveto stroke } def
  % a leaf along an angle: x y len angle -
  /leaf { gsave 4 2 roll translate rotate /ll exch def
    0.48 0.60 0.32 setrgbcolor
    newpath 0 0 moveto ll 0.25 mul ll 0.26 mul ll 0.72 mul ll 0.22 mul ll 0 curveto
    ll 0.72 mul ll -0.22 mul ll 0.25 mul ll -0.26 mul 0 0 curveto closepath
    << /Alpha 0.26 /Layers 4 /Wet 3 /Bloom 0.7 >> pkwash
    0.38 0.48 0.26 setrgbcolor 0.7 setlinewidth
    newpath 0 0 moveto ll 0.4 mul ll 0.03 mul ll 0.7 mul ll 0.02 mul ll 0.92 mul 0 curveto stroke grestore } def
  % the branch, the leaves behind, the pears, a leaf in front
  0.50 0.38 0.25 setrgbcolor 2.6 setlinewidth 1 setlinecap
  newpath 615 420 moveto 560 395 500 360 455 320 curveto stroke
  1.8 setlinewidth
  newpath 470 333 moveto 440 310 420 290 403 274 curveto stroke
  newpath 538 380 moveto 528 340 522 300 518 275 curveto stroke
  455 322 120 160 leaf
  540 384 105 70 leaf
  585 404 90 -15 leaf
  395 70 140 pearpaint
  510 100 120 pearpaint
  470 30 105 -18 leaf
} {
  % the hybrid: the frozen painting, scaled to cover the page.
  gsave
    0 0 PW PH rectclip
    /BgW 1102 def /BgH 1427 def
    PW PW BgW div BgH mul scale
    /DeviceRGB setcolorspace
    << /ImageType 1 /Width BgW /Height BgH /BitsPerComponent 8
       /Decode [0 1 0 1 0 1] /ImageMatrix [BgW 0 0 BgH neg 0 BgH]
       /DataSource (examples/hybrid/menu_card_bg.jpg) (r) file /DCTDecode filter
    >> image
  grestore
} ifelse

% ------------------------------------------------------------- the menu
% Each price follows its dish (no right-hand price column), so every line
% stays clear of the pears and leaves on the right of the painting.
/L 64 def
ink
/Name-M 56 font
L 694 moveto (The Lantern Pear) show
/Ital-M 20 font
L 2 add 662 moveto (Caf\351 \267 14 Mill Lane) show

/y 604 def
/section { % (title) -
  ink /Ital-M 26 font L y moveto show
  0.6 setlinewidth newpath L y 10 sub moveto L 236 add y 10 sub lineto stroke
  /y y 36 sub def } def
/item { % (dish) (price) -
  ink /Body-M 16 font L y moveto exch show
  (  ) show /Ital-M 16 font show
  /y y 25 sub def } def

(Breakfast, 8\20011) section
(Buttermilk pancakes, maple butter) (9.50) item
(Shakshuka with sourdough) (11.25) item
(Bircher muesli, poached pear) (7.75) item
/y y 26 sub def
(Lunch, 12\2003) section
(Roast squash and farro salad) (12.50) item
(Leek and Gruy\350re tart) (13.00) item
(Soup of the day with bread) (8.25) item
/y y 26 sub def
(Drinks) section
(Flat white) (3.80) item
(Pot of tea) (3.20) item
(Pear and ginger soda) (4.10) item

% The URL is 44 bytes: version 5 at level H, 2-point modules on whole
% points, so every module edge is a pixel edge at 72 and 144 dpi. Dark
% olive on the paper's own cream, with the quiet zone painted.
/QX 62 def /QY 48 def
QX QY moveto URL << /Level /H >> qrencode
<< /ModuleSize 2 /Dark [0.12 0.14 0.06] /Light [0.99 0.97 0.91] >> qrdraw
ink /Ital-M 15 font
QX 2 add QY 100 add moveto (Scan: how this menu was made) show
showpage
