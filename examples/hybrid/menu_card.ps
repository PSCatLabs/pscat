%!PS-Adobe-3.0
%%Title: The Lantern Pear (a hybrid menu card: image model + pscat)
%%BoundingBox: 0 0 612 792
%%EndComments

% A US Letter café menu, made in two layers:
%
%   1. The atmosphere: examples/hybrid/menu_card_bg.jpg, a watercolour of
%      two pears made once by an image model (the prompt is in
%      examples/hybrid/README.md) and then frozen.
%   2. The exact layer, everything below: the name, the sections, every
%      dish and price, and a QR code that lib/qr.ps encodes and draws as
%      vector squares.
%
% A price changes: edit it here and re-render. The painting is not asked
% for again, so nothing else on the card moves or changes.
%
% Render from the repository root (the program reads the JPEG by a
% relative path):
%   pscat --page 612x792 --pdf menu_card.pdf examples/hybrid/menu_card.ps
%   pscat --page 612x792 --dpi 144 --png menu_card.png examples/hybrid/menu_card.ps
% The PDF is US Letter at its true size; the type and the QR code stay
% vector, and the painting is embedded at its own 1102 x 1427 pixels
% (about 130 pixels per inch across the page).
%
% Defining /PscatOnly true before the program swaps the painting for a
% botanical print that pscat draws itself, flat inks on paintkit's paper
% (the "pscat alone" panel of the comparison in
% docs/guides/pscat-with-image-models.md); the exact layer is unchanged:
%   { echo '/PscatOnly true def'; cat examples/hybrid/menu_card.ps; } | \
%     pscat --page 612x792 --dpi 144 --png menu_pscat.png -
%
% The café, its address and its menu are invented.
% CC0 1.0 (see LICENSE-CC0). The background image was made by OpenAI's
% image model; examples/hybrid/README.md says where it came from and how
% it is licensed.

(lib/qr.ps) run

/PscatOnly where { pop } { /PscatOnly false def } ifelse

/PW 612 def /PH 792 def
/URL (https://pscatlabs.github.io/pscat/hybrid.html) def

% ---------------------------------------------------------------- fonts
% Three faces, one job each: Playfair Display for the name, Cinzel (an
% inscriptional face with no lower case, so every heading sets in capitals
% as typed) for the line under it and the section heads, Palatino for the
% dishes and prices (its figures are lining and tabular, so the prices
% line up on the decimal point). Playfair Display and Cinzel are catalog
% faces: in a checkout they are in fonts/catalog/, and an installed pscat
% gets them with `pscat fonts install --pack extras` (without the pack
% they stand in as Helvetica and pscat says so).
% Latin-1 for the accents and the middle dot, plus an en dash (Latin-1
% has none) in an unused slot, 8#200.
/MenuEncoding ISOLatin1Encoding dup length array copy dup 8#200 /endash put def
/menufont { % /New /Base -
  findfont dup length dict copy dup /Encoding MenuEncoding put definefont pop
} def
/Name-M /PlayfairDisplay-Regular menufont
/Caps-M /Cinzel-Regular menufont
/Ital-M /Palatino-Italic menufont
/Body-M /Palatino-Roman menufont
/font { exch findfont exch scalefont setfont } def
% Tracked type: drawn whole by ashow, `track` points after each character
% but the last, so it measures and aligns true.
/twidth { % (s) track -> w
  1 index stringwidth pop exch 2 index length 1 sub mul add exch pop } def
/tshow { 0 3 -1 roll ashow } def          % (s) track -
/rshow { dup stringwidth pop neg 0 rmoveto show } def

/ink { 0.17 0.19 0.08 setrgbcolor } def          % a dark olive, from the leaves
/rust { 0.50 0.24 0.13 setrgbcolor } def         % the pears' blush, for the heads
/leader { 0.55 0.55 0.42 setrgbcolor } def       % the dot leaders

% ----------------------------------------------------------------- grid
% US Letter. One text column on the left, from L to R: a 64 pt margin and
% a 252 pt measure, the prices right-aligned on R. R stops short of the
% painted leaves (their nearest edge is about x 350 at the height of the
% Drinks section) and the menu ends above them. A 23 pt line for the
% dishes; an 18 pt gap between sections.
/L 64 def /R 316 def

% ------------------------------------------------------------- the layer
PscatOnly {
  % pscat alone: not an imitation of the watercolour, but a botanical
  % print in flat inks, which vector art does well. paintkit lays the
  % paper; the pears and leaves are each a few flat
  % shapes, overprinted: a body, a shadow side, a blush, a highlight, and
  % a fine key line printed a point off register.
  (lib/artkit.ps) run
  (lib/paintkit.ps) run
  11 srand
  0 0 PW PH << /Tone [0.98 0.955 0.89] /Grain 0.5 /Seed 3 >> pkpaper
  % a pear: x y (base centre) s (size) -   the path
  /pear { /qs exch def /qy exch def /qx exch def
    newpath qx qy moveto
    qx qs 0.62 mul add qy  qx qs 0.60 mul add qy qs 0.62 mul add  qx qs 0.30 mul add qy qs 0.82 mul add curveto
    qx qs 0.12 mul add qy qs 0.95 mul add  qx qs 0.14 mul add qy qs 1.25 mul add  qx qy qs 1.27 mul add curveto
    qx qs 0.14 mul sub qy qs 1.25 mul add  qx qs 0.12 mul sub qy qs 0.95 mul add  qx qs 0.30 mul sub qy qs 0.82 mul add curveto
    qx qs 0.60 mul sub qy qs 0.62 mul add  qx qs 0.62 mul sub qy  qx qy curveto closepath } def
  /keyline { 0.30 0.30 0.14 setrgbcolor } def
  /pearpaint { % x y s -
    /ps exch def /py exch def /px exch def
    gsave px py ps pear clip
      % the shadow side, then the lit body over all but its right edge
      0.55 0.62 0.24 setrgbcolor px py ps pear fill
      0.86 0.82 0.36 setrgbcolor
      px ps 0.07 mul sub py ps 0.03 mul add ps 0.94 mul pear fill
      % the blush, low on the sunny side: soft discs, each a little more
      % opaque towards the middle, so it grades into the body
      0.88 0.46 0.36 setrgbcolor
      gsave px ps 0.24 mul sub py ps 0.36 mul add translate 1 0.85 scale
        ps 0.40 mul ps -0.02 mul ps 0.04 mul { 0.07 setalpha
          newpath 0 0 3 -1 roll 0 360 arc fill } for grestore
      % the speckle of a ripe pear's skin
      0.42 0.40 0.16 setrgbcolor 0.35 setalpha
      0 1 70 { pop
        px rand 1000 mod 500 sub 1000 div ps 1.3 mul mul add
        py rand 1000 mod 1000 div ps 1.2 mul mul add
        rand 3 mod 0.3 mul 0.5 add 0 360 arc fill } for
      % the highlight
      1 0.98 0.86 setrgbcolor 0.8 setalpha
      gsave px ps 0.26 mul sub py ps 0.66 mul add translate -25 rotate 0.45 1 scale
        newpath 0 0 ps 0.09 mul 0 360 arc fill grestore
      1 setalpha
    grestore
    % the key line, a point off register
    gsave 1.2 -0.8 translate keyline 0.9 setlinewidth px py ps pear stroke grestore
    % the stem
    0.40 0.28 0.16 setrgbcolor 2.4 setlinewidth 1 setlinecap
    newpath px py ps 1.25 mul add moveto px 1 add py ps 1.33 mul add px 3 add py ps 1.40 mul add px 8 add py ps 1.46 mul add curveto stroke } def
  % a leaf along an angle, in two greens split at the midrib: x y len angle -
  /leafpath { % len -
    /ll exch def newpath 0 0 moveto ll 0.25 mul ll 0.27 mul ll 0.72 mul ll 0.22 mul ll 0 curveto
    ll 0.72 mul ll -0.22 mul ll 0.25 mul ll -0.27 mul 0 0 curveto closepath } def
  /leaf { gsave 4 2 roll translate rotate /lf exch def
    0.50 0.62 0.32 setrgbcolor lf leafpath fill
    gsave lf leafpath clip 0.38 0.50 0.24 setrgbcolor 0 -100 lf 100 rectfill grestore
    0.86 0.88 0.66 setrgbcolor 0.8 setlinewidth
    newpath 0 0 moveto lf 0.4 mul lf 0.03 mul lf 0.7 mul lf 0.02 mul lf 0.92 mul 0 curveto stroke
    gsave 1.2 -0.8 translate keyline 0.7 setlinewidth lf leafpath stroke grestore
    grestore } def
  % a soft shadow on the table under the pears
  0.62 0.52 0.40 setrgbcolor 0.10 setalpha
  gsave 462 52 translate 1 0.12 scale newpath 0 0 130 0 360 arc fill grestore
  1 setalpha
  % the branch, the leaves behind, the pears, a leaf in front
  0.42 0.30 0.18 setrgbcolor 3 setlinewidth 1 setlinecap
  newpath 586 424 moveto 556 400 516 368 470 330 curveto stroke
  2 setlinewidth
  newpath 484 342 moveto 452 316 430 296 413 278 curveto stroke
  newpath 548 397 moveto 540 356 534 316 533 279 curveto stroke
  % the cut end of the sprig
  0.62 0.50 0.32 setrgbcolor newpath 586 424 2 0 360 arc fill
  466 334 112 160 leaf
  552 402 92 96 leaf
  512 372 74 118 leaf
  405 60 150 pearpaint
  525 92 128 pearpaint
  470 40 96 6 leaf
} {
  % the hybrid: the frozen painting, scaled to cover the page.
  gsave
    0 0 PW PH rectclip
    /BgW 1102 def /BgH 1427 def
    PW PW BgW div BgH mul scale
    /DeviceRGB setcolorspace
    << /ImageType 1 /Width BgW /Height BgH /BitsPerComponent 8
       /Decode [0 1 0 1 0 1] /ImageMatrix [BgW 0 0 BgH neg 0 BgH]
       /DataSource (examples/hybrid/menu_card_bg.jpg) (r) file /DCTDecode filter
    >> image
  grestore
} ifelse

% ------------------------------------------------------------- the menu
ink
/Name-M 60 font
L 3 sub 712 moveto (The Lantern Pear) show
rust /Caps-M 13 font
L 682 moveto (Caf\351 \267 14 Mill Lane) 3 tshow

/y 632 def
/section { % (title) -
  rust /Caps-M 16 font L y moveto dup 2.4 tshow
  % a hairline from the end of the head to the price column
  2.4 twidth L add 10 add /hx exch def
  0.5 setlinewidth leader newpath hx y 4 add moveto R y 4 add lineto stroke
  /y y 32 sub def } def
/item { % (dish) (price) -
  /pr exch def /di exch def
  ink /Body-M 14 font L y moveto di show
  currentpoint pop 6 add /lx exch def
  R y moveto pr rshow
  pr stringwidth pop R exch sub 6 sub /rx exch def
  % dot leaders on a 4.5 pt pitch, aligned to R so they line up row to row
  leader
  R 4.5 sub { dup lx lt { pop exit } if dup rx le { dup y 2.6 add 0.55 0 360 arc fill } if
    4.5 sub } loop
  /y y 23 sub def } def

(Breakfast, 8\20011) section
(Buttermilk pancakes, maple butter) (9.50) item
(Shakshuka with sourdough) (11.25) item
(Bircher muesli, poached pear) (7.75) item
/y y 18 sub def
(Lunch, 12\2003) section
(Roast squash and farro salad) (12.50) item
(Leek and Gruy\350re tart) (13.00) item
(Soup of the day with bread) (8.25) item
/y y 18 sub def
(Drinks) section
(Flat white) (3.80) item
(Pot of tea) (3.20) item
(Pear and ginger soda) (4.10) item

% The URL is 44 bytes: version 5 at level H, 2-point modules on whole
% points, so every module edge is a pixel edge at 72 and 144 dpi. Dark
% olive on the paper's own cream, with the quiet zone painted. The
% caption sits beside it, level with its middle.
/QX 56 def /QY 56 def
QX QY moveto URL << /Level /H >> qrencode
<< /ModuleSize 2 /Dark [0.12 0.14 0.06] /Light [0.98 0.955 0.88] >> qrdraw
ink /Ital-M 13 font
QX 102 add QY 41 add moveto (Scan: how this menu was made) show
showpage
