%!PS
% The comparison sheet for the menu card (612 x 792 pt plus a
% 190 pt facts strip). From the repository root:
%   pscat sheet -o docs/guides/hybrid/menu_card_compare.png --page 612x982 \
%     --dpi 48 --no-sizes --sweep Panel=1,2,3 \
%     --label "The Lantern Pear: (a) image model alone, (b) pscat alone, (c) hybrid" \
%     examples/hybrid/compare_menu_card.ps
% Every fact below is checked: the QR results by tests/hybrid.rs (two
% decoders, rqrr and rxing, on the PNG and PDF exports and on the image
% model's JPEG), the copy of (b) and (c) string by string by the same
% test, and the copy of (a) by reading the image at full size.
/PageW 612 def /PageH 792 def
/Example (examples/hybrid/menu_card.ps) def
/ModelJPEG (examples/hybrid/menu_card_model.jpg) def /ModelW 1103 def /ModelH 1426 def
/FactsA [
  [/ok (Text: all 24 strings of the brief spelled right)]
  [/ok (Prices: all 9 right)]
  [/no (QR code: found, but does not decode)]
  [/note (Raster only: 1103 x 1426 px, 130 px/in at Letter)]
] def
/FactsB [
  [/ok (Text: all 24 strings painted exactly as written)]
  [/ok (Prices: all 9 as written)]
  [/ok (QR code: decodes to the URL, PNG and PDF)]
  [/note (Look: pscat's own botanical print, flat inks)]
] def
/FactsC [
  [/ok (Text: all 24 strings painted exactly as written)]
  [/ok (Prices: all 9 as written)]
  [/ok (QR code: decodes to the URL, PNG and PDF)]
  [/note (Look: the image model's painting, frozen)]
] def
(examples/hybrid/compare_panel.ps) run
