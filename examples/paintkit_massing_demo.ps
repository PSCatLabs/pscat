%!PS-Adobe-3.0
%%Title: Paintkit — light-aware massing, a lit side on a scumbled region (issue #345)
%%BoundingBox: 0 0 780 630
%%EndComments

% Specimen for pkscumblein's /Light, /Reach and /Feather (lib/paintkit.ps,
% "Brush motions"). A scumbled mass painted in one load is flat: every circle
% is painted the same way, so the lit side had to be faked (#187 scrubbed the
% cloud in its light, then the body over it shifted up, which only works for
% light from straight above or below). With /Light set, pkscumblein keeps only
% the circles on the side facing the light, in a band that follows the
% outline's lumps, so a second pass in a lighter load gives the mass its form:
%
%   region << /Count n /Radius r >> pkscumblein  << ...body load... >> pkbroad
%   region << /Count n /Radius r /Light 135 >> pkscumblein  << ...lit load... >> pkbroad
%
% Painted the way a painter models a mass: the body first, in one value, then
% the light laid into the side that faces it, close in value and as one
% shape rather than spots. A shadow side is the same call with the light
% turned round (/Light + 180) and a darker load.
%
% Top row, before: each mass in its body load alone.
% Middle row, after: the same masses (same seed, same circles) with a lit
% side: an evening cloud lit from below by the glow (/Light 270), a bush lit
% from the upper left with a cool shadow side (/Light 135, then 315), and a
% cumulus lit from the low sun on the left (/Light 160), which the old
% shifted-copy trick could not do. Each lit side is two passes, a deep graded
% half-light then a shallow core in smaller circles, worked wet into the
% body. /Count counts circles over the whole region, so a lit pass that keeps
% only a band of it asks for more. The clouds paint their circles with
% pkbroad; the bush pounces a pkdab clump of leaves on each one.
% Bottom row: what the motion keeps, for the bush's light. The outline in
% grey, every circle of the body pass faint, the circles a lit pass keeps in
% red, at /Reach 0.2, 0.35 and 0.5 (with /Feather 0, 0.5 and 1).
%
% No alpha anywhere, so Ghostscript renders the same page (its rand stream
% differs, so the circles fall differently).
%
%   pscat --page 780x630 --dpi 144 --png docs/paintkit_massing_demo.png examples/paintkit_massing_demo.ps

(lib/artkit.ps) run
(lib/paintkit.ps) run

/LBL { /Helvetica findfont 11 selectfont } def

% x y w h -   a lumpy cloud outline (the cookbook's)
/md_lump {
  /mdh exch def /mdw exch def /mdy exch def /mdx exch def
  newpath mdx mdy moveto
  mdx mdw 0.1 mul add mdy mdh 0.9 mul add  mdx mdw 0.3 mul add mdy mdh 1.1 mul add
  mdx mdw 0.42 mul add mdy mdh 0.8 mul add curveto
  mdx mdw 0.55 mul add mdy mdh 1.35 mul add  mdx mdw 0.8 mul add mdy mdh 1.05 mul add
  mdx mdw 0.84 mul add mdy mdh 0.5 mul add curveto
  mdx mdw 0.95 mul add mdy mdh 0.5 mul add  mdx mdw 1.02 mul add mdy mdh 0.2 mul add
  mdx mdw add mdy curveto
  mdx mdw 0.6 mul add mdy mdh 0.1 mul sub  mdx mdw 0.3 mul add mdy mdh 0.3 mul sub
  mdx mdy curveto closepath
} def

% cx cy r -   a bush's bumpy dome: lobes round the top, a flat foot
/md_bush {
  /mbr exch def /mby exch def /mbx exch def
  newpath
  0 4 180 {
    /mba exch def
    /mbk 1 mba 7 mul sin 0.10 mul add mba 13 mul 40 add sin 0.05 mul add def
    mbx mba cos mbr mul 1.15 mul mbk mul add
    mby mba sin mbr mul 0.9 mul mbk mul add
    mba 0 eq { moveto } { lineto } ifelse
  } for
  closepath
} def

% region n r squash opts colors -   one scumbled pass with a broad brush
/md_pass {
  /mpc exch def /mpo exch def /mpq exch def /mpr exch def /mpn exch def
  mpo /Count mpn put mpo /Radius mpr put mpo /Squash mpq put
  mpo pkscumblein
  << /Width mpr 2.2 mul /Charge 0.8 /Depletion 0.4 /Edge 0.4 /ColorMix 0.8
     /Colors mpc >> pkbroad
} def

% x y w h top bottom -   a graded panel ground
/md_ground {
  /mgb exch def /mgt exch def /mgh exch def /mgw exch def /mgy exch def /mgx exch def
  0 2 mgh {
    /mgk exch def
    mgb mgt mgk mgh div mix3 setrgbcolor
    mgx mgy mgk add mgw 2.5 mgk mgh 2 sub gt { pop 2 } if rectfill
  } for
} def

% --- the three masses, each as a procedure: lit? -
% Each re-seeds, so the before and after panels paint the same body circles.

/EVE_TOP [0.30 0.24 0.42] def /EVE_LOW [0.95 0.62 0.42] def
/eve_body [0.46 0.36 0.52] def /eve_lit [0.98 0.74 0.56] def
/md_evening {                                       % x y lit? -
  /mel exch def /mey exch def /mex exch def
  mex mey 240 200 EVE_TOP EVE_LOW md_ground
  /me_under [ EVE_TOP EVE_LOW 0.55 mix3 ] def
  11 srand
  {
    mex 30 add mey 70 add 180 56 md_lump scpath
    260 5.5 0.7 << >> [ [ eve_body 1.08 shade ] [ eve_body 0.92 shade ] ] md_pass
  } << /Soft 0.5 /Under me_under >> pkwet
  mel {
    % The lights, worked wet into the body that is under them: a deep,
    % graded half-light first, then the core of the light along the edge
    % in smaller circles (a thin band of big ones paints as rings).
    {
      mex 30 add mey 70 add 180 56 md_lump scpath
      520 5.5 0.7 << /Light 270 /Reach 0.45 /Feather 0.9 >>
      [ [ eve_body eve_lit 0.3 mix3 ] [ eve_body eve_lit 0.45 mix3 ] ] md_pass
      mex 30 add mey 70 add 180 56 md_lump scpath
      1000 3.5 0.7 << /Light 270 /Reach 0.2 /Feather 1 >>
      [ [ eve_lit EVE_LOW 0.15 mix3 ] [ eve_lit eve_body 0.25 mix3 ] ] md_pass
    } << /Soft 0.2 /Under eve_body >> pkwet
  } if
} def

/BUSH_SKY_T [0.62 0.74 0.88] def /BUSH_SKY_B [0.86 0.88 0.84] def
/GREEN [ /sapgreen 1 /vandykebrown 0.3 ] pigcolor def
/WARM  [ /cadmiumyellow 2 /sapgreen 1 ] pigcolor def
/COOL  [ /prussianblue 1 /midnightblack 0.4 ] pigcolor def
% opts dabopts -   one bush pass: circles over the outline, a clump on each
/md_bushpass {
  /mdd exch def /mdo exch def
  mbx0 120 add mby0 44 add 78 md_bush scpath mdo pkscumblein mdd pkdab
} def
/md_bushpanel {                                     % x y lit? -
  /mbl exch def /mby0 exch def /mbx0 exch def
  mbx0 mby0 240 200 BUSH_SKY_T BUSH_SKY_B md_ground
  [0.16 0.13 0.09] aload pop setrgbcolor
  mbx0 mby0 240 46 rectfill
  23 srand
  GREEN aload pop setrgbcolor
  << /Count 200 /Radius 4 >>
  << /Size 5 /Scatter 6 /Density 3 /Highlight 0.2 /Shadow 0.5 /Irregular 0.9
     /HighlightColor WARM /ShadowColor COOL >> md_bushpass
  mbl {
    % the shadow side: the same call with the light turned round
    [ GREEN COOL 0.5 mix3 ] aload pop setrgbcolor
    << /Count 160 /Radius 4 /Light 315 /Reach 0.3 /Feather 0.8 >>
    << /Size 4.2 /Scatter 5 /Density 3 /Irregular 0.9 /Highlight 0.1 /Shadow 0.4
       /HighlightColor GREEN /ShadowColor COOL >> md_bushpass
    % then the light: a half-light, then its core near the edge
    [ GREEN WARM 0.35 mix3 ] aload pop setrgbcolor
    << /Count 220 /Radius 3.4 /Light 135 /Reach 0.4 /Feather 0.7 >>
    << /Size 3.8 /Scatter 5 /Density 3 /Irregular 0.9 /Highlight 0.5 /Light 135
       /HighlightColor WARM >> md_bushpass
    [ GREEN WARM 0.65 mix3 ] aload pop setrgbcolor
    << /Count 260 /Radius 2.6 /Light 135 /Reach 0.16 >>
    << /Size 3 /Scatter 4 /Density 3 /Irregular 0.9 /Highlight 0.7 /Light 135
       /HighlightColor WARM >> md_bushpass
  } if
} def

/CU_TOP [0.36 0.56 0.82] def /CU_LOW [0.80 0.86 0.92] def
/cu_body [0.72 0.73 0.80] def /cu_lit [1.00 0.97 0.90] def
/md_cumulus {                                       % x y lit? -
  /mcl exch def /mcy0 exch def /mcx0 exch def
  mcx0 mcy0 240 200 CU_TOP CU_LOW md_ground
  /mc_under [ CU_TOP CU_LOW 0.4 mix3 ] def
  31 srand
  {
    mcx0 30 add mcy0 50 add 180 70 md_lump scpath
    300 5.5 0.8 << >> [ [ cu_body 1.06 shade ] [ cu_body 0.94 shade ] ] md_pass
  } << /Soft 0.5 /Under mc_under >> pkwet
  mcl {
    {
      mcx0 30 add mcy0 50 add 180 70 md_lump scpath
      600 5.5 0.8 << /Light 160 /Reach 0.4 /Feather 0.9 >>
      [ [ cu_body cu_lit 0.35 mix3 ] [ cu_body cu_lit 0.5 mix3 ] ] md_pass
      mcx0 30 add mcy0 50 add 180 70 md_lump scpath
      1200 3.5 0.8 << /Light 160 /Reach 0.2 /Feather 1 >>
      [ [ cu_lit cu_body 0.1 mix3 ] [ cu_lit cu_body 0.25 mix3 ] ] md_pass
    } << /Soft 0.2 /Under cu_body >> pkwet
  } if
} def

[0.95 0.94 0.91] aload pop setrgbcolor 0 0 780 630 rectfill

% Top row: before.
 20 400 false md_evening
270 400 false md_bushpanel
520 400 false md_cumulus
% Middle row: after.
 20 160 true md_evening
270 160 true md_bushpanel
520 160 true md_cumulus

LBL 0.15 0.15 0.15 setrgbcolor
20 608 moveto (before: the body load alone, every circle painted the same way) show
20 368 moveto (after: + a lit pass, region << ... /Light a /Reach r >> pkscumblein) show
20 146 moveto (/Light 270, an evening cloud lit from below) show
270 146 moveto (/Light 135 lit, /Light 315 shadow) show
520 146 moveto (/Light 160, a low sun on the left) show

% Bottom row: what the motion keeps.
/md_keeps {                                         % x y reach feather -
  /mkf exch def /mkr exch def /mky exch def /mkx exch def
  0.6 setlinewidth
  23 srand
  mkx 120 add mky 30 add 78 md_bush scpath
  << /Count 300 /Radius 4.5 >> pkscumblein
  0.80 0.80 0.80 setrgbcolor stroke
  mkx 120 add mky 30 add 78 md_bush 0.45 setgray 1 setlinewidth stroke
  23 srand
  mkx 120 add mky 30 add 78 md_bush scpath
  << /Count 300 /Radius 4.5 /Light 135 /Reach mkr /Feather mkf >> pkscumblein
  0.85 0.15 0.10 setrgbcolor 0.9 setlinewidth stroke
  LBL 0.15 0.15 0.15 setrgbcolor
  mkx 20 add mky 8 add moveto
  (/Light 135 /Reach ) show mkr 4 string cvs show ( /Feather ) show mkf 4 string cvs show
} def
 20 20 0.2 0 md_keeps
270 20 0.35 0.5 md_keeps
520 20 0.5 1 md_keeps
