%!PS
%%BoundingBox: 0 0 300 200
3 setlinewidth
% curveto: two control points, then the end point
30 40 moveto  60 190  130 -10  150 120 curveto
stroke
% arc: centre x y, radius, start and end angle in degrees
0.9 0.4 0.2 setrgbcolor
230 100 50 0 360 arc fill
1 setgray
230 100 25 30 330 arc stroke
showpage
