%!PS
%%BoundingBox: 0 0 300 200
% A path is invisible until you paint it.
newpath
40 40 moveto  140 40 lineto  90 150 lineto  closepath
4 setlinewidth
stroke                                  % paint the outline
0.2 0.6 0.9 setrgbcolor
170 40 moveto  260 40 lineto  260 130 lineto  170 130 lineto  closepath
fill                                    % paint the inside
showpage
