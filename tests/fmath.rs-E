//! Cross-platform math (issue #738): the transcendental operators go through
//! `src/fmath.rs`, so these exact results hold on macOS, Linux and in the
//! browser build. The expected values were produced by musl 1.2.5 (Alpine,
//! `f64::exp` and friends linked against its libm), the Linux build pscat's
//! reference renders come from. A platform libm leaking back in fails one of
//! these on the platform it differs on.

use pscat::Interp;
use pscat::fmath;

fn eval(src: &str) -> String {
    let mut it = Interp::new();
    it.run_str(src)
        .unwrap_or_else(|e| panic!("eval of {src:?} failed: {e}"));
    let stack = it.operand_stack();
    assert_eq!(stack.len(), 1, "eval of {src:?} left {stack:?}");
    stack[0].repr()
}

fn same(got: f64, want_bits: u64) -> bool {
    let want = f64::from_bits(want_bits);
    got.to_bits() == want_bits || (got.is_nan() && want.is_nan())
}

#[test]
fn operators_match_musl_where_platforms_used_to_differ() {
    // The issue's example: macOS gave ...245, Linux ...246.
    assert_eq!(eval("3.3 0.88 atan"), "75.06858282186246");
    assert_eq!(eval("3.3 9 0.11 mul atan"), "73.30075576600638");
    assert_eq!(eval("3.3 14 0.11 mul atan"), "64.98310652189998");
    assert_eq!(eval("66 0.37 mul sin"), "0.4134222932168289");
    assert_eq!(eval("78 0.37 mul sin"), "0.48267107599244613");
    assert_eq!(eval("104 0.37 mul cos"), "0.7828254077698097");
    assert_eq!(eval("116 0.37 mul cos"), "0.7323052377541318");
    // The `libm` crate's own ln and exp gave ...092 and ...315 here.
    assert_eq!(eval("1 0.01 mul ln"), "-4.605170185988091");
    assert_eq!(eval("9 0.01 mul ln"), "-2.4079456086518722");
    assert_eq!(eval("9 0.013 mul 1.7 exp"), "0.02605649313778031");
}

#[test]
fn rotate_uses_fmath_not_tiny_skia_sin_cos() {
    let t = fmath::rotation(30.0);
    let (s, c) = (
        libm::sinf(30f32.to_radians()),
        libm::cosf(30f32.to_radians()),
    );
    assert_eq!(
        [t.sx, t.ky, t.kx, t.sy].map(f32::to_bits),
        [c, s, -s, c].map(f32::to_bits)
    );
}

#[test]
fn trig_and_hypot_are_the_libm_crate() {
    for i in 1..200 {
        let x = f64::from(i) * 0.37;
        assert_eq!(fmath::sin(x).to_bits(), libm::sin(x).to_bits());
        assert_eq!(fmath::cos(x).to_bits(), libm::cos(x).to_bits());
        assert_eq!(
            fmath::atan2(3.3, x).to_bits(),
            libm::atan2(3.3, x).to_bits()
        );
        assert_eq!(fmath::log10(x).to_bits(), libm::log10(x).to_bits());
    }
}

#[test]
fn exp_matches_musl() {
    for &(x, want) in EXP {
        let x = f64::from_bits(x);
        assert!(
            same(fmath::exp(x), want),
            "exp({x:e}) = {:e}",
            fmath::exp(x)
        );
    }
}

#[test]
fn ln_matches_musl() {
    for &(x, want) in LN {
        let x = f64::from_bits(x);
        assert!(same(fmath::ln(x), want), "ln({x:e}) = {:e}", fmath::ln(x));
    }
}

#[test]
fn pow_matches_musl() {
    for &(x, y, want) in POW {
        let (x, y) = (f64::from_bits(x), f64::from_bits(y));
        assert!(
            same(fmath::powf(x, y), want),
            "pow({x:e}, {y:e}) = {:e}",
            fmath::powf(x, y)
        );
    }
}

