art/**/*.png -diff
art/**/*.pdf -diff
# The plugin launchers (#866): a Windows checkout with core.autocrlf=true must
# not turn the sh scripts' line endings into CRLF (sh then fails), and cmd.exe
# wants CRLF in a batch file.
plugin/scripts/pscat-mcp text eol=lf
plugin/scripts/*.sh text eol=lf
plugin/scripts/*.cmd text eol=crlf
plugin/scripts/*.ps1 text eol=crlf
