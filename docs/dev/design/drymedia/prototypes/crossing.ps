%!PS-Adobe-3.0
%%Title: drykit design prototype -- do oriented catches still share the tooth?
%%BoundingBox: 0 0 300 300
%%EndComments
% Issue #233 prototype, NOT library code. Run from the repo root with a
% prelude defining the case, e.g.
%
%   { echo "/MODE 2 def /WHICH 1 def /SEED 3 def"; \
%     cat docs/drymedia/prototypes/crossing.ps; } | pscat --page 300x300 --png a.png -
%
% Draws ONE wide band through a catch, black on white, so a script can
% compare two renders pixel by pixel (CANVAS_SURFACE.md 3.3's phi test):
%
%   WHICH 1   a horizontal band            WHICH 2   a band at 60 degrees
%   WHICH 3   a 300x300 fill at TOUCH      (nesting check: render at two touches)
%   MODE 1    pjcatch (isotropic)          MODE 2    dqcatch, stretched along the band
%   SEED      pkcanvas /Seed; the control renders WHICH 2 with another seed

(lib/artkit.ps) run
(lib/paintkit.ps) run
(docs/drymedia/prototypes/dqcatch.ps) run

/MODE where { pop } { /MODE 2 def } ifelse
/WHICH where { pop } { /WHICH 1 def } ifelse
/SEED where { pop } { /SEED 3 def } ifelse
/TOUCH where { pop } { /TOUCH 0.6 def } ifelse
/GRAIN where { pop } { /GRAIN 2.5 def } ifelse
/ELONG where { pop } { /ELONG 1.8 def } ifelse

<< /Seed SEED /Weave GRAIN >> pkcanvas
1 setgray 0 0 300 300 rectfill
0 setgray
/band {   % ang -> ; a 260 x 60 band through the page centre at ang
    /ba exch def
    gsave 150 150 translate ba rotate
        -130 -30 130 30
        MODE 1 eq { TOUCH pjcatch } { TOUCH 0 ELONG dqcatch } ifelse
        -130 -30 260 60 rectfill
    grestore
} def
WHICH 1 eq { 0 band } if
WHICH 2 eq { 60 band } if
WHICH 3 eq { 0 0 300 300 TOUCH 0 ELONG dqcatch 0 0 300 300 rectfill } if
showpage
