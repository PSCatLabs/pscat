{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.PSCatLabs/pscat",
  "title": "pscat",
  "description": "Render and debug PostScript to PNG, SVG or PDF, make handwriting-style notes and generative art",
  "repository": {
    "url": "https://github.com/PSCatLabs/pscat",
    "source": "github"
  },
  "websiteUrl": "https://pscatlabs.github.io/pscat/",
  "version": "0.6.3",
  "packages": [
    {
      "registryType": "cargo",
      "identifier": "pscat",
      "version": "0.6.3",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
